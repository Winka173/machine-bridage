// Machine Brigade balance catalog. Prototype numbers: tune through playtesting.
// Distances in metres, times in seconds, turn rates in degrees per second.
{
  "version": 3,

  // Global tuning. toughness: every vehicle's health (bosses separately). firepower: strikes, and the blasts of
  // burning props, vehicles blowing up and mines, so they still matter against tougher vehicles. economy: every
  // side's CP income (objective bonuses included) and supply line, so fewer, longer-lived vehicles take the field.
  // Income was 0.65 and supply 0.8 until playtests found CP coming in too slowly (2026-09-27).
  // Vehicles' toughness was 2.5 until the armour and damage balance pass (DECISIONS 20X): fights ran long after
  // prompt 15's armour, so 2.2 shortens every fight by about an eighth (bosses keep theirs).
  "toughness": { "vehicles": 2.2, "bosses": 0.85 },
  "firepower": { "strikes": 2.0, "propBlasts": 1.5, "vehicleBlasts": 2.0 },
  // Play-test 6 (DECISIONS 21G): income 0.95 -> 0.9: the owner found the economy a little strong (battles flooded).
  "economy": { "income": 0.9, "supply": 1.05, "bankByMode": { "Conquest": [30, 45], "Deathmatch": [30, 45], "KingOfTheHill": [30, 45], "Assault": [30, 45], "Siege": [40, 55], "Defend": [30, 45], "Endless": [30, 45], "Survival": [30, 40], "BossRush": [45, 60] },
    // Prompt 32 L6 (DECISIONS "Prompt 32 L4/L5/L6/L8"): every listed mode's starting CP x 1.16 (the new prices), rounded
    // half up, both sides; a campaign mission's own CP too.
    "startCp": { "scale": 1.16, "modes": ["Conquest", "Deathmatch", "KingOfTheHill", "Assault", "Siege", "Weekly", "Defend", "Endless", "Survival", "BossRush", "Campaign", "Showdown"] },
    // Army supply per mode, in CP: upkeep starts at 1.5x it (40 x 1.05 x 1.5: about 63 CP, eight
    // to ten mid-tier vehicles). A mode that sets its own (Siege, Defend, a campaign mission) keeps it.
    // The campaign stays at its tuned 24 until its rework; Survival at 30 (more would make the waves easy).
    "armyCap": { "default": 40, "Campaign": 24, "Survival": 30 },
    // Most vehicles a side may have out at once; the enemy of the big modes more (prompt 5: cheap
    // swarms in numbers, chosen from the tick budget measurement, TickBudgetTests).
    "vehicleCap": { "default": 32, "Siege": 48, "Defend": 48, "Endless": 48, "Operation": 48 },
    // A campaign enemy matches this share of the player's arsenal edge (card ranks and equipment).
    "enemyScaling": 0.55,
    // Play-test 6 (DECISIONS 21G): a quick mode's enemy (its bosses and towers too) matches this share by difficulty; a
    // geared army won every quick mode at every difficulty without it.
    "enemyScalingQuick": { "Easy": 0.4, "Normal": 0.75, "Hard": 0.85, "VeryHard": 1.08 },
    // The weekly fortress takes half that (its towers are the fight: 2 of 9 won at Normal with the whole share).
    "enemyScalingModes": { "Weekly": 0.5 } },

  // Bases (a loadout chosen before the battle, like the deck; nothing is built during it). The HQ
  // stands in the camp with the drop zone round it; sized hardpoints (map data: small, medium, large)
  // take towers of their size or smaller, and utility slots take modules. HQ level 1-5 opens them.
  // A destroyed tower is flown back in during the battle: CP = points x cpPerPoint (50 % x points x 2 CP),
  // then a cooldown. roles, by mode: Anchor (the HQ cannot fall: a camp to lean on), Target (the enemy
  // base is the objective), Defend (the side loses when its HQ falls), None (no base).
  // Tower tiers (1-10), branches and utility modules come later; "tier", "branches" and "modules" are kept free for them.
  // Prompt 32 L8: the ammunition handbook's worked example (one shot of the shooter's main weapon on the target's front and side).
  "handbook": { "exampleShooter": "ifv", "exampleTarget": "main_battle_tank" },
  // Prompt 32 L6: the opening squads. In "modes" the player's commander drops its row at tick 0, in "enemyModes" the enemy
  // commander its general's (by id or base style, else "default"); each role is the deck's cheapest card of the role
  // (baseCP, then id; a role the deck lacks is left out, its CP kept), its baseCP taken from the starting CP, at most
  // "share" of it. They replace the maps' generic start units ("start": true in the map files) in those modes. Campaign
  // missions only with their "openingSquad" flag (default off). lind, reyes and kerr are the sheet's Mara, Hawk and
  // Nadia; sen is Venn's general id; wolff and thorne have no general in the data yet.
  "openingSquads": {
    "share": 0.6,
    "modes": ["Conquest", "Deathmatch", "KingOfTheHill", "Assault", "Siege", "Defend", "Endless", "Survival", "BossRush", "Showdown"],
    "enemyModes": ["Conquest", "Deathmatch", "KingOfTheHill", "Assault", "Siege", "Showdown"],
    "roles": {
      "mbt": ["main_battle_tank", "next_gen_tank", "twin_tank"],
      "scout": ["scout_jeep"],
      "engineer": ["engineer_vehicle", "demolition_line_vehicle"],
      "repair": ["ammo_carrier"],
      "light": ["armored_car", "rocket_technical", "recoilless_jeep", "zu23_technical"],
      "scout_heli": ["scout_heli"],
      "fpv": ["fpv_carrier"],
      "wheeled": ["armored_car", "wheeled_gun", "ifv"],
      "light_tank": ["light_tank"],
      "bunker": ["siege_tank"],
      "fortify": ["siege_tank"],
      "artillery": ["mortar_carrier", "sp_mortar", "artillery"],
      "mine_layer": ["mine_layer"],
      "heli": ["attack_helicopter", "scout_heli"],
      "drone": ["fpv_carrier"],
      "tank": ["light_tank", "main_battle_tank", "next_gen_tank", "twin_tank", "heavy_tank"],
      "heavy": ["heavy_tank", "twin_tank", "armored_bulldozer", "titan_tank"],
      "cheap4": { "maxCp": 4 }
    },
    "commanders": {
      "kade": ["mbt", "scout"], "lind": ["engineer", "repair", "light"], "reyes": ["scout_heli", "scout"],
      "kerr": ["scout", "scout", "light"], "venn": ["fpv", "scout"], "mendez": ["wheeled", "light_tank", "scout"],
      "brandt": ["bunker", "engineer"], "dahl": ["artillery", "scout"], "brenn": [], "adler": ["scout", "light"],
      "varro": ["cheap4", "cheap4", "cheap4"], "reyn": ["mbt"], "quist": ["fortify", "light", "scout"], "okoye": []
    },
    "generals": {
      "varga": ["tank"], "orlov": ["artillery", "scout"], "kessler": ["mine_layer", "light"], "wolff": ["heli"],
      "sen": ["drone"], "venn": ["drone"], "thorne": ["mbt"], "aurel": ["heavy"], "default": ["scout", "light"]
    }
  },

  "base": {
    "hq": "headquarters",
    // Prompt 32 L1 (DECISIONS "Prompt 32 L0/L1/L2"): the player's 22 tower cards (10 small, 7 medium, 5 large).
    "roster": ["guard_tower", "mg_bunker", "aa_turret", "ew_tower", "cp_relay", "atgm_tower", "gun_turret", "c_ram", "rocket_turret", "laser_ad_station", "heavy_turret", "missile_battery", "drone_hangar", "shield_tower", "vehicle_hangar", "aircraft_hangar"],
    // Hardpoints an HQ level opens, by size (small takes light towers, medium light or medium,
    // large any), and utility slots.
    "levels": [ { "small": 3, "medium": 1, "large": 0, "utility": 1 }, { "small": 4, "medium": 2, "large": 0, "utility": 1 },
                { "small": 4, "medium": 2, "large": 1, "utility": 2 }, { "small": 5, "medium": 3, "large": 1, "utility": 2 },
                { "small": 6, "medium": 3, "large": 2, "utility": 3 } ],
    // Prompt 17 B.4: a long battlefield's layered base (outer wall, yard, inner wall, HQ) opens more at each level;
    // its forward works' strongpoints ("longForward") repeat the base's towers and do not count against the level.
    "longLevels": [ { "small": 4, "medium": 1, "large": 0, "utility": 1 }, { "small": 5, "medium": 2, "large": 1, "utility": 1 },
                    { "small": 6, "medium": 3, "large": 1, "utility": 2 }, { "small": 7, "medium": 4, "large": 2, "utility": 3 },
                    { "small": 8, "medium": 5, "large": 3, "utility": 4 } ],
    "longForward": { "small": 6, "medium": 2 },
    // Flying a destroyed tower back in, by its size (cooldown from its fall, the drop's fall). Prompt 32 L2: each tower's own
    // price is its "rebuildCp" (Tools/balance/p32_tower_prices.py; the size's cp only without one); never while an enemy
    // stands within enemyRadius; none after showdownCutoff s in Showdown; one free small or medium tower at hqRescue HQ health.
    "rebuild": { "small": { "cp": 2, "cooldown": 25, "drop": 2.5 }, "medium": { "cp": 4, "cooldown": 40, "drop": 3.5 }, "large": { "cp": 7, "cooldown": 60, "drop": 5 }, "delay": 4,
      "enemyRadius": 20, "showdownCutoff": 600, "hqRescue": 0.25 },
    "outpost": { "cp": 6, "slots": 2 },
    // Prompt 32 L4 (DECISIONS "Prompt 32 L4/L5/L6/L8"): the HQ types, chosen in the loadout from HQ level 1 (they replace the
    // HQ doctrine). Scales by HQ level 1-5. "radius": the base region (the Shield's dome, the garrison's leash, the AI's
    // threat count). Fortress: the HQ stands as headquarters.fortress_ground / _air (the plain HQ plus a medium tower's
    // gun, its damage and cadence each the root of "scale", "airScale" for the anti-air branch); skill hq_barrage (three
    // heavy rounds, damage x the scale). Garrison: a squad stocked every "every" s by level ("stock" at most), turned out
    // when an enemy enters the region, gone after
    // "clear" s without enemies; "caps" the baseCP alive. Shield: headquarters.shield (a C-RAM's point defence over the
    // region, "charges" x "scale" interceptors at "scale" pace), towers mend "regen" of their health a second after
    // "regenDelay" s unhit, the emergency dome absorbs "dome" of the HQ's health for "domeSeconds". Compared by
    // Tools/balance/p32_hq_types.py (Docs/balance/p32_hq_types.md), which refitted the prompt's tables (0.5-1.2, every 60 s,
    // regen 0.2-0.4 %, dome 8-18 %) into the value bands: its --apply wrote the numbers below.
    "hqTypes": {
      "default": "fortress", "skillCooldown": 120, "radius": 45,
      "fortress": { "ground": "headquarters.fortress_ground", "air": "headquarters.fortress_air", "barrage": "hq_barrage",
                    "scale": [0.29, 0.36, 0.42, 0.49, 0.55], "airScale": [0.16, 0.2, 0.23, 0.27, 0.31], "aiAirShare": 0.3 },
      "garrison": { "every": [120.0, 100.0, 100.0, 130.0, 170.0], "stock": 2, "clear": 30, "caps": [6, 8, 10, 12, 15],
                    "squads": [ { "units": ["light_tank"] }, { "units": ["armored_car", "scout_jeep"] }, { "units": ["light_tank", "armored_car"] },
                                { "units": ["main_battle_tank"] }, { "units": ["main_battle_tank", "scout_jeep"] } ],
                    // Play-test 14: the light unit the player's Garrison HQ may call instead (the HQ tab); its squad is then that unit.
                    "callable": ["scout_jeep", "armored_car", "light_tank"] },
      "shield": { "hq": "headquarters.shield", "scale": [0.15, 0.19, 0.24, 0.26, 0.29], "charges": 4,
                  "regenDelay": 5, "regen": [0.00059, 0.00073, 0.0009, 0.00092, 0.00096], "dome": [0.024, 0.029, 0.036, 0.04, 0.043], "domeSeconds": 10 },
      "ai": { "brandt": "fortress", "kessler": "fortress", "varga": "garrison", "orlov": "shield", "aurel": "shield",
              "Easy": "garrison", "Normal": "fortress", "Hard": "shield", "VeryHard": "fortress" }
    },
    // Prompt 32 L8 (for pass 3's walls): the wall breakers (shared tag) and their damage on walls only (not towers or the HQ).
    // Prompt 32 L3: the walls. Up to 2 lines a camp (ring 1 outer, ring 2 inner), 3 a fortress (Defend's fall-back lines), 3-5
    // segments each (map data "walls", Tools/maps/p32_walls.py). Durability relative to HESCO (segmentHp x durability = the
    // def's hp); the T-wall builds the extra segment (half the gate), the gun wall carries one of the base's small towers.
    // Rubble slows ground vehicles by rubbleSlow. The enemy's type by its general (ai). No currency of its own.
    "walls": { "breakerMultiplier": 1.5, "breakers": ["armored_bulldozer", "engineer_vehicle", "demolition_line_vehicle"],
      "segmentHp": 2400, "rubbleSlow": 0.2, "campLines": 2, "fortressLines": 3, "default": "hesco",
      "types": { "hesco": { "def": "wall_hesco", "durability": 1.0 }, "t_wall": { "def": "wall_t", "durability": 1.6, "extra": true },
        "gun_wall": { "def": "wall_gun", "durability": 1.2, "gun": true } },
      "ai": { "brandt": "t_wall", "kessler": "t_wall", "varga": "gun_wall", "default": "hesco" } },
    // Prompt 32 L5 (DECISIONS "Prompt 32 L4/L5/L6/L8"): the reference base of each HQ level (rank 1, no equipment, no HQ
    // type), every slot the level opens filled with a balanced mix of roster cards. The Defend and Endless waves are sized
    // by the reference of the defender's HQ level (BaseStrength.ReferenceScore), never by the player's own base, which
    // the Base screen only shows.
    "reference": [
      { "level": 1, "small": ["guard_tower", "mg_bunker", "aa_turret"], "medium": ["gun_turret"], "utilities": ["repair_bay"] },
      // Play-test 14: the deleted towers' reference slots hold a surviving tower of the same size (Docs/export/CHANGES.md).
      { "level": 2, "small": ["guard_tower", "mg_bunker", "aa_turret", "mg_bunker"], "medium": ["gun_turret", "atgm_tower"], "utilities": ["repair_bay"] },
      { "level": 3, "small": ["guard_tower", "mg_bunker", "aa_turret", "mg_bunker"], "medium": ["gun_turret", "rocket_turret"], "large": ["heavy_turret"],
        "utilities": ["repair_bay", "logistics_station"] },
      { "level": 4, "small": ["guard_tower", "mg_bunker", "aa_turret", "mg_bunker", "guard_tower"], "medium": ["gun_turret", "atgm_tower", "rocket_turret"],
        "large": ["heavy_turret"], "utilities": ["repair_bay", "logistics_station"] },
      { "level": 5, "small": ["guard_tower", "mg_bunker", "aa_turret", "mg_bunker", "guard_tower", "ew_tower"], "medium": ["gun_turret", "atgm_tower", "c_ram"],
        "large": ["heavy_turret", "missile_battery"], "utilities": ["repair_bay", "logistics_station", "airfield"] }
    ],
    "roles": { "Conquest": "Anchor", "KingOfTheHill": "Anchor", "Deathmatch": "Anchor", "Assault": "Target", "Siege": "Target",
               "Defend": "Defend", "Endless": "Defend", "Weekly": "Target", "Survival": "None", "BossRush": "None", "Campaign": "None", "Showdown": "Target" },
    // The enemy's base: which towers it prefers (weights by tower id, "*" for any), and its HQ level, by difficulty.
    // Commander personalities (a later step) add their own styles under "styles".
    "ai": {
      "levels": { "Easy": 2, "Normal": 3, "Hard": 5, "VeryHard": 5 },
      "styles": {
        "default": { "aa_gun_tower": 0.8, "laser_ad_station": 0.5, "flare_tower": 0.25, "barrage_balloon": 0.3, "fire_control_centre": 1.0, "blast_wall": 0.4, "guard_tower": 1.0, "mg_bunker": 1.0, "aa_turret": 1.2, "gun_turret": 1.2, "rocket_turret": 0.8,
                     "missile_battery": 0.6, "heavy_turret": 0.6, "c_ram": 0.8, "atgm_tower": 1.0, "ew_tower": 0.6, "drone_hangar": 0.6, "shield_tower": 0.5, "cp_relay": 0.35, "vehicle_hangar": 0.5, "aircraft_hangar": 0.3,
                     // Prompt 25 F2 batch B (DECISIONS 25F2-B): the six tower stand-ins (default weight only; no per-general tuning this pass).
                     "manpads_tower": 0.5, "flare_searchlight_tower": 0.2, "recoilless_gun_tower": 0.6, "bunker_shelter_tower": 0.3, "drone_net_tower": 0.4, "one_shot_atgm_tower": 0.4 },
        "armour": { "fire_control_centre": 1.0, "gun_turret": 2.0, "heavy_turret": 1.4, "mg_bunker": 1.0, "aa_turret": 0.8, "guard_tower": 0.6, "shield_tower": 0.8 },
        "artillery": { "fire_control_centre": 1.0, "rocket_turret": 1.6, "gun_turret": 0.8, "aa_turret": 0.8 },
        "air": { "laser_ad_station": 1.0, "fire_control_centre": 1.0, "aa_turret": 2.0, "missile_battery": 1.6, "c_ram": 1.2, "guard_tower": 0.8 },
        // A "tower.branch" weight is the general's taste in rank-7 branches (the tower-branch rework, DECISIONS 19T).
        // The enemy generals (prompt 4): Varga anti-tank, Orlov artillery, Kessler an even spread,
        // Dr Sen drones, Quạ Đen anti-air, Aurel everything strong.
        "varga": { "fire_control_centre": 1.0, "gun_turret.long": 1.3, "atgm_tower.top": 1.3, "atgm_tower": 2.4, "gun_turret": 1.8, "heavy_turret": 1.6, "mg_bunker": 1.0, "aa_turret": 0.8, "guard_tower": 0.6 },
        "orlov": { "fire_control_centre": 1.2, "rocket_turret.guided": 1.3, "rocket_turret": 1.8, "guard_tower": 1.2, "gun_turret": 0.8, "aa_turret": 0.8 },
        "kessler": { "*": 1.0 },
        "sen": { "laser_ad_station": 1.2, "drone_hangar.swarm": 1.3, "ew_tower.drone": 1.3, "drone_hangar": 2.6, "ew_tower": 1.6, "c_ram": 1.2, "guard_tower": 1.0, "aa_turret": 1.0, "gun_turret": 0.8 },
        "quaden": { "laser_ad_station": 0.8, "aa_turret.sam": 1.3, "missile_battery.lrr": 1.3, "c_ram.dome": 1.2, "aa_turret": 2.4, "missile_battery": 2.2, "c_ram": 1.4, "guard_tower": 1.0, "gun_turret": 0.6 },
        "aurel": { "fire_control_centre": 1.2, "missile_battery.pac3": 1.3, "shield_tower.bulwark": 1.2, "heavy_turret.bastion": 1.2, "heavy_turret": 1.6, "missile_battery": 1.4, "atgm_tower": 1.2, "c_ram": 1.2, "*": 0.8 }
      }
    }
  },

  // Equipment branches: the classes whose vehicles wear each branch's loadout (prompt 8 I.1). An aircraft is
  // always Air; the long-range SAM is anti-air (Light) and the FPV carrier a tank hunter (Armour).
  "branches": {
    "Armor": ["Tank", "Heavy", "TankHunter"],
    "Light": ["Light", "Scout", "AntiAir", "Support"],
    "Artillery": ["Artillery"],
    "Air": ["Helicopter", "Plane"]
  },

  // The enemy's elites (prompt 8 H): an elite has its base card's health times hpScale and hits
  // damageScale times as hard; it costs the enemy costScale times the base card's CP (and refunds its
  // kill at that price). Instead of a chance per delivery, a share of the enemy's spending ("budget")
  // may go on elites, with a cap on how many are out at once, both by difficulty; a general's
  // favoured cards get the whole share, the rest otherShare of it. Each elite destroyed pays "coins"
  // after the battle (the first bountyCap of them) and may drop a blueprint of its base card.
  "elites": {
    "costScale": 1.6, "hpScale": 1.6, "damageScale": 1.25, "powerRatio": 2.0, "otherShare": 0.5,
    "budget": { "Easy": 0.05, "Normal": 0.10, "Hard": 0.15, "VeryHard": 0.30, "Heroic": 0.20, "Iron": 0.25 },
    "cap": { "Easy": 1, "Normal": 2, "Hard": 3, "VeryHard": 6, "Heroic": 4, "Iron": 5 },
    "coins": 10, "bountyCap": 4, "blueprintChance": 0.06
  },

  // The enemy generals: which of their cards they make elites of first (class names; "Drone" for
  // drone carriers and UAVs, "Air" for every aircraft), and cards always in their deck.
  // <generated ai: Tools/ai/import_ai_xlsx.py, do not edit by hand>
  // Prompt 28: the AI parameter frame (L.1). Each parameter: value (the starting point, not final), min-max
  // (the sweep range), metric (what the sweep measures) and reason (the sheet's tuning note).
  "ai": {
    "world": {
      "rate": {"value": 2, "min": 1, "max": 4, "metric": "AI tick time (M.5)", "reason": "prompt 28 A.1/M.1: about twice a second"},
      "cell": {"value": 10, "min": 6, "max": 16, "metric": "AI tick time (M.5)", "reason": "prompt 28 A.1: 10 m cells to start"},
      "highValue": {"value": 1.5, "min": 1.2, "max": 2.5, "metric": "Số mục tiêu giá trị bị hạ", "reason": "a contact this many times the mean known strength is high value"},
      "splashMin": {"value": 2, "min": 1, "max": 4, "metric": "Số xe bị hạ bởi bắn lan mỗi phút", "reason": "a weapon with a blast this wide (m) paints the splash threat"},
      "eventLife": {"value": 8, "min": 4, "max": 15, "metric": "Số lần đổi hành động mỗi phút của đội", "reason": "seconds an event lasts unless refreshed"},
      "airShare": {"value": 0.25, "min": 0.15, "max": 0.4, "metric": "Số máy bay bị hạ mỗi lượt", "reason": "MISMATCH: enemy aircraft share of its strength"},
      "aaShare": {"value": 0.1, "min": 0.05, "max": 0.2, "metric": "Số máy bay bị hạ mỗi lượt", "reason": "MISMATCH: own anti-air share below this"},
      "armourShare": {"value": 0.4, "min": 0.3, "max": 0.6, "metric": "Thời gian hạ mục tiêu", "reason": "MISMATCH: enemy armour share of its strength"},
      "atShare": {"value": 0.15, "min": 0.1, "max": 0.3, "metric": "Thời gian hạ mục tiêu", "reason": "MISMATCH: own anti-tank share below this"},
      "bigFight": {"value": 600, "min": 300, "max": 1500, "metric": "Tỷ lệ thời gian có giao tranh", "reason": "health lost by both sides in 5 s that resets the pressure tiers"},
      "escalationPoints": {"value": 1.5, "min": 1.25, "max": 2, "metric": "Tỷ lệ thời gian có giao tranh", "reason": "tier 1: points' income and bleed x this"},
      "churnWarn": {"value": 6, "min": 3, "max": 12, "metric": "Số lần đổi hành động mỗi phút của đội", "reason": "switches a minute per squad above which the viewer warns (J.3)"},
      "mergeThreshold": {"value": 0.15, "min": 0.1, "max": 0.25, "metric": "Khoảng cách dấu vân giữa các cặp", "reason": "H.3: pairs closer than this merge"}
    },
    "params": {
      "attackThreshold": {"value": 1.2, "min": 0.8, "max": 1.6, "metric": "Tỷ lệ thời gian có giao tranh; số đợt tấn công thất bại", "reason": "Thấp quá: lao vào chỗ chết; cao quá: trận đứng yên"},
      "fallbackRatio": {"value": 0.6, "min": 0.5, "max": 0.7, "metric": "Số tuyến mất; thời lượng trận Phòng thủ", "reason": "Không áp cho từng xe theo máu"},
