  // bossRanks: main and mini. A mini's "hp" is a share of its data health (its parts' with it, prompt 20 G.1),
  // "damageScale" its weapons', "bigAttackScale" its big attack's (damage, cooldown; the warning kept); every
  // boss with no "phases" (and no tiers) gets its rank's; "escortCap" cuts its escort waves; "intro" the
  // camera's seconds on it as it arrives; "music" its track; "reward" its rewards' share; "compact" a small bar.
  "bossRanks": {
    "main": { "intro": 6, "music": "boss", "reward": 1, "partsShare": 0.35,
              // Play-test 6 (DECISIONS 21G): +40 % damage from every source (weapons, big attack, crushing), weapons and
              // reloads 25 % faster, air defence x1.6 on aircraft; half of a strike's or a bomb's damage, and at most 10 %
              // of its health to them in 10 s (a fifth of the rest gets through); the big attack +20 % (0.857 of the 1.4) and 15 % sooner.
              "damageScale": 1.4, "fireRate": 1.25, "airDamage": 1.6, "strikeTaken": 0.5, "strikeCap": 0.1, "strikeWindow": 10, "strikeOver": 0.2,
              "bigAttackScale": { "damage": 0.857, "cooldown": 0.85, "warn": 0 },
              "phases": [ { "at": 0.6, "transform": 2.5, "damage": 1.1 }, { "at": 0.25, "transform": 3, "damage": 1.2, "speed": 1.1, "fireRate": 1.25 } ] },
    "mini": { "hp": 0.55, "partsShare": 0.35, "damageScale": 1.2, "bigAttackScale": { "damage": 0.56, "cooldown": 1.1, "warn": 0 },
              // Play-test 6: damage 0.8 -> 1.2 (+50 %; its big attack 0.7 -> 0.56 of it, +20 %), the main rank's reloads and air
              // defence, 15 % of its health to strikes in 10 s, escorts 3 -> 4 a wave.
              "fireRate": 1.25, "airDamage": 1.6, "strikeTaken": 0.5, "strikeCap": 0.15, "strikeWindow": 10, "strikeOver": 0.2,
              "intro": 2.5, "music": "boss_mini", "reward": 0.45, "escortCap": 4, "compact": true,
              "phases": [ { "at": 0.45, "transform": 2, "damage": 1.15 } ] }
  },

