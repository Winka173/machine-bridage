  // Prompt 16 F: escorts for every boss (BossSystem.Escorts, DECISIONS 15B). A wave comes in with the boss
  // ("arrive") and another at each phase change ("phase": the same wave every change; "phases": one per change,
  // the last repeating). A change is the boss's own phase marks, else the table's "marks", else escortRules.marks;
  // "on": "surface" counts the Earth Worm's break-outs instead. A wave is a list of units, or an object
  // { "units", "drop" (beside / para / edge / place), "support" (a para drop's warning and parachutes; default
  // "escort_drop.<unit>"), "halt" (seconds the boss stops for it), "refill" (only replaces its own losses),
  // "radio" }. A unit: "unit", "role" (guard, repair, jam, cover, spot, smoke, raid), "elite" (always its elite),
  // "slot" (flank, rear, screen, front; guards and raiders flank, helpers rear), "at" ([x right, y forward] in the
  // boss's frame, for "place"), "count". Every wave has at least one helper (any role but guard and raid); the
  // helpers of a wave come first when the cap is near. A table may set its own "leash" and "cap".
  "escortRules": {
    // Play-test 6 (DECISIONS 21G): 30-50 % more alive at once (was 4, 5, 6, 6, 6, 6), and in Boss Rush 4 at least and
    // 70 % of each wave's guards (was 3 and 50 %).
    "cap": { "Easy": 5, "Normal": 7, "Hard": 8, "VeryHard": 9, "Heroic": 9, "Iron": 9 },
    "bossRushCut": 2, "bossRushMin": 4, "bossRushGuards": 0.7,
    "leash": 28, "bounty": 3, "helperBounty": 4, "repair": 0.003, "repairReach": 12,
    "spotBonus": 0.15, "spotSpread": 0.6, "marks": [0.5], "dropWarn": 3,
    // Play-test 14 (owner Q19): escorts keep to the boss's domain. A unit of another domain in a boss's table (its own or its
    // general's) is swapped for its domain's unit of the same role ("default" for any other role; "unit:role" also changes
    // the role, where the domain has no unit for it: no jammer flies or sails).
    "domains": {
      "ground": { "guard": "main_battle_tank", "raid": "light_tank", "cover": "aa_vehicle", "spot": "armored_car", "repair": "engineer_vehicle",
                  "jam": "ew_jammer", "smoke": "ew_jammer", "default": "main_battle_tank" },
      "air":    { "guard": "attack_helicopter", "raid": "attack_helicopter", "cover": "fighter_jet", "spot": "scout_heli", "repair": "attack_helicopter",
