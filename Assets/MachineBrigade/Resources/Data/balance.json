  // ----------------------------------------------------------------------------------------------------
  // Prompt 18 (DECISIONS 17A): every boss's one big attack, telegraphed and interruptible. A boss names its entry
  // ("bigAttack"); an entry is a list of strikes, each a shape from the shared library with its numbers:
  //   circle (rounds within "area" of the aim, or one round with "scatter"; "every" s for "duration" s: continuous
  //   fire; round the boss with "aim": "self", "sectors": each part covers its half), strip ("length" x "width" along
  //   "axis": heading, toward or across; "interval": a walking barrage in order), line (a piercing slug, "chainCut"
  //   less for each unit after the first), sweep (a beam run down its line over "duration"), swarm (drones of "hp" at
  //   "speed" m/s, at most "targets" units), missile ("hp", "flight" s; shot down by anti-air, C-RAM, lasers, APS),
  //   drop (a landing party, at most "max" alive), buff (its side within "reach" hits harder by "damage" and fires
  //   faster by "fireRate" for "seconds"), quake (the Earth Worm's dive).
  // "parts" carry a strike: broken during the warning it is cancelled ("perPart": each part its own rounds), broken
  // for good the boss has lost it until a self-repair. Damage is before armour, on the calibre scale, scaled with the
  // boss; "type", "pen" (a blast's fragments pierce as level 1 at most on vehicles), "radius", "falloff" (the share
  // left at the rim), "structure" (x on buildings and towers), "thermo", "top", "fire" (burning ground). Per attack:
  // "warn", "cooldown" (start to start), "first" (else the rules'), "aim" (group, still, hq, base, self), "reach" (0:
  // the map), "target" (who it is for, the guide's words), "empDelay", "exposed" (x damage taken meanwhile),
  // "abortDamage" (a share of its health taken while it fires makes it break off), "spotter"/"blindScatter", "hold"
  // (mechanisms paused while it charges), "halt". Names and lines are text keys from the id (bigattack.<id> ...).
  "bigAttackRules": {
    "first": 30, "intercept": 150, "aaHit": 0.5, "dodge": 3,
    "difficulty": {
      // Prompt 26 A.6: "bossHp" and "bossDamage" are the enemy boss's own health and damage factors by difficulty (its big
      // attack takes the damage factor with the rest of its fire, so "damage" here is 1 for all); cooldown and warning as before.
      "Easy":     { "damage": 1, "cooldown": 1.2, "warn": 1, "bossHp": 0.75, "bossDamage": 0.8 },
      "Normal":   { "damage": 1, "cooldown": 1,   "warn": 0, "bossHp": 1,    "bossDamage": 1 },
      "Hard":     { "damage": 1, "cooldown": 0.9, "warn": 0, "bossHp": 1.25, "bossDamage": 1.15 },
      "VeryHard": { "damage": 1, "cooldown": 0.8, "warn": 0, "bossHp": 1.5,  "bossDamage": 1.3 },
      "Heroic":   { "damage": 1, "cooldown": 0.8, "warn": 0, "bossHp": 1.5,  "bossDamage": 1.3 },
      "Iron":     { "damage": 1, "cooldown": 0.8, "warn": 0, "bossHp": 1.5,  "bossDamage": 1.3 }
    }
  },
