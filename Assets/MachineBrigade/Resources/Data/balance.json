  // Prompt 16 F: escorts for every boss (BossSystem.Escorts, DECISIONS 15B). A wave comes in with the boss
  // ("arrive") and another at each phase change ("phase": the same wave every change; "phases": one per change,
  // the last repeating). A change is the boss's own phase marks, else the table's "marks", else escortRules.marks;
  // "on": "surface" counts the Earth Worm's break-outs instead. A wave is a list of units, or an object
  // { "units", "drop" (beside / para / edge / place), "support" (a para drop's warning and parachutes; default
  // "escort_drop.<unit>"), "halt" (seconds the boss stops for it), "refill" (only replaces its own losses),
  // "radio" }. A unit: "unit", "role" (guard, repair, jam, cover, spot, smoke, raid), "elite" (always its elite),
  // "slot" (flank, rear, screen, front; guards and raiders flank, helpers rear), "at" ([x right, y forward] in the
  // boss's frame, for "place"), "count". Every wave has at least one helper (any role but guard and raid); the
  // helpers of a wave come first when the cap is near. A table may set its own "leash" and "cap".
  "escortRules": {
    // Play-test 6 (DECISIONS 21G): 30-50 % more alive at once (was 4, 5, 6, 6, 6, 6), and in Boss Rush 4 at least and
    // 70 % of each wave's guards (was 3 and 50 %).
    "cap": { "Easy": 5, "Normal": 7, "Hard": 8, "VeryHard": 9, "Heroic": 9, "Iron": 9 },
    "bossRushCut": 2, "bossRushMin": 4, "bossRushGuards": 0.7,
    "leash": 28, "bounty": 3, "helperBounty": 4, "repair": 0.003, "repairReach": 12,
    "spotBonus": 0.15, "spotSpread": 0.6, "marks": [0.5], "dropWarn": 3
  },
  // Prompt 20 E.4: escort templates by general. A table in "escorts" with "template" is built on its general's; a
  // boss with no table of its own gets its general's (a ship sails with its "fleet" instead). A mini boss's waves are
  // cut to its rank's cap (bossRanks.mini.escortCap).
  // Play-test 6 (DECISIONS 21G): escorts are vehicles, never towers (Brandt's and the Bastion's drove in as dropped
  // turrets); every arrival wave one more (a guard, or air cover where it had none), so aircraft meet anti-air.
  "escortTemplates": {
    "brandt":  { "arrive": [ { "unit": "tank_destroyer" }, { "unit": "main_battle_tank" }, { "unit": "heavy_aa", "role": "cover" }, { "unit": "engineer_vehicle", "role": "repair" } ],
                 "phase":  [ { "unit": "heavy_tank" }, { "unit": "sam_launcher", "role": "cover" } ] },
    "varga":   { "arrive": [ { "unit": "main_battle_tank" }, { "unit": "main_battle_tank" }, { "unit": "heavy_tank" }, { "unit": "aa_vehicle", "role": "cover" } ],
                 "phase":  [ { "unit": "heavy_tank", "elite": true }, { "unit": "engineer_vehicle", "role": "repair" } ] },
    "orlov":   { "arrive": [ { "unit": "mortar_carrier" }, { "unit": "main_battle_tank" }, { "unit": "sam_launcher", "role": "cover" }, { "unit": "counter_battery_radar", "role": "spot" } ],
                 "phase":  [ { "unit": "mlrs" }, { "unit": "engineer_vehicle", "role": "repair" } ] },
    "kessler": { "arrive": [ { "unit": "wheeled_gun" }, { "unit": "ifv" }, { "unit": "main_battle_tank" }, { "unit": "sam_launcher", "role": "cover" } ],
                 "phase":  [ { "unit": "main_battle_tank" }, { "unit": "smoke_carrier", "role": "smoke" } ] },
    "sen":     { "arrive": [ { "unit": "fpv_carrier" }, { "unit": "strike_drone" }, { "unit": "heavy_aa", "role": "cover" }, { "unit": "ew_jammer", "role": "jam" } ],
                 "phase":  [ { "unit": "lancet_truck" }, { "unit": "recon_drone", "role": "spot" } ] },
    "hung":    { "arrive": [ { "unit": "heavy_tank" }, { "unit": "bmpt" }, { "unit": "sam_launcher", "role": "cover" }, { "unit": "engineer_vehicle", "role": "repair" } ],
