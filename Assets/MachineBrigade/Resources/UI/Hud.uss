/* Machine Brigade HUD: "command console" design system. Controls hug the screen edges in
   dark glass clusters so the fight owns the middle; buttons press down on a darker bottom edge.
   Amber marks what is selected or primary; green is ours, red is theirs. All text is Be
   Vietnam Pro (drawn for Vietnamese, so stacked accents never clip or push a line off centre);
   numbers use Barlow Condensed. Labels are one line and cut with an ellipsis rather than
   spill out of their box. Authored for a 1280 x 720 reference resolution (the panel scales
   with screen height). */

:root {
    --n950: #0c0f12;
    --n900: #111418;
    --n850: #161a20;
    --n800: #1b2126;
    --n750: #232b31;
    --n700: #2e3840;
    --n600: #3a4650;
    --n500: #52606d;
    --n400: #7e8f9c;
    --n300: #a9b4ba;
    --n200: #cfd7dc;
    --n100: #edeff0;
    --amber: #f2a33a;
    --amber-light: #f5b55e;
    --amber-dark: #d98620;
    --amber-deep: #b86814;
    --amber-ink: #1b1206;
    --ally: #6e8b3d;
    --ally-dark: #4a5f27;
    --mint: #8fd694;
    --danger: #e5533c;
    --danger-dark: #992211;
    --chalk: #f1ece2;
    --glass: rgba(16, 20, 24, 0.9);
    --glass-raised: #252e35;
}

.hud {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    -unity-font: resource("Fonts/BeVietnamPro-Medium");
    color: var(--chalk);
    font-size: 14px;
}

.safe { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }

/* Icons take their colour from --icon-color (see IconElement); selected states turn them dark. */
.icon { --icon-color: #f1ece2; flex-shrink: 0; }

/* One line that never spills out of its box: centred, cut with an ellipsis if it must be. */
.fit { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; -unity-text-align: middle-center; }

/* ================================================================ shared building blocks */
.panel-header {
    flex-direction: row; align-items: center; justify-content: space-between;
    height: 30px; padding-left: 12px; padding-right: 12px;
    background-color: var(--n700);
}
.caps {
    -unity-font: resource("Fonts/BeVietnamPro-Bold");
    font-size: 11px; letter-spacing: 1.5px;
    color: var(--n300);
    -unity-text-align: middle-left;
}

/* A solid, pressable button: face plus a darker bottom edge that flattens when pressed. */
.tool, .cmd, .wide, .segment, .toggle, .setting-row, .icon-button, .card, .point-chip, .option {
    border-bottom-width: 3px;
}
.tool:active, .cmd:active, .wide:active, .segment:active, .toggle:active, .icon-button:active, .card:active, .option:active,
.tool.pressed, .cmd.pressed, .wide.pressed, .segment.pressed, .toggle.pressed, .icon-button.pressed, .card.pressed, .option.pressed {
    border-bottom-width: 1px;
    translate: 0 2px;
}

/* ================================================================ top bar: scores in the middle, pause on the right */
.topbar {
    position: absolute; top: 8px; left: 0; right: 0;
    flex-direction: row; align-items: flex-start;
    padding-left: 10px; padding-right: 10px;
}
.topbar-left { width: 236px; }
.brand { display: none; }

.stats { flex-grow: 1; flex-direction: row; justify-content: center; align-items: center; }
.stat {
    flex-direction: row; align-items: center;
    height: 46px; padding-left: 12px; padding-right: 14px; margin-left: 3px; margin-right: 3px;
    background-color: var(--glass);
    border-radius: 10px;
}
.stat .icon { width: 20px; height: 20px; margin-right: 8px; }
.stat-text { justify-content: center; }
.stat-number { -unity-font: resource("Fonts/BarlowCondensed-Bold"); font-size: 26px; -unity-text-align: middle-left; color: var(--chalk); margin-top: -2px; margin-bottom: -4px; }
.stat-label { -unity-font: resource("Fonts/BeVietnamPro-Bold"); font-size: 9px; letter-spacing: 1px; color: var(--n400); }
.stat-divider { width: 0; }

.topbar-right { flex-direction: row; align-items: center; width: 236px; justify-content: flex-end; }
.fps {
    -unity-font: resource("Fonts/BarlowCondensed-Bold"); font-size: 14px; color: var(--n300);
    margin-right: 8px; padding: 2px 8px;
    background-color: var(--glass); border-radius: 6px;
}

.icon-button {
    width: 48px; height: 46px;
    align-items: center; justify-content: center;
    background-color: var(--glass-raised);
    border-radius: 10px;
    border-bottom-color: var(--n950);
}
.icon-button .icon { width: 22px; height: 22px; }

/* ================================================================ conquest score */
.score { flex-direction: row; align-items: center; }
.score-side {
    flex-direction: row; align-items: center; width: 176px; height: 46px;
    padding-left: 12px; padding-right: 12px;
    background-color: var(--glass); border-radius: 10px;
}
.score-side.theirs { justify-content: flex-end; }
.score-number { -unity-font: resource("Fonts/BarlowCondensed-Bold"); font-size: 30px; margin-left: 4px; margin-right: 4px; margin-top: -2px; }
.score-side.ours .score-number { color: var(--mint); }
.score-side.theirs .score-number { color: var(--danger); }
.score-column { flex-grow: 1; justify-content: center; }
.score-side .stat-label { margin-top: 0; }
.score-side.theirs .stat-label { -unity-text-align: middle-right; }
.score-track { height: 7px; margin-top: 4px; background-color: var(--n950); border-radius: 4px; overflow: hidden; }
.score-fill { height: 100%; width: 100%; background-color: var(--mint); }
.score-side.theirs .score-track { flex-direction: row-reverse; }
.score-side.theirs .score-fill { background-color: var(--danger); }

.chips { flex-direction: row; margin-left: 8px; margin-right: 8px; }
.point-chip {
    width: 44px; height: 44px;
    margin-left: 4px; margin-right: 4px;
    align-items: center; justify-content: center;
    border-radius: 22px;
    background-color: var(--n600);
    border-bottom-color: var(--n800);
}
.point-letter { -unity-font: resource("Fonts/BarlowCondensed-Bold"); font-size: 22px; color: var(--chalk); -unity-text-align: middle-center; }
.point-chip.ours { background-color: var(--ally); border-bottom-color: var(--ally-dark); }
.point-chip.theirs { background-color: var(--danger); border-bottom-color: var(--danger-dark); }
.point-chip.contested { background-color: var(--amber); border-bottom-color: var(--amber-deep); }
.point-chip.contested .point-letter { color: var(--amber-ink); }
.point-chip.focus {
    border-left-width: 3px; border-right-width: 3px; border-top-width: 3px; border-bottom-width: 3px;
    border-color: var(--amber-light);
}

/* ================================================================ mission banner and hint */
.mission { align-items: center; }
.mission-strip {
    padding: 10px 30px 12px 22px;
    background-color: var(--n900);
    border-left-width: 8px; border-left-color: var(--amber);
    border-radius: 8px;
    border-bottom-width: 3px; border-bottom-color: var(--n950);
}
.kicker { -unity-font: resource("Fonts/BeVietnamPro-Bold"); font-size: 12px; letter-spacing: 3px; color: var(--amber); }
.mission-title { -unity-font: resource("Fonts/BeVietnamPro-ExtraBold"); font-size: 34px; color: var(--chalk); margin-top: 2px; }
.mission-sub { -unity-font: resource("Fonts/BeVietnamPro-SemiBold"); font-size: 12px; letter-spacing: 1px; color: var(--n300); margin-top: 2px; }

.hint-bar {
    position: absolute; bottom: 122px; left: 0; right: 0; align-items: center;
    opacity: 1; transition-property: opacity; transition-duration: 0.5s;
}
.hint-bar.gone { opacity: 0; }
.hint {
    -unity-text-align: middle-center;
    -unity-font: resource("Fonts/BeVietnamPro-SemiBold");
    font-size: 12px;
    color: var(--n200);
    padding: 5px 16px;
    background-color: var(--glass);
    border-radius: 14px;
}

/* ================================================================ left column: minimap and tools */
.left-column { position: absolute; left: 10px; top: 8px; width: 216px; }
.minimap {
    width: 216px; height: 216px;
    overflow: hidden;
    background-color: var(--glass);
    border-radius: 12px;
    border-bottom-width: 3px; border-bottom-color: var(--n950);
}
.tools { flex-direction: row; width: 216px; margin-top: 6px; justify-content: space-between; }
.tool {
    width: 51px; height: 46px;
    align-items: center; justify-content: center;
    background-color: var(--glass-raised);
    border-radius: 10px;
    border-bottom-color: var(--n950);
}
.tool .icon { width: 22px; height: 22px; }
.tool-label { display: none; }
.tool.on { background-color: var(--amber); border-bottom-color: var(--amber-deep); }
.tool.on .icon { --icon-color: #1b1206; }

/* ================================================================ commander rail (right edge) */
.rail { position: absolute; right: 10px; top: 116px; width: 72px; }
.rail-group {
    padding: 5px 5px 0 5px;
    margin-bottom: 8px;
    background-color: var(--glass);
    border-radius: 12px;
}
.toggle {
    height: 60px; margin-bottom: 5px;
    flex-direction: column; align-items: center; justify-content: center;
    background-color: var(--glass-raised);
    border-radius: 9px;
    border-bottom-color: var(--n950);
}
.toggle .icon { width: 22px; height: 22px; }
.toggle-label {
    -unity-font: resource("Fonts/BeVietnamPro-Bold"); font-size: 10px; color: var(--n200);
    margin-top: 4px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; -unity-text-align: middle-center;
    max-width: 58px;
}
.toggle.on { background-color: var(--amber); border-bottom-color: var(--amber-deep); }
.toggle.on .toggle-label { color: var(--amber-ink); }
.toggle.on .icon { --icon-color: #1b1206; }
.toggle.switch.on { background-color: var(--ally); border-bottom-color: var(--ally-dark); }
.toggle.switch.on .toggle-label { color: var(--chalk); }
.toggle.switch.on .icon { --icon-color: #f1ece2; }

/* ================================================================ selection card (only while something is selected) */
.command {
    position: absolute; right: 10px; bottom: 116px;
    width: 272px;
    background-color: var(--glass);
    border-radius: 12px;
    border-bottom-width: 3px; border-bottom-color: var(--n950);
    overflow: hidden;
    display: none;
}
.command-header {
    flex-direction: row; align-items: center; justify-content: space-between;
    height: 28px; padding-left: 12px; padding-right: 12px;
    background-color: var(--n800);
}
.command-body { padding: 10px; }
.details { flex-direction: row; align-items: center; }
.portrait {
    width: 46px; height: 46px;
    margin-right: 10px;
    align-items: center; justify-content: center;
    background-color: var(--n750);
    border-radius: 10px;
}
.portrait .icon { width: 28px; height: 28px; }
.details-text { flex-grow: 1; flex-shrink: 1; overflow: hidden; }
.unit-name {
    -unity-font: resource("Fonts/BeVietnamPro-Bold"); font-size: 15px; color: var(--chalk);
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.unit-name.empty { font-size: 13px; color: var(--n400); }
.hp-track { height: 7px; margin-top: 5px; background-color: var(--n950); border-radius: 4px; overflow: hidden; }
.hp-fill { height: 100%; width: 100%; background-color: var(--mint); }
.hp-fill.hurt { background-color: var(--amber); }
.hp-fill.critical { background-color: var(--danger); }
.hp-text { -unity-font: resource("Fonts/BarlowCondensed-Bold"); font-size: 14px; color: var(--n300); margin-top: 2px; }
.hp-text.hint-text { -unity-font: resource("Fonts/BeVietnamPro-Medium"); font-size: 11px; }
.weapon-row { flex-direction: row; flex-wrap: wrap; margin-top: 8px; }
.weapon-chip {
    flex-direction: row; align-items: center;
    height: 24px; padding: 0 8px 0 6px; margin-right: 4px; margin-bottom: 4px;
    background-color: var(--n800); border-radius: 12px;
}
.weapon-chip .icon { width: 14px; height: 14px; margin-right: 4px; --icon-color: #f5b55e; }
.weapon-name { -unity-font: resource("Fonts/BeVietnamPro-SemiBold"); font-size: 10px; color: var(--n200); white-space: nowrap; }
.counter-text {
    -unity-font: resource("Fonts/BeVietnamPro-SemiBold"); font-size: 10px; color: var(--amber-light);
    margin-top: 2px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}

.buttons { flex-direction: row; margin-top: 8px; }
.cmd {
    flex-grow: 1; flex-basis: 0;
    height: 46px;
    margin-right: 6px;
    flex-direction: row; align-items: center; justify-content: center;
    background-color: var(--n750);
    border-radius: 9px;
    border-bottom-color: var(--n950);
}
.cmd.last { margin-right: 0; }
.cmd .icon { width: 20px; height: 20px; margin-right: 6px; }
.cmd-label { -unity-font: resource("Fonts/BeVietnamPro-Bold"); font-size: 12px; color: var(--n200); -unity-text-align: middle-center; }
.cmd.armed { background-color: var(--amber); border-bottom-color: var(--amber-deep); }
.cmd.armed .cmd-label { color: var(--amber-ink); }
.cmd.armed .icon { --icon-color: #1b1206; }
.cmd.disabled { background-color: var(--n800); }
.cmd.disabled .cmd-label { color: var(--n500); }
.cmd.disabled .icon { --icon-color: #52606d; }

/* ================================================================ deck tray */
.deck {
    position: absolute; bottom: 8px; left: 236px; right: 92px;
    flex-direction: row; align-items: flex-end; justify-content: center;
}
.cp-meter {
    width: 88px; height: 96px; margin-right: 6px;
    background-color: var(--glass);
    border-radius: 12px;
    border-bottom-width: 3px; border-bottom-color: var(--n950);
    overflow: hidden;
    justify-content: center;
}
.cp-top { flex-direction: row; align-items: center; justify-content: center; }
.cp-top .icon { width: 18px; height: 18px; margin-right: 3px; --icon-color: #f4a62a; }
.cp-value { -unity-font: resource("Fonts/BarlowCondensed-Bold"); font-size: 38px; color: var(--amber); margin-top: -6px; margin-bottom: -6px; -unity-text-align: middle-center; }
.cp-track { height: 7px; margin: 4px 10px 0 10px; background-color: var(--n950); border-radius: 4px; overflow: hidden; }
.cp-fill { height: 100%; width: 0; background-color: var(--amber); }
.cp-army {
    -unity-font: resource("Fonts/BarlowCondensed-Bold"); font-size: 14px; color: var(--n300);
    -unity-text-align: middle-center; margin-top: 5px;
}
/* upkeep: the army is bigger than its supply and the income is cut */
.cp-army.upkeep { color: var(--amber); }
/* boost: the underdog's reinforcements come faster (catch-up) */
.cp-army.boost { color: var(--mint); }

/* ================================================================ arsenal: ranks, equipment, crates */
.arsenal-detail { height: 118px; }
.arsenal-body { padding-bottom: 12px; }
.rank-card .rank-badge {
    -unity-font: resource("Fonts/BeVietnamPro-Bold"); font-size: 11px; color: var(--amber-ink);
    background-color: var(--amber); border-radius: 8px; padding: 1px 8px; margin-top: 2px;
}
.print-track { width: 80%; height: 5px; margin-top: 6px; background-color: var(--n900); border-radius: 3px; overflow: hidden; }
.print-fill { height: 5px; background-color: var(--mint); }
.rank-card.ready { border-color: var(--mint); }
.branch-row { margin-bottom: 8px; }
.gear-slots { flex-direction: row; flex-wrap: wrap; margin-bottom: 6px; }
.gear-slot {
    width: 86px; height: 74px; margin: 0 6px 6px 0; align-items: center; justify-content: center;
    background-color: var(--n750); border-radius: 10px; border-width: 2px;
}
.gear-slot.special { background-color: var(--n800); }
.gear-slot.chosen { background-color: var(--n700); }
.gear-slot .icon { width: 24px; height: 24px; }
.gear-slot-value { -unity-font: resource("Fonts/BeVietnamPro-Bold"); font-size: 10px; color: var(--n200); margin-top: 4px; -unity-text-align: middle-center; white-space: normal; }
.gear-tools { flex-direction: row; align-items: center; justify-content: space-between; margin: 4px 0 6px 0; }
.small-wide { height: 36px; padding: 0 10px; }
.gear-grid { flex-direction: row; flex-wrap: wrap; }
.gear-tile {
    width: 64px; height: 64px; margin: 0 6px 6px 0; align-items: center; justify-content: center;
    background-color: var(--n800); border-radius: 8px; border-width: 2px;
}
.gear-tile.chosen { background-color: var(--n700); }
.gear-tile.equipped { background-color: var(--ally-dark); }
.gear-tile .icon { width: 26px; height: 26px; }
.gear-tile-level { -unity-font: resource("Fonts/BeVietnamPro-SemiBold"); font-size: 10px; color: var(--n300); margin-top: 2px; }
.crate-grid { flex-direction: row; flex-wrap: wrap; }
.crate-tile {
    width: 48%; margin: 0 2% 8px 0; padding: 10px; background-color: var(--n750); border-radius: 10px;
    border-left-width: 4px; border-left-color: var(--n400);
}
.crate-tile.silver { border-left-color: #c9d2da; }
.crate-tile.gold { border-left-color: #f2c14e; }
.crate-tile.legendary { border-left-color: #b86cf0; }
.crate-tile.ad-crate { width: 98%; border-left-color: var(--mint); }
.crate-top { flex-direction: row; align-items: center; }
.crate-top .icon { width: 30px; height: 30px; margin-right: 10px; }
.crate-name { -unity-font: resource("Fonts/BeVietnamPro-Bold"); font-size: 14px; color: var(--chalk); }
.crate-count { -unity-font: resource("Fonts/BeVietnamPro-SemiBold"); font-size: 11px; color: var(--n300); white-space: normal; }
.crate-buttons { flex-direction: row; flex-wrap: wrap; margin-top: 8px; }
.crate-button {
    flex-direction: row; align-items: center; height: 32px; padding: 0 10px; margin: 0 6px 6px 0;
    background-color: var(--n850); border-radius: 6px; border-bottom-width: 2px; border-bottom-color: var(--n950);
}
.crate-button.primary { background-color: var(--amber); }
.crate-button.primary .crate-button-text { color: var(--amber-ink); }
.crate-button.pressed { translate: 0 2px; border-bottom-width: 0; }
.crate-button .icon { width: 16px; height: 16px; margin-right: 6px; }
.crate-button-text { -unity-font: resource("Fonts/BeVietnamPro-Bold"); font-size: 12px; color: var(--chalk); }
.loot-overlay { align-items: center; justify-content: center; background-color: rgba(4, 6, 8, 0.78); }
.loot-card { width: 560px; max-height: 86%; padding: 18px; background-color: var(--n850); border-radius: 14px; border-width: 2px; border-color: var(--amber); }
.loot-title { -unity-font: resource("Fonts/BeVietnamPro-Bold"); font-size: 20px; color: var(--amber); margin-bottom: 8px; -unity-text-align: middle-center; }
.loot-scroll { max-height: 380px; margin-bottom: 10px; }
.loot-row { flex-direction: row; align-items: center; padding: 6px 8px; margin-bottom: 4px; background-color: var(--n800); border-radius: 6px; transition-property: opacity; transition-duration: 0.25s; }
.loot-row .icon { width: 18px; height: 18px; margin-right: 8px; }
.loot-text { -unity-font: resource("Fonts/BeVietnamPro-SemiBold"); font-size: 13px; color: var(--chalk); white-space: normal; flex-shrink: 1; }
.crate-chip .icon { --icon-color: #f2c14e; }
.wide.disabled { opacity: 0.55; }
.dock-row .arsenal-go { flex-grow: 1; flex-shrink: 1; margin-right: 10px; height: 64px; }
.dock-row .arsenal-two { flex-shrink: 1; margin-right: 10px; height: 64px; }
.arsenal-go .wide-title, .arsenal-two .wide-title { font-size: 15px; letter-spacing: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
/* The narrow main page: a compact brand strip, and four dock buttons that fit. */
.menu-brand.compact .menu-title { font-size: 22px; letter-spacing: 2px; margin-right: 5px; }
.menu-brand.compact > .icon { width: 28px; height: 28px; margin-right: 8px; }
.menu-brand.compact .rank-pill, .menu-brand.compact .coin-pill { padding: 0 7px; margin-left: 5px; }
.menu-brand.compact .rank-label { display: none; }
.menu-brand.compact .rank-track { width: 34px; }
.menu-small .wide .wide-title { font-size: 14px; letter-spacing: 0; }
.menu-small .wide .icon { width: 18px; height: 18px; margin-right: 6px; }
.cards {
    flex-direction: row; align-items: flex-end;
    padding: 6px 4px;
    background-color: var(--glass);
    border-radius: 12px;
    border-bottom-width: 3px; border-bottom-color: var(--n950);
}
.card-gap { width: 10px; flex-shrink: 1; }
.card {
    width: 80px; height: 88px; min-width: 56px; flex-shrink: 1;
    margin-left: 3px; margin-right: 3px;
    align-items: center;
    overflow: hidden;
    background-color: var(--n750);
    border-radius: 9px;
    border-bottom-color: var(--n950);
}
.card .icon { width: 34px; height: 34px; margin-top: 16px; }
.card-name {
    position: absolute; left: 0; right: 0; bottom: 0;
    height: 24px;
    -unity-font: resource("Fonts/BeVietnamPro-Bold"); font-size: 10px;
    -unity-text-align: middle-center; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    padding-left: 3px; padding-right: 3px;
    color: var(--chalk);
    background-color: var(--n850);
}
.card-cost {
    position: absolute; top: 4px; left: 4px;
    width: 24px; height: 24px;
    align-items: center; justify-content: center;
    background-color: var(--amber);
    border-radius: 12px;
}
.card-cost-text { -unity-font: resource("Fonts/BarlowCondensed-Bold"); font-size: 17px; color: var(--amber-ink); -unity-text-align: middle-center; margin-top: -1px; }
.card-cooldown { position: absolute; left: 0; right: 0; bottom: 0; height: 0; background-color: rgb(12, 15, 18); opacity: 0.78; }
.card.support { border-top-width: 4px; border-top-color: var(--danger); }
/* Disabled states stay solid and readable: dark card, grey icon, badge says why. */
.card.unaffordable .icon, .card.locked .icon { --icon-color: #52606d; }
.card.unaffordable .card-name, .card.locked .card-name { color: var(--n400); }
.card.unaffordable .card-cost { background-color: var(--n950); }
.card.unaffordable .card-cost-text { color: var(--danger); }
.card.locked { background-color: var(--n800); }
.card.locked .card-cost { background-color: var(--n600); }
.card.locked .card-cost-text { color: var(--n200); }
.card.selected { background-color: var(--danger); border-bottom-color: var(--danger-dark); translate: 0 -8px; }
.card.selected .card-name { background-color: var(--danger-dark); }

/* ================================================================ targeting prompt, toast */
.targeting {
    position: absolute; bottom: 118px; left: 0; right: 0;
    flex-direction: row; justify-content: center; align-items: center;
}
.targeting-text {
    height: 44px; padding: 0 18px; margin-right: 8px;
    -unity-text-align: middle-left;
    -unity-font: resource("Fonts/BeVietnamPro-Bold"); font-size: 14px;
    color: var(--chalk);
    background-color: var(--danger);
    border-radius: 10px;
    border-bottom-width: 3px; border-bottom-color: var(--danger-dark);
}

.toast {
    position: absolute; top: 64px; left: 0; right: 0;
    align-items: center;
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.2s;
}
.toast.visible { opacity: 1; }
.toast-box {
    padding: 8px 20px 9px 20px;
    background-color: var(--amber);
    border-radius: 18px;
    border-bottom-width: 3px; border-bottom-color: var(--amber-deep);
}
.toast-text { -unity-font: resource("Fonts/BeVietnamPro-Bold"); font-size: 14px; color: var(--amber-ink); -unity-text-align: middle-center; }
.toast-box.error { background-color: var(--danger); border-bottom-color: var(--danger-dark); }
.toast-box.error .toast-text { color: var(--chalk); }

.banner {
    position: absolute; top: 96px; left: 0; right: 0;
    align-items: center;
    opacity: 0;
    transition-property: opacity; transition-duration: 0.4s;
}
.banner.visible { opacity: 1; }

.selection-box {
    position: absolute;
    background-color: rgba(244, 166, 42, 0.14);
    border-width: 2px;
    border-color: var(--amber);
    display: none;
}

/* ================================================================ wide buttons (menus, overlays) */
.wide {
    flex-direction: row; align-items: center;
    height: 50px;
    padding-left: 14px; padding-right: 16px;
    margin-top: 8px;
    background-color: var(--n700);
    border-radius: 6px;
    border-bottom-color: var(--n950);
}
.wide .icon { width: 22px; height: 22px; margin-right: 12px; }
.wide-title { -unity-font: resource("Fonts/BeVietnamPro-Bold"); font-size: 16px; letter-spacing: 1px; color: var(--n100); }
.wide-text { flex-shrink: 1; }
.wide-sub { font-size: 11px; color: var(--n300); margin-top: 0; white-space: normal; }
.wide.primary { background-color: var(--amber); border-bottom-color: var(--amber-deep); border-bottom-width: 5px; }
.wide.primary .wide-title { color: var(--amber-ink); }
.wide.primary .icon { --icon-color: #1b1206; }
.wide.big { height: 64px; justify-content: center; }
.wide.big .wide-title { font-size: 28px; letter-spacing: 5px; }
.wide.small-wide { height: 42px; margin-top: 0; }
.wide.danger { background-color: var(--danger); border-bottom-color: var(--danger-dark); }

/* ================================================================ overlays: pause and result */
.overlay {
    position: absolute; left: 0; top: 0; right: 0; bottom: 0;
    align-items: center; justify-content: center;
    background-color: rgba(8, 10, 12, 0.72);
}
.result-card {
    width: 400px;
    align-items: stretch;
    background-color: var(--n800);
    border-radius: 10px;
    border-bottom-width: 4px; border-bottom-color: var(--n950);
    overflow: hidden;
    padding-bottom: 18px;
}
.result-head { align-items: center; padding: 14px 20px 10px 20px; background-color: var(--n700); }
.result-head.victory { background-color: var(--ally); }
.result-head.defeat { background-color: var(--danger); }
.result-head .icon { width: 40px; height: 40px; }
.result-title {
    -unity-font: resource("Fonts/BeVietnamPro-Bold"); font-size: 40px; letter-spacing: 1px;
    -unity-text-align: middle-center; margin-top: 2px; color: var(--n100);
}
.result-sub {
    -unity-font: resource("Fonts/BeVietnamPro-SemiBold");
    -unity-text-align: middle-center; font-size: 12px; letter-spacing: 1px; color: var(--n300);
    margin-top: 10px; margin-bottom: 4px;
}
.result-row {
    flex-direction: row; justify-content: space-between;
    margin-left: 18px; margin-right: 18px; margin-top: 6px;
    padding: 8px 12px;
    background-color: var(--n750); border-radius: 5px;
}
.result-label { -unity-font: resource("Fonts/BeVietnamPro-SemiBold"); color: var(--n300); font-size: 13px; letter-spacing: 1px; }
.result-value { -unity-font: resource("Fonts/BarlowCondensed-Bold"); font-size: 17px; color: var(--n100); }
.result-buttons { margin: 12px 18px 0 18px; }

/* ================================================================ main menu */
.menu { position: absolute; left: 0; top: 0; bottom: 0; right: 0; }
.menu-panel {
    position: absolute; left: 0; top: 0; bottom: 0;
    width: 470px;
    background-color: var(--n850);
    border-right-width: 3px; border-right-color: var(--n950);
}
.menu-panel.wide-panel { width: 700px; }
.menu-body { flex-grow: 1; flex-shrink: 1; padding: 0 22px; overflow: hidden; }
.menu-brand {
    flex-direction: row; align-items: center;
    height: 64px; padding-left: 22px; flex-shrink: 0;
    background-color: var(--n900);
    border-bottom-width: 2px; border-bottom-color: var(--n950);
}
.menu-brand .icon { width: 34px; height: 34px; margin-right: 12px; --icon-color: #f2a33a; }
.menu-brand-text { flex-direction: row; align-items: center; }
.menu-title { -unity-font: resource("Fonts/BarlowCondensed-Bold"); font-size: 30px; letter-spacing: 5px; color: var(--n100); margin-right: 8px; }
.menu-title.accent { color: var(--amber); }
.menu-tagline {
    -unity-font: resource("Fonts/BeVietnamPro-SemiBold");
    color: var(--n400); font-size: 12px; letter-spacing: 1px;
    margin-top: 10px;
}
.menu-caps {
    -unity-font: resource("Fonts/BeVietnamPro-Bold");
    font-size: 13px; letter-spacing: 1px; color: var(--n200);
    margin-top: 12px; margin-bottom: 6px;
}
.menu-modes { flex-direction: row; }
.mode-card {
    flex-grow: 1; flex-basis: 0; height: 68px; margin-right: 8px; margin-top: 0; padding-right: 8px;
    background-color: var(--n750);
    border-left-width: 6px; border-left-color: var(--n750);
}
.mode-card.last-card { margin-right: 0; }
.mode-card .wide-sub { font-size: 10px; }
.mode-card.chosen { background-color: var(--n700); border-left-color: var(--amber); }
.mode-card.chosen .wide-title { color: var(--amber); }
.mode-card.chosen .icon { --icon-color: #f2a33a; }

.maps { flex-direction: row; }
.map-card {
    flex-grow: 1; flex-basis: 0; height: 84px; margin-right: 6px;
    background-color: var(--n750);
    border-radius: 6px;
    border-width: 3px; border-color: var(--n750);
    border-bottom-color: var(--n950);
    overflow: hidden;
}
.map-card.last-card { margin-right: 0; }
.map-art { height: 44px; align-items: center; justify-content: center; background-color: var(--n700); }
.map-art .icon { width: 24px; height: 24px; }
.map-art.temperate { background-color: #4f6b3a; }
.map-art.desert { background-color: #9a7440; }
.map-art.snow { background-color: #7d93a3; }
.map-art.harbor { background-color: #35566b; }
.map-art.volcanic { background-color: #6a2a1a; }
.map-art.jungle { background-color: #2f5a2a; }
.map-art.urban { background-color: #4a5058; }
.map-name { -unity-font: resource("Fonts/BeVietnamPro-Bold"); font-size: 13px; letter-spacing: 1px; margin: 2px 6px 0 6px; color: var(--n100);  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;}
.map-sub { -unity-font: resource("Fonts/BeVietnamPro-SemiBold"); font-size: 10px; letter-spacing: 0; margin: -3px 6px 0 6px; color: var(--n400); }
.map-name, .map-sub { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.map-card.chosen { border-left-color: var(--amber); border-right-color: var(--amber); border-top-color: var(--amber); border-bottom-color: var(--amber); }
.map-card.chosen .map-name { color: var(--amber); }
.map-card.locked .map-art { background-color: var(--n700); }
.map-card.locked .map-art .icon { --icon-color: #52606d; }
.map-card.locked .map-name, .map-card.locked .map-sub { color: var(--n500); }

.segments { flex-direction: row; flex-wrap: wrap; }
.segment {
    flex-grow: 1; flex-basis: 0; height: 40px; margin-right: 5px; margin-bottom: 5px;
    flex-direction: row; align-items: center; justify-content: center;
    background-color: var(--n750);
    border-radius: 6px;
    border-bottom-color: var(--n950);
}
.segment.last-segment { margin-right: 0; }
.segments.grid .segment { flex-basis: 18%; }
.segment .icon { width: 16px; height: 16px; margin-right: 5px; }
.segment-label { -unity-font: resource("Fonts/BeVietnamPro-Bold"); font-size: 12px; letter-spacing: 1px; color: var(--n200); }
.segment.chosen { background-color: var(--amber); border-bottom-color: var(--amber-deep); }
.segment.chosen .segment-label { color: var(--amber-ink); }
.segment.chosen .icon { --icon-color: #1b1206; }

.menu-actions {
    flex-shrink: 0;
    padding: 10px 22px 14px 22px;
    background-color: var(--n900);
    border-top-width: 2px; border-top-color: var(--n950);
}
.menu-small { flex-direction: row; }
.menu-small .wide { flex-grow: 1; flex-basis: 0; margin-right: 8px; justify-content: center; }
.menu-small .wide.last-card { margin-right: 0; }

.deck-grid { flex-direction: row; flex-wrap: wrap; margin-bottom: 8px; }
.deck-card { margin-bottom: 8px; border-left-width: 3px; border-right-width: 3px; border-top-width: 3px; border-color: var(--n700); border-bottom-color: var(--n950); }
.deck-card.support { border-top-color: var(--danger); }
.deck-card.chosen { border-left-color: var(--amber); border-right-color: var(--amber); border-top-color: var(--amber); }
.deck-card.chosen .card-name { background-color: var(--amber); color: var(--amber-ink); }

.setting-row {
    flex-direction: row; align-items: center; height: 50px; padding-left: 14px; padding-right: 8px; margin-top: 7px;
    background-color: var(--n750);
    border-radius: 6px;
    border-bottom-color: var(--n950);
}
.setting-row > .icon { width: 20px; height: 20px; margin-right: 12px; }
.setting-label { flex-grow: 1; -unity-font: resource("Fonts/BeVietnamPro-Bold"); font-size: 15px; letter-spacing: 1px; color: var(--n100); }
.setting-value {
    -unity-font: resource("Fonts/BeVietnamPro-Bold"); font-size: 13px; color: var(--amber);
    min-width: 96px; height: 32px; padding: 0 8px;
    -unity-text-align: middle-center;
    background-color: var(--n900); border-radius: 5px;
}
.setting-row .icon-button { width: 36px; height: 34px; margin-left: 4px; margin-right: 4px; background-color: var(--n600); }

/* Settings list: rows with segmented choices, scrolling under the brand strip. */
.settings-scroll { flex-grow: 1; }
.settings-scroll > .unity-scroll-view__content-viewport > .unity-scroll-view__content-container { padding-bottom: 14px; }
.option-row { height: 54px; margin-top: 6px; }
.option-row .setting-label { font-size: 16px; }
.options { flex-direction: row; }
.option {
    min-width: 68px; height: 38px; margin-left: 5px; padding: 0 10px;
    align-items: center; justify-content: center;
    background-color: var(--n850);
    border-radius: 5px;
    border-bottom-color: var(--n950);
}
.option-label { -unity-font: resource("Fonts/BeVietnamPro-Bold"); font-size: 12px; letter-spacing: 1px; color: var(--n300); }
.option.chosen { background-color: var(--amber); border-bottom-color: var(--amber-deep); }
.option.chosen .option-label { color: var(--amber-ink); }
.custom-tag {
    -unity-font: resource("Fonts/BeVietnamPro-Bold"); font-size: 10px; letter-spacing: 1px;
    color: var(--amber-ink); background-color: var(--amber-light);
    padding: 2px 8px; margin-right: 10px; border-radius: 9px;
}

/* ================================================================ menu: profile, campaign banner, modes */
.menu-brand .brand-profile { flex-direction: row; align-items: center; margin-left: auto; margin-right: 14px; }
.rank-pill, .coin-pill {
    flex-direction: row; align-items: center; height: 34px; padding: 0 10px; margin-left: 8px;
    background-color: var(--n800); border-radius: 17px;
    border-bottom-width: 2px; border-bottom-color: var(--n950);
}
.rank-pill .icon, .coin-pill .icon { width: 18px; height: 18px; margin-right: 6px; --icon-color: #f2a33a; }
.rank-label { -unity-font: resource("Fonts/BeVietnamPro-Bold"); font-size: 11px; letter-spacing: 1px; color: var(--n100); }
.rank-track { width: 56px; height: 4px; margin-top: 1px; background-color: var(--n950); border-radius: 2px; }
.rank-fill { height: 100%; width: 0; background-color: var(--mint); border-radius: 2px; }
.coin-label { -unity-font: resource("Fonts/BarlowCondensed-Bold"); font-size: 17px; color: var(--amber); }

.campaign-banner {
    flex-direction: row; align-items: center; height: 74px; margin-top: 12px; padding: 0 14px;
    background-color: var(--amber-deep); border-radius: 8px;
    border-bottom-color: #7a4410; border-bottom-width: 4px;
}
.campaign-banner:active, .campaign-banner.pressed { border-bottom-width: 1px; translate: 0 3px; }
.campaign-banner > .icon { width: 34px; height: 34px; margin-right: 12px; --icon-color: #fff1dc; }
.campaign-banner-text { flex-grow: 1; }
.campaign-banner-title { -unity-font: resource("Fonts/BeVietnamPro-Bold"); font-size: 18px; letter-spacing: 1px; color: #fff4e2; }
.campaign-banner-sub { -unity-font: resource("Fonts/BeVietnamPro-SemiBold"); font-size: 11px; color: #ffd9a8; margin-top: -2px; }
.campaign-banner-next {
    -unity-font: resource("Fonts/BeVietnamPro-Bold"); font-size: 11px; color: var(--amber-ink);
    background-color: var(--amber-light); border-radius: 12px; padding: 3px 10px; max-width: 170px;
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}

.grid-modes { flex-wrap: wrap; }
.grid-modes .mode-card { flex-basis: 31%; flex-grow: 1; height: 58px; margin-right: 6px; margin-bottom: 6px; }
.grid-modes .mode-card .wide-title { font-size: 16px; letter-spacing: 1px; }
.grid-modes .mode-card .icon { width: 20px; height: 20px; margin-right: 8px; }
.maps { flex-wrap: wrap; }
.maps .map-card { flex-basis: 23%; margin-bottom: 6px; }

.menu-note {
    -unity-font: resource("Fonts/BeVietnamPro-Medium"); font-size: 10px; color: var(--n300); white-space: normal;
    margin-top: 2px; margin-bottom: 8px;
}
.menu-note.warn { color: var(--amber-light); }
.menu-small .wide { padding-left: 8px; padding-right: 8px; }

/* deck locks */
.card-lock {
    position: absolute; left: 0; top: 0; width: 26px; height: 22px; align-items: center; justify-content: center;
    background-color: var(--n950); border-bottom-right-radius: 6px; display: none;
}
.card-lock .icon { width: 14px; height: 14px; --icon-color: #7e8f9c; }
.card.locked .card-lock { display: flex; }

/* shared */
.dock-row { flex-direction: row; }
.dock-row .wide { margin-top: 0; }
.dock-row .wide.big { flex-grow: 1; margin-right: 10px; }
.dock-row .back-button { width: 160px; height: 64px; }
.wide.disabled { background-color: var(--n700); border-bottom-color: var(--n950); }
.wide.disabled .wide-title { color: var(--n400); }
.wide.disabled .icon { --icon-color: #52606d; }
.star-on { --icon-color: #f2a33a; }
.star-off { --icon-color: #3a4650; }

/* ================================================================ campaign page */
.campaign-columns { flex-direction: row; flex-grow: 1; flex-shrink: 1; overflow: hidden; }
.campaign-list { flex-basis: 56%; flex-grow: 0; flex-shrink: 0; padding-right: 8px; }
.campaign-detail {
    flex-grow: 1; margin: 12px 18px 12px 4px; padding-bottom: 12px;
    background-color: var(--n800); border-radius: 8px; overflow: hidden;
}
.map-group { flex-direction: row; align-items: center; margin-top: 10px; margin-bottom: 4px; }
.map-group-swatch { width: 18px; height: 18px; border-radius: 4px; margin-right: 8px; background-color: var(--n600); }
.map-group-swatch.temperate { background-color: #4f6b3a; }
.map-group-swatch.desert { background-color: #9a7440; }
.map-group-swatch.snow { background-color: #7d93a3; }
.map-group-swatch.harbor { background-color: #35566b; }
.map-group-swatch.volcanic { background-color: #6a2a1a; }
.map-group-swatch.jungle { background-color: #2f5a2a; }
.map-group-swatch.urban { background-color: #4a5058; }
.map-group-name { -unity-font: resource("Fonts/BeVietnamPro-Bold"); font-size: 11px; letter-spacing: 1px; color: var(--n300); }
.mission-row {
    flex-direction: row; align-items: center; height: 54px; margin-bottom: 5px; padding: 0 10px;
    background-color: var(--n750); border-radius: 6px; border-bottom-color: var(--n950); border-bottom-width: 3px;
    border-left-width: 4px; border-left-color: var(--n750);
}
.mission-row:active, .mission-row.pressed { border-bottom-width: 1px; translate: 0 2px; }
.mission-row.boss { border-left-color: var(--danger-dark); }
.mission-row.chosen { background-color: var(--n700); border-left-color: var(--amber); }
.mission-row.locked { background-color: var(--n850); }
.mission-row.locked .mission-name, .mission-row.locked .mission-number { color: var(--n500); }
.mission-number { -unity-font: resource("Fonts/BarlowCondensed-Bold"); font-size: 22px; color: var(--amber); width: 34px; }
.mission-text { flex-grow: 1; flex-shrink: 1; }
.mission-name { -unity-font: resource("Fonts/BeVietnamPro-Bold"); font-size: 14px; color: var(--n100);  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;}
.mission-goal-text { -unity-font: resource("Fonts/BeVietnamPro-SemiBold"); font-size: 10px; letter-spacing: 1px; color: var(--n400); margin-top: -3px; }
.mission-stars { flex-direction: row; }
.mission-stars .icon { width: 15px; height: 15px; margin-left: 1px; }
.mission-lock { width: 16px; height: 16px; margin-left: 8px; --icon-color: #7e8f9c; display: none; }
.mission-row.locked .mission-lock { display: flex; }
.mission-row.locked .mission-stars { display: none; }

.detail-art { height: 64px; flex-direction: row; align-items: center; padding: 0 14px; background-color: var(--n700); }
.detail-art.temperate { background-color: #4f6b3a; }
.detail-art.desert { background-color: #9a7440; }
.detail-art.snow { background-color: #7d93a3; }
.detail-art.harbor { background-color: #35566b; }
.detail-art.volcanic { background-color: #6a2a1a; }
.detail-art.jungle { background-color: #2f5a2a; }
.detail-art.urban { background-color: #4a5058; }
.detail-art .icon { width: 28px; height: 28px; margin-right: 10px; }
.detail-kicker { -unity-font: resource("Fonts/BeVietnamPro-Bold"); font-size: 11px; letter-spacing: 1px; color: #f4f7f8; }
.detail-name { -unity-font: resource("Fonts/BeVietnamPro-Bold"); font-size: 22px; letter-spacing: 1px; color: var(--n100); margin: 8px 14px 0 14px;  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;}
.detail-line { flex-direction: row; align-items: center; margin: 4px 14px 0 14px; }
.detail-line .icon { width: 16px; height: 16px; margin-right: 6px; --icon-color: #f2a33a; }
.detail-goal { -unity-font: resource("Fonts/BeVietnamPro-Bold"); font-size: 12px; color: var(--amber); margin-right: 14px; }
.detail-weather { -unity-font: resource("Fonts/BeVietnamPro-SemiBold"); font-size: 11px; color: var(--n300); }
.detail-brief { -unity-font: resource("Fonts/BeVietnamPro-Medium"); font-size: 10px; color: var(--n200); white-space: normal; margin: 8px 14px 0 14px; }
.detail-stars { flex-direction: row; margin: 10px 14px 0 14px; }
.detail-stars .icon { width: 22px; height: 22px; margin-right: 3px; }
.detail-rules { -unity-font: resource("Fonts/BeVietnamPro-Medium"); font-size: 10px; color: var(--n400); white-space: normal; margin: 2px 14px 0 14px; }
.reward-line { margin-top: 10px; }
.detail-tiers { flex-direction: row; flex-wrap: wrap; align-items: center; margin: 8px 14px 0 14px; }
.tier-chip { height: 26px; padding: 0 10px; margin: 0 6px 4px 0; border-radius: 13px; background-color: var(--n700); justify-content: center; }
.tier-chip.chosen { background-color: var(--amber); }
.tier-chip.chosen .tier-name { color: #1d1a12; }
.tier-chip.locked { opacity: 0.35; }
.tier-name { -unity-font: resource("Fonts/BeVietnamPro-Bold"); font-size: 11px; color: var(--n100); }
.tier-rules { -unity-font: resource("Fonts/BeVietnamPro-Medium"); font-size: 10px; color: var(--n400); white-space: normal; flex-basis: 100%; }
.mission-tier { -unity-font: resource("Fonts/BeVietnamPro-Bold"); font-size: 9px; color: var(--amber); margin-right: 4px; }
.mission-tier.iron { color: #d9dde2; }
.detail-reward { -unity-font: resource("Fonts/BeVietnamPro-Bold"); font-size: 13px; color: var(--n100); }
.detail-unlocks { margin: 6px 14px 0 14px; }
.unlock-chip {
    flex-direction: row; align-items: center; height: 28px; padding: 0 10px; margin-top: 4px;
    background-color: var(--ally-dark); border-radius: 14px; align-self: flex-start;
}
.unlock-chip .icon { width: 15px; height: 15px; margin-right: 6px; }
.unlock-chip.owned { background-color: var(--n700); }
.unlock-text { -unity-font: resource("Fonts/BeVietnamPro-Bold"); font-size: 11px; color: #eaf5dd; }

/* ================================================================ shop */
.shop-head { padding: 10px 22px 0 22px; flex-shrink: 0; }
.shop-tabs .segment { flex-basis: 30%; }
.shop-grid { flex-direction: row; flex-wrap: wrap; }
.shop-card {
    width: 150px; height: 168px; margin: 0 8px 8px 0; align-items: center;
    background-color: var(--n750); border-radius: 8px; overflow: hidden;
    border-width: 3px; border-color: var(--n750); border-bottom-color: var(--n950);
}
.shop-card:active, .shop-card.pressed { translate: 0 2px; }
.shop-card.chosen { border-color: var(--amber); }
.shop-card.equipped { background-color: var(--ally-dark); border-color: var(--ally); }
.shop-card.soon { background-color: var(--n850); }
.skin-swatch { flex-direction: row; width: 100%; height: 62px; flex-shrink: 0; }
.skin-band { flex-grow: 1; height: 100%; }
.skin-swatch.metal { border-bottom-width: 3px; border-bottom-color: #ffffff; }
.unit-art { width: 100%; height: 62px; flex-shrink: 0; align-items: center; justify-content: center; background-color: var(--n700); }
.unit-art.premium { background-color: #5a3a12; }
.unit-art .icon { width: 40px; height: 40px; }
.unit-art.premium .icon { --icon-color: #f5b55e; }
/* Names get two lines of room whether they need them or not, so every card's price sits on the same row. */
.shop-name { -unity-font: resource("Fonts/BeVietnamPro-Bold"); font-size: 13px; color: var(--n100); margin-top: 4px; height: 36px; -unity-text-align: middle-center; white-space: normal; padding: 0 6px; }
.shop-sub { -unity-font: resource("Fonts/BeVietnamPro-SemiBold"); font-size: 10px; color: var(--n400); margin-top: -2px; }
.shop-soon { -unity-font: resource("Fonts/BeVietnamPro-Bold"); font-size: 10px; color: var(--n400); margin-top: 6px; }
/* The price is pinned to the bottom of the card, so it lines up across a row whatever sits above it. */
.price-tag { flex-direction: row; align-items: center; justify-content: center; position: absolute; left: 0; right: 0; bottom: 8px; }
.price-tag .icon { width: 15px; height: 15px; margin-right: 4px; --icon-color: #f2a33a; }
.price-value { -unity-font: resource("Fonts/BarlowCondensed-Bold"); font-size: 15px; color: var(--amber); }
.price-status { -unity-font: resource("Fonts/BeVietnamPro-Bold"); font-size: 10px; color: var(--mint); margin-left: 6px; }
.shop-card.owned .price-value { display: none; }
.shop-card.owned .price-tag .icon { display: none; }

/* ================================================================ result rewards, ad screen */
.result-stars { flex-direction: row; justify-content: center; margin-top: 6px; }
.result-stars .icon { width: 30px; height: 30px; margin: 0 3px; }
.result-reward { flex-direction: row; justify-content: center; margin: 10px 18px 0 18px; }
.reward-item {
    flex-direction: row; align-items: center; height: 40px; padding: 0 14px; margin: 0 4px;
    background-color: var(--n900); border-radius: 8px;
}
.reward-item .icon { width: 20px; height: 20px; margin-right: 8px; --icon-color: #f2a33a; }
.reward-item.xp .icon { --icon-color: #8fd694; }
.reward-value { -unity-font: resource("Fonts/BarlowCondensed-Bold"); font-size: 22px; color: var(--n100); }
.reward-doubled {
    -unity-font: resource("Fonts/BarlowCondensed-Bold"); font-size: 14px; color: var(--amber-ink);
    background-color: var(--amber); border-radius: 9px; padding: 0 6px; margin-left: 6px;
}
.result-unlocks { align-items: center; margin-top: 6px; }
.result-unlocks .unlock-chip { align-self: center; }
.wide.ad-button { background-color: var(--ally); border-bottom-color: var(--ally-dark); }
.wide.ad-button .wide-sub { color: #dcebc9; }

.ad-screen { background-color: var(--n950); }
.ad-card {
    width: 460px; align-items: stretch; padding: 22px; background-color: var(--n800); border-radius: 10px;
    border-bottom-width: 4px; border-bottom-color: var(--n950);
}
.ad-card > .icon { width: 44px; height: 44px; align-self: center; --icon-color: #f2a33a; }
.ad-title { -unity-font: resource("Fonts/BeVietnamPro-Bold"); font-size: 26px; letter-spacing: 1px; color: var(--n100); -unity-text-align: middle-center; margin-top: 6px; }
.ad-body { -unity-font: resource("Fonts/BeVietnamPro-Medium"); font-size: 10px; color: var(--n300); white-space: normal; -unity-text-align: middle-center; margin-top: 4px; }
.ad-count { -unity-font: resource("Fonts/BarlowCondensed-Bold"); font-size: 64px; color: var(--amber); -unity-text-align: middle-center; height: 80px; }

/* ================================================================ in-battle: timer, mission bar, boss bar */
.score-centre { align-items: center; }
.score-timer {
    -unity-font: resource("Fonts/BarlowCondensed-Bold"); font-size: 13px; letter-spacing: 1px; color: var(--n200);
    background-color: var(--n800); border-radius: 8px; padding: 0 8px; margin-top: 2px;
}
.score-timer.urgent { background-color: var(--danger); color: #fff1ec; }
.mission-clock.urgent { background-color: var(--danger); color: #fff1ec; }
.mission-bar {
    flex-direction: row; align-items: center; height: 44px; padding: 0 12px;
    background-color: var(--n800); border-radius: 6px;
}
.mission-bar-text { width: 190px; }
.mission-goal { -unity-font: resource("Fonts/BeVietnamPro-Bold"); font-size: 13px; letter-spacing: 1px; color: var(--amber); }
.mission-detail { -unity-font: resource("Fonts/BeVietnamPro-SemiBold"); font-size: 11px; color: var(--n200); margin-top: -3px; }
.mission-track { width: 150px; height: 8px; background-color: var(--n950); border-radius: 2px; margin: 0 10px; }
.mission-fill { height: 100%; width: 0; background-color: var(--amber); border-radius: 2px; }
.mission-chips { margin-left: 0; }
.mission-clock {
    -unity-font: resource("Fonts/BarlowCondensed-Bold"); font-size: 18px; color: var(--n100);
    background-color: var(--n900); border-radius: 6px; padding: 2px 10px; margin-left: 8px;
}
.boss-bar {
    position: absolute; top: 60px; left: 30%; right: 30%; height: 38px; padding: 4px 10px;
    background-color: var(--danger-dark); border-radius: 6px; border-bottom-width: 3px; border-bottom-color: #5c140a;
}
.boss-head { flex-direction: row; align-items: center; }
.boss-head .icon { width: 16px; height: 16px; margin-right: 6px; }
.boss-name { -unity-font: resource("Fonts/BeVietnamPro-Bold"); font-size: 11px; letter-spacing: 1px; color: #ffe6e0; }
.boss-track { height: 9px; margin-top: 2px; background-color: #3a0c05; border-radius: 3px; }
.boss-fill { height: 100%; width: 100%; background-color: #ff6a4d; border-radius: 3px; }

/* cinematic bars */
.letterbox { position: absolute; left: 0; right: 0; height: 0; background-color: #000000; display: none; }
.letterbox.top { top: 0; }
.letterbox.bottom { bottom: 0; }

/* items bought with coins: a column under the minimap tools */
.item-strip { position: absolute; left: 10px; top: 290px; flex-direction: column; }
.item {
    width: 56px; height: 56px; margin-bottom: 6px; border-radius: 8px; align-items: center; justify-content: center;
    background-color: var(--n800); border-width: 2px; border-color: var(--amber);
}
.item.selected { background-color: var(--amber); }
.item.empty { opacity: 0.4; }
.item-cooldown { position: absolute; left: 0; right: 0; bottom: 0; height: 0; background-color: var(--n950); border-radius: 6px; }
.item-count {
    position: absolute; right: -4px; bottom: -4px; padding-left: 4px; padding-right: 4px; border-radius: 6px;
    background-color: var(--amber); min-width: 22px; align-items: center;
}
.item-count-text { -unity-font: resource("Fonts/BarlowCondensed-SemiBold"); font-size: 13px; color: var(--n950); }

/* colour-blind safe teams: blue for ours, orange for theirs */
.cb { --ally: #3f6fb0; --ally-dark: #2b4e80; --mint: #7fb8ff; --danger: #f08c1e; --danger-dark: #a45a0c; }

/* today's challenges on the main menu */
.daily { margin-bottom: 8px; }
.daily-row { flex-direction: row; align-items: center; height: 34px; padding-left: 10px; padding-right: 4px; margin-bottom: 4px;
    background-color: var(--n800); border-radius: 6px; }
.daily-text { flex-grow: 1; -unity-font: resource("Fonts/BeVietnamPro-Medium"); font-size: 10px; color: var(--n200);  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;}
.daily-progress { -unity-font: resource("Fonts/BarlowCondensed-SemiBold"); font-size: 14px; color: var(--n300); margin-right: 8px; }
.daily-claim { flex-direction: row; align-items: center; height: 26px; padding-left: 6px; padding-right: 8px; border-radius: 5px;
    background-color: var(--n700); }
.daily-claim.ready { background-color: var(--amber); }
.daily-claim.claimed { background-color: var(--ally-dark); }
.daily-reward { -unity-font: resource("Fonts/BarlowCondensed-SemiBold"); font-size: 13px; color: var(--n100); margin-left: 3px; }
.daily-claim.ready .daily-reward { color: var(--amber-ink); }

/* ================================================================ menu pass 2: tiles, detail */
.menu-panel { width: 500px; }
.grid-modes { flex-direction: row; flex-wrap: wrap; }
.mode-tile {
    width: 24%; height: 70px; margin-right: 1.3%; margin-bottom: 6px;
    align-items: center; justify-content: center;
    background-color: var(--n750); border-radius: 10px;
    border-bottom-width: 3px; border-bottom-color: var(--n950);
    border-top-width: 3px; border-top-color: var(--n750);
}
.mode-tile:active, .mode-tile.pressed { border-bottom-width: 1px; translate: 0 2px; }
.mode-tile .icon { width: 24px; height: 24px; }
.mode-tile-name {
    -unity-font: resource("Fonts/BeVietnamPro-Bold"); font-size: 11px; color: var(--n200); margin-top: 5px;
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis; -unity-text-align: middle-center; max-width: 100%;
    padding: 0 4px;
}
.mode-tile.chosen { background-color: var(--n700); border-top-color: var(--amber); }
.mode-tile.chosen .mode-tile-name { color: var(--amber); }
.mode-tile.chosen .icon { --icon-color: #f4a62a; }
.mode-info {
    -unity-font: resource("Fonts/BeVietnamPro-SemiBold"); font-size: 12px; color: var(--n300);
    margin: 2px 2px 6px 2px; white-space: normal;
}
.map-sub { display: none; }
.map-card { height: 72px; }

.deck-grid .card { width: 92px; height: 96px; margin: 0 6px 6px 0; }
.card-detail {
    height: 150px; flex-shrink: 0; overflow: hidden; margin: 8px 22px 4px 22px; padding: 10px 12px;
    background-color: var(--n800); border-radius: 10px;
}
.detail-empty { -unity-font: resource("Fonts/BeVietnamPro-SemiBold"); font-size: 13px; color: var(--n300); white-space: normal; margin-top: 6px; }
.detail-head { flex-direction: row; align-items: center; }
.detail-head > .icon { width: 30px; height: 30px; margin-right: 10px; --icon-color: #8fd694; }
.detail-names { flex-grow: 1; flex-shrink: 1; }
.detail-title { -unity-font: resource("Fonts/BeVietnamPro-Bold"); font-size: 16px; color: var(--chalk); }
.detail-counter { -unity-font: resource("Fonts/BeVietnamPro-SemiBold"); font-size: 11px; color: var(--amber-light); white-space: normal; margin-top: 2px; }
.detail-caps { -unity-font: resource("Fonts/BeVietnamPro-Bold"); font-size: 10px; letter-spacing: 1px; color: var(--n400); margin-top: 8px; margin-bottom: 4px; }
.detail-weapons { flex-direction: row; flex-wrap: wrap; }
.detail-weapon {
    flex-direction: row; align-items: center; height: 30px; padding: 0 10px 0 8px; margin: 0 6px 6px 0;
    background-color: var(--n750); border-radius: 15px;
}
.detail-weapon .icon { width: 16px; height: 16px; margin-right: 6px; --icon-color: #f5b55e; }
.detail-weapon-name { -unity-font: resource("Fonts/BeVietnamPro-Bold"); font-size: 12px; color: var(--chalk); }
.detail-weapon-tag {
    -unity-font: resource("Fonts/BeVietnamPro-SemiBold"); font-size: 10px; color: var(--n300); margin-left: 8px;
    padding: 2px 6px; background-color: var(--n850); border-radius: 8px;
}
.detail-weapon-tag.ammo { color: var(--amber-light); }

/* ================================================================ menu v3: mobile layout (top bar, bottom tabs, full pages) */
/* Touch sizes follow the mobile guidance at 720 px tall: tabs 96 px, main actions 84 to 104 px,
   nothing tappable under 52 px. Pages sit between the bars; full pages cover the tabs. */
.menu-backdrop { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: var(--n900); }
.tab-page { position: absolute; top: 72px; bottom: 106px; left: 0; right: 0; }
.full-page { position: absolute; top: 72px; bottom: 0; left: 0; right: 0; background-color: var(--n900); }

/* top bar */
.nav-top {
    position: absolute; top: 0; left: 0; right: 0; height: 72px;
    flex-direction: row; align-items: center; padding: 0 14px;
    background-color: rgba(12, 15, 18, 0.9);
    border-bottom-width: 2px; border-bottom-color: var(--n950);
}
.nav-profile {
    flex-direction: row; align-items: center; height: 54px; padding: 0 16px 0 10px;
    background-color: var(--n800); border-radius: 27px;
}
.nav-profile > .icon { width: 32px; height: 32px; margin-right: 8px; --icon-color: #f2a33a; }
.nav-profile .rank-label { font-size: 15px; }
.nav-profile .rank-track { width: 96px; height: 6px; margin-top: 3px; border-radius: 3px; }
.nav-back {
    flex-direction: row; align-items: center; height: 56px; padding: 0 20px 0 12px;
    background-color: var(--n700); border-radius: 12px; border-bottom-width: 3px; border-bottom-color: var(--n950);
}
.nav-back > .icon { width: 28px; height: 28px; margin-right: 8px; }
.nav-back-text { -unity-font: resource("Fonts/BeVietnamPro-Bold"); font-size: 17px; color: var(--n100); }
.nav-title {
    -unity-font: resource("Fonts/BeVietnamPro-Bold"); font-size: 21px; letter-spacing: 1px; color: var(--n100);
    margin-left: 18px; flex-shrink: 0; white-space: nowrap;
}
.nav-spacer { flex-grow: 1; }
.nav-pill {
    flex-direction: row; align-items: center; height: 54px; padding: 0 6px 0 12px; margin-left: 10px;
    background-color: var(--n950); border-radius: 27px; border-width: 2px; border-color: var(--n700);
}
.nav-pill > .icon { width: 28px; height: 28px; margin-right: 6px; --icon-color: #f2a33a; }
.nav-pill-value { -unity-font: resource("Fonts/BarlowCondensed-Bold"); font-size: 25px; color: var(--n100); min-width: 44px; -unity-text-align: middle-right; margin-right: 8px; }
.nav-pill-plus { width: 40px; height: 40px; border-radius: 20px; align-items: center; justify-content: center; background-color: var(--ally); }
.nav-pill-plus .icon { width: 20px; height: 20px; }
.nav-icon {
    width: 58px; height: 58px; margin-left: 10px; align-items: center; justify-content: center;
    background-color: var(--n700); border-radius: 14px; border-bottom-width: 3px; border-bottom-color: var(--n950);
}
.nav-icon .icon { width: 30px; height: 30px; }
.nav-back.pressed, .nav-pill.pressed, .nav-icon.pressed { translate: 0 2px; }

/* bottom tabs: Battle raised in the middle */
.nav-tabs {
    position: absolute; bottom: 0; left: 0; right: 0; height: 96px;
    flex-direction: row; align-items: flex-end;
    background-color: rgba(12, 15, 18, 0.95);
    border-top-width: 2px; border-top-color: var(--n950);
}
.nav-tab {
    flex-grow: 1; flex-basis: 0; height: 94px; align-items: center; justify-content: center;
    border-top-width: 4px; border-top-color: rgba(0, 0, 0, 0);
}
.nav-tab > .icon { width: 36px; height: 36px; --icon-color: #a9b4ba; }
.nav-tab-label { -unity-font: resource("Fonts/BeVietnamPro-Bold"); font-size: 14px; letter-spacing: 1px; color: var(--n300); margin-top: 4px; }
.nav-tab.chosen { background-color: var(--n800); border-top-color: var(--amber); }
.nav-tab.chosen > .icon { --icon-color: #f2a33a; }
.nav-tab.chosen .nav-tab-label { color: var(--amber); }
.nav-tab.battle {
    flex-grow: 1.35; height: 106px; margin: 0 8px; border-top-width: 0;
    background-color: var(--amber-deep); border-top-left-radius: 18px; border-top-right-radius: 18px;
    border-bottom-width: 0;
}
.nav-tab.battle > .icon { width: 42px; height: 42px; --icon-color: #fff1dc; }
.nav-tab.battle .nav-tab-label { font-size: 17px; letter-spacing: 2px; color: #fff4e2; }
.nav-tab.battle.chosen { background-color: var(--amber); }
.nav-tab.battle.chosen > .icon { --icon-color: #1b1206; }
.nav-tab.battle.chosen .nav-tab-label { color: var(--amber-ink); }
.nav-tab.pressed { translate: 0 2px; }
.red-dot {
    position: absolute; top: 10px; right: 26%; width: 18px; height: 18px; border-radius: 9px;
    background-color: var(--danger); border-width: 2px; border-color: var(--n950); display: none;
}

/* a short message over everything, above the tabs */
.menu-toast {
    position: absolute; bottom: 112px; left: 22%; right: 22%; padding: 12px 18px;
    -unity-font: resource("Fonts/BeVietnamPro-SemiBold"); font-size: 16px; color: var(--n100);
    -unity-text-align: middle-center; white-space: normal;
    background-color: rgba(12, 15, 18, 0.95); border-radius: 12px;
    border-left-width: 5px; border-left-color: var(--ally);
}
.menu-toast.warn { border-left-color: var(--amber); color: var(--amber-light); }

/* shared page parts */
.tab-page .menu-body, .full-page .menu-body { padding: 0; }
.tab-page .menu-caps, .full-page .menu-caps { font-size: 14px; margin-top: 10px; margin-bottom: 8px; }
.page-dock {
    flex-direction: row; align-items: center; justify-content: flex-end; flex-shrink: 0;
    padding: 10px 16px 12px 16px; background-color: var(--n850);
    border-top-width: 2px; border-top-color: var(--n950);
}
.tab-page .segment, .full-page .segment { height: 54px; margin-right: 6px; margin-bottom: 6px; border-radius: 10px; }
.tab-page .segment .icon, .full-page .segment .icon { width: 20px; height: 20px; margin-right: 6px; }
.tab-page .segment-label, .full-page .segment-label { font-size: 14px; }
.tab-page .wide, .full-page .wide { height: 64px; border-radius: 10px; }
.tab-page .wide .wide-title, .full-page .wide .wide-title { font-size: 17px; }
.tab-page .wide.small-wide, .full-page .wide.small-wide { height: 52px; }
.tab-page .menu-note, .full-page .menu-note { font-size: 13px; color: var(--n300); }

/* ================================================================ Battle tab (the lobby) */
.home-left { position: absolute; left: 16px; top: 12px; width: 410px; }
.home-right { position: absolute; right: 16px; bottom: 12px; width: 430px; }
.home-card {
    padding: 12px 14px; margin-bottom: 10px;
    background-color: rgba(16, 20, 24, 0.9); border-radius: 16px;
    border-bottom-width: 4px; border-bottom-color: var(--n950);
}
.home-card > .icon { width: 40px; height: 40px; margin-right: 12px; }
.home-card-text { flex-grow: 1; flex-shrink: 1; }
.home-card-title { -unity-font: resource("Fonts/BeVietnamPro-Bold"); font-size: 19px; color: var(--n100); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.home-card-sub { -unity-font: resource("Fonts/BeVietnamPro-SemiBold"); font-size: 13px; color: var(--n300); margin-top: 1px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.home-card-chips { -unity-font: resource("Fonts/BeVietnamPro-Bold"); font-size: 13px; color: var(--amber-light); margin-top: 3px; }
.home-card-caps { -unity-font: resource("Fonts/BeVietnamPro-Bold"); font-size: 13px; letter-spacing: 1.5px; color: var(--n300); margin-bottom: 8px; }
.home-card-go {
    width: 64px; height: 64px; border-radius: 32px; margin-left: 10px; align-items: center; justify-content: center;
    background-color: var(--amber-light);
}
.home-card-go .icon { width: 28px; height: 28px; --icon-color: #1b1206; }
.home-card-go.change { background-color: var(--n700); border-radius: 14px; width: 60px; height: 60px; }
.home-card-go.change .icon { --icon-color: #edeff0; }
.campaign-card {
    flex-direction: row; align-items: center; height: 100px;
    background-color: var(--amber-deep); border-bottom-color: #7a4410;
}
.campaign-card > .icon { --icon-color: #fff1dc; }
.campaign-card .home-card-title { color: #fff4e2; }
.campaign-card .home-card-sub { color: #ffd9a8; }
.home-card.mode-card {
    flex-direction: row; align-items: center; height: 96px; flex-grow: 0; flex-basis: auto; margin: 0 0 10px 0; padding: 12px 14px;
    border-left-width: 0; background-color: rgba(16, 20, 24, 0.9);
}
.home-card.mode-card > .icon { --icon-color: #f2a33a; }
.campaign-card.pressed, .home-card.mode-card.pressed { translate: 0 3px; border-bottom-width: 1px; }
.daily-card .daily-row { height: 52px; padding-left: 12px; padding-right: 6px; margin-bottom: 6px; border-radius: 10px; }
.daily-card .daily-text { font-size: 13px; }
.daily-card .daily-progress { font-size: 18px; margin-right: 10px; }
.daily-card .daily-claim { height: 42px; min-width: 88px; justify-content: center; border-radius: 10px; }
.daily-card .daily-claim .icon { width: 18px; height: 18px; }
.daily-card .daily-reward { font-size: 18px; margin-left: 4px; }
.deploy-button {
    flex-direction: row; align-items: center; justify-content: center; height: 104px;
    background-color: var(--amber); border-radius: 18px;
    border-bottom-width: 6px; border-bottom-color: var(--amber-deep);
}
.deploy-button > .icon { width: 40px; height: 40px; margin-right: 14px; --icon-color: #1b1206; }
.deploy-text { -unity-font: resource("Fonts/BarlowCondensed-Bold"); font-size: 46px; letter-spacing: 6px; color: var(--amber-ink); }
.deploy-button.pressed { translate: 0 4px; border-bottom-width: 2px; }

/* battle setup page */
.setup-page { flex-direction: column; }
.setup-columns { flex-direction: row; flex-grow: 1; flex-shrink: 1; padding: 6px 16px 0 16px; }
.setup-left { width: 44%; flex-grow: 0; margin-right: 16px; }
.setup-right { flex-grow: 1; }
.setup-modes { flex-direction: row; flex-wrap: wrap; }
.setup-mode {
    width: 31.3%; height: 92px; margin: 0 2% 8px 0; align-items: center; justify-content: center;
    background-color: var(--n750); border-radius: 12px;
    border-bottom-width: 3px; border-bottom-color: var(--n950); border-top-width: 3px; border-top-color: var(--n750);
}
.setup-mode > .icon { width: 32px; height: 32px; }
.setup-mode-name { -unity-font: resource("Fonts/BeVietnamPro-Bold"); font-size: 14px; color: var(--n200); margin-top: 6px; padding: 0 4px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.setup-mode.chosen { background-color: var(--n700); border-top-color: var(--amber); }
.setup-mode.chosen > .icon { --icon-color: #f2a33a; }
.setup-mode.chosen .setup-mode-name { color: var(--amber); }
.setup-mode.pressed { translate: 0 2px; border-bottom-width: 1px; }
.setup-page .mode-info { font-size: 14px; margin-top: 4px; }
.setup-maps { flex-direction: row; flex-wrap: wrap; }
.setup-maps .map-card { flex-grow: 0; flex-basis: auto; width: 31.3%; height: 84px; margin: 0 2% 8px 0; border-radius: 10px; }
.setup-maps .map-art { height: 48px; }
.setup-maps .map-art .icon { width: 30px; height: 30px; }
.setup-maps .map-name { font-size: 14px; margin-top: 6px; -unity-text-align: middle-center; }
.setup-page .segments.grid .segment { flex-basis: 30%; }
.setup-page .page-dock .deploy-button { width: 440px; height: 92px; }
.setup-page .page-dock .deploy-text { font-size: 40px; }

/* ================================================================ Army tab: deck, collection, equipment */
.army-page { padding: 10px 16px 0 16px; }
.army-views { width: 440px; flex-shrink: 0; }
.army-deck { flex-grow: 1; flex-shrink: 1; }
.deck-strip {
    flex-direction: row; align-items: center; flex-shrink: 0; padding: 10px 12px; margin-bottom: 8px;
    background-color: var(--n800); border-radius: 14px;
}
.deck-slots { flex-direction: row; align-items: center; flex-shrink: 0; }
.deck-slot {
    width: 74px; height: 96px; margin-right: 6px; align-items: center; justify-content: center;
    background-color: var(--n700); border-radius: 10px;
    border-bottom-width: 3px; border-bottom-color: var(--n950); border-top-width: 3px; border-top-color: var(--ally);
}
.deck-slot > .icon { width: 40px; height: 40px; }
.deck-slot.support { border-top-color: var(--danger); }
.deck-slot.empty { background-color: var(--n850); border-top-color: var(--n700); border-bottom-color: var(--n850); }
.deck-slot.empty > .icon { width: 26px; height: 26px; --icon-color: #52606d; }
.deck-slot.pressed { translate: 0 2px; }
.deck-slot-rank { position: absolute; bottom: 4px; left: 0; right: 0; -unity-font: resource("Fonts/BarlowCondensed-SemiBold"); font-size: 14px; color: var(--amber-light); -unity-text-align: middle-center; }
.deck-divider { width: 3px; height: 78px; margin: 0 8px 0 2px; background-color: var(--n600); border-radius: 2px; }
.deck-summary { flex-grow: 1; flex-shrink: 1; margin-left: 10px; }
.deck-summary-text { -unity-font: resource("Fonts/BeVietnamPro-SemiBold"); font-size: 13px; color: var(--n200); white-space: normal; }
.deck-warnings { -unity-font: resource("Fonts/BeVietnamPro-Bold"); font-size: 13px; color: var(--amber-light); white-space: normal; margin-top: 3px; }
.doctrine-chips { flex-direction: row; margin-top: 6px; }
.doctrine-chip {
    width: 56px; height: 48px; margin-right: 6px; align-items: center; justify-content: center;
    background-color: var(--n700); border-radius: 10px; border-bottom-width: 3px; border-bottom-color: var(--n950);
}
.doctrine-chip .icon { width: 26px; height: 26px; }
.doctrine-chip.chosen { background-color: var(--amber); border-bottom-color: var(--amber-deep); }
.doctrine-chip.chosen .icon { --icon-color: #1b1206; }
.doctrine-chip.pressed { translate: 0 2px; }
.army-filters { flex-direction: row; flex-shrink: 0; }
.army-scroll { flex-grow: 1; }
.collection-grid { flex-direction: row; flex-wrap: wrap; }

/* a card in the collection */
.unit-card-big {
    width: 144px; height: 180px; margin: 0 10px 10px 0; overflow: hidden;
    background-color: var(--n750); border-radius: 12px;
    border-bottom-width: 4px; border-bottom-color: var(--n950); border-top-width: 4px; border-top-color: var(--ally);
}
.unit-card-big.support { border-top-color: var(--danger); }
.unit-card-big.pressed { translate: 0 2px; border-bottom-width: 2px; }
.unit-card-art { height: 96px; align-items: center; justify-content: center; background-color: var(--n700); }
.unit-card-art .icon { width: 60px; height: 60px; }
.unit-card-name { -unity-font: resource("Fonts/BeVietnamPro-Bold"); font-size: 14px; color: var(--n100); margin: 6px 6px 0 6px; -unity-text-align: middle-center; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.unit-card-rank { -unity-font: resource("Fonts/BarlowCondensed-SemiBold"); font-size: 15px; color: var(--amber-light); -unity-text-align: middle-center; margin-top: -2px; }
.unit-card-foot { flex-direction: row; align-items: center; height: 24px; margin: 2px 10px 0 10px; }
.unit-card-track { flex-grow: 1; height: 10px; background-color: var(--n950); border-radius: 5px; overflow: hidden; }
.unit-card-fill { height: 100%; width: 0; background-color: #4a9cff; }
.unit-card-cost {
    position: absolute; top: 6px; left: 6px; min-width: 28px; height: 28px; padding: 0 4px; border-radius: 14px;
    align-items: center; justify-content: center; background-color: var(--amber); border-width: 2px; border-color: var(--n950);
}
.unit-card-cost-text { -unity-font: resource("Fonts/BarlowCondensed-Bold"); font-size: 17px; color: var(--amber-ink); margin: 0; padding: 0; -unity-text-align: middle-center; }
.deck-slot .unit-card-cost { top: 3px; left: 3px; min-width: 24px; height: 24px; }
.deck-slot .unit-card-cost-text { font-size: 15px; }
.unit-card-check, .unit-card-lock {
    position: absolute; width: 30px; height: 30px; border-radius: 15px; align-items: center; justify-content: center; display: none;
}
.unit-card-up { width: 24px; height: 24px; margin-left: 5px; border-radius: 12px; align-items: center; justify-content: center; display: none; background-color: var(--mint); }
.unit-card-check { top: 6px; right: 6px; background-color: var(--ally); border-width: 2px; border-color: var(--n950); }
.unit-card-check .icon { width: 18px; height: 18px; }
.unit-card-up .icon { width: 16px; height: 16px; }
.unit-card-up .icon { --icon-color: #0c0f12; }
.unit-card-lock { top: 30px; left: 50%; margin-left: -18px; width: 36px; height: 36px; border-radius: 18px; background-color: rgba(12, 15, 18, 0.85); }
.unit-card-lock .icon { width: 20px; height: 20px; --icon-color: #a9b4ba; }
.unit-card-big.in-deck .unit-card-check { display: flex; }
.unit-card-big.in-deck .unit-card-art { background-color: var(--ally-dark); }
.unit-card-big.upgradable .unit-card-up { display: flex; }
.unit-card-big.upgradable .unit-card-fill { background-color: var(--mint); }
.unit-card-big.locked { background-color: var(--n850); border-top-color: var(--n700); }
.unit-card-big.locked .unit-card-lock { display: flex; }
.unit-card-big.locked .unit-card-art { background-color: var(--n800); }
.unit-card-big.locked .unit-card-art .icon { --icon-color: #3a4650; }
.unit-card-big.locked .unit-card-name { color: var(--n500); }
.unit-card-big.locked .unit-card-foot, .unit-card-big.locked .unit-card-cost { display: none; }

/* Info / Use, as a bar along the bottom of the Army tab */
.card-popover {
    position: absolute; left: 16%; right: 16%; bottom: 12px; flex-direction: row; align-items: center;
    padding: 12px 12px 12px 20px; background-color: var(--n800); border-radius: 16px;
    border-width: 2px; border-color: var(--amber);
}
.popover-text { flex-grow: 1; flex-shrink: 1; -unity-font: resource("Fonts/BeVietnamPro-Bold"); font-size: 18px; color: var(--n100); white-space: normal; }
.popover-buttons { flex-direction: row; }
.tab-page .wide.popover-button { height: 72px; min-width: 176px; margin: 0 0 0 10px; justify-content: center; }

/* equipment view: branches, loadout, inventory */
.army-gear { flex-direction: row; flex-grow: 1; flex-shrink: 1; margin-top: 4px; }
.gear-branches { width: 150px; margin-right: 12px; }
.gear-branch {
    height: 90px; margin-bottom: 8px; align-items: center; justify-content: center;
    background-color: var(--n750); border-radius: 12px;
    border-bottom-width: 3px; border-bottom-color: var(--n950); border-left-width: 4px; border-left-color: var(--n750);
}
.gear-branch > .icon { width: 36px; height: 36px; }
.gear-branch-name { -unity-font: resource("Fonts/BeVietnamPro-Bold"); font-size: 14px; color: var(--n200); margin-top: 4px; }
.gear-branch.chosen { background-color: var(--n700); border-left-color: var(--amber); }
.gear-branch.chosen > .icon { --icon-color: #f2a33a; }
.gear-branch.chosen .gear-branch-name { color: var(--amber); }
.gear-branch.pressed { translate: 0 2px; }
.gear-centre { width: 480px; margin-right: 12px; }
.gear-centre .menu-caps { margin-top: 0; }
.gear-centre .gear-slots { flex-direction: row; flex-wrap: wrap; align-items: flex-end; margin-bottom: 2px; }
.gear-slot2 {
    width: 110px; margin: 0 8px 8px 0; padding: 6px 4px; align-items: center;
    background-color: var(--n800); border-radius: 12px;
    border-width: 2px; border-color: var(--n800); border-bottom-width: 3px; border-bottom-color: var(--n950);
}
.gear-slot2.special { width: 128px; background-color: #2a2414; border-color: #2a2414; border-bottom-color: var(--n950); }
.gear-slot2.chosen { background-color: var(--n700); border-color: var(--amber); }
.gear-slot2.pressed { translate: 0 2px; }
.gear-slot2 .gear-slot-value { font-size: 12px; margin-top: 4px; height: 30px; color: var(--n200); }
.gear-info { flex-shrink: 0; min-height: 96px; padding: 12px; margin-bottom: 10px; background-color: var(--n800); border-radius: 12px; }
.gear-total { -unity-font: resource("Fonts/BeVietnamPro-SemiBold"); font-size: 14px; color: var(--mint); white-space: normal; margin-top: 4px; }
.gear-info-head { flex-direction: row; align-items: flex-start; }
.gear-info-names { flex-grow: 1; flex-shrink: 1; margin-left: 12px; }
.gear-info-title { -unity-font: resource("Fonts/BeVietnamPro-Bold"); font-size: 19px; }
.gear-info-line { -unity-font: resource("Fonts/BeVietnamPro-SemiBold"); font-size: 13px; color: var(--n200); white-space: normal; margin-top: 2px; }
.gear-info-compare { -unity-font: resource("Fonts/BeVietnamPro-Bold"); font-size: 13px; color: var(--mint); margin-top: 2px; white-space: normal; }
.gear-info-merge { -unity-font: resource("Fonts/BeVietnamPro-Medium"); font-size: 12px; color: var(--n400); margin-top: 2px; white-space: normal; }
.gear-actions { flex-direction: row; margin-top: 10px; }
.tab-page .gear-actions .wide { flex-grow: 1; flex-basis: 0; height: 62px; margin: 0 8px 0 0; padding: 0 10px; justify-content: center; }
.tab-page .gear-actions .wide .wide-title { font-size: 15px; letter-spacing: 0; }
.tab-page .gear-actions .wide .icon { width: 20px; height: 20px; margin-right: 6px; }
.wide.upgrade-button { background-color: var(--ally); border-bottom-color: var(--ally-dark); }
.gear-inventory { flex-grow: 1; flex-shrink: 1; }
.gear-inventory .gear-tools { margin: 0 0 6px 0; }
.gear-inventory .gear-tools .menu-caps { margin: 0; }
.gear-inventory .gear-tools .wide { padding: 0 14px; }
.gear-scroll { flex-grow: 1; }
.gear-grid2 { flex-direction: row; flex-wrap: wrap; }
.gear-cell { margin: 0 6px 6px 0; padding: 3px; border-radius: 14px; border-width: 3px; border-color: rgba(0, 0, 0, 0); }
.gear-cell.equipped { background-color: var(--ally-dark); }
.gear-cell.chosen { border-color: var(--amber); }
.gear-cell.pressed { translate: 0 2px; }

/* a piece of equipment: rarity frame, picture, pips, level */
.gear-art { -unity-background-scale-mode: stretch-to-fill; flex-shrink: 0; }
.gear-art-picture { position: absolute; left: 7%; top: 5%; right: 7%; bottom: 13%; -unity-background-scale-mode: scale-to-fit; }
.gear-art-pips { position: absolute; left: 0; right: 0; bottom: 4%; flex-direction: row; justify-content: center; }
.gear-art-pip { width: 7px; height: 7px; margin: 0 1.5px; border-radius: 4px; border-width: 1px; border-color: rgba(0, 0, 0, 0.6); }
.gear-art-level {
    position: absolute; top: 4px; right: 5px; padding: 0 5px; border-radius: 6px;
    -unity-font: resource("Fonts/BarlowCondensed-Bold"); font-size: 15px; color: var(--n100);
    background-color: rgba(8, 10, 12, 0.7);
}
.gear-art.empty { background-color: var(--n850); border-radius: 12px; border-width: 2px; border-color: var(--n700); }
.gear-art.empty .gear-art-picture { opacity: 0.2; }

/* ================================================================ vehicle detail page */
.detail-page { flex-direction: column; }
.detail-columns { flex-direction: row; flex-grow: 1; flex-shrink: 1; padding: 10px 16px 0 16px; }
.detail-left { width: 45%; margin-right: 16px; }
.detail-stage {
    flex-grow: 1; flex-shrink: 1; min-height: 200px; align-items: center; justify-content: center; overflow: hidden;
    background-color: var(--n800); border-radius: 16px; border-bottom-width: 4px; border-bottom-color: var(--n950);
}
.detail-preview { position: absolute; left: 0; top: 0; right: 0; bottom: 0; -unity-background-scale-mode: scale-to-fit; }
.detail-big-icon { width: 150px; height: 150px; --icon-color: #a9b4ba; }
.detail-arrow {
    position: absolute; top: 50%; margin-top: -40px; width: 60px; height: 80px; align-items: center; justify-content: center;
    background-color: rgba(12, 15, 18, 0.65); border-radius: 12px;
}
.detail-arrow.left { left: 8px; }
.detail-arrow.right { right: 8px; }
.detail-arrow .icon { width: 30px; height: 30px; }
.detail-arrow.left .icon { rotate: 180deg; }
.detail-arrow.pressed { translate: 0 2px; }
.detail-role { -unity-font: resource("Fonts/BeVietnamPro-Bold"); font-size: 15px; color: var(--amber-light); margin: 8px 4px 0 4px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.detail-counters { flex-shrink: 0; margin-bottom: 4px; }
.counter-row { flex-direction: row; align-items: center; margin-top: 6px; }
.counter-label { width: 92px; -unity-font: resource("Fonts/BeVietnamPro-Bold"); font-size: 13px; color: var(--n300); }
.counter-chip { flex-direction: row; align-items: center; height: 36px; padding: 0 12px 0 8px; margin-right: 6px; border-radius: 18px; background-color: var(--n800); flex-shrink: 1; }
.counter-chip .icon { width: 20px; height: 20px; margin-right: 6px; }
.counter-row.strong .counter-chip .icon { --icon-color: #8fd694; }
.counter-row.weak .counter-chip .icon { --icon-color: #e5533c; }
.counter-name { -unity-font: resource("Fonts/BeVietnamPro-SemiBold"); font-size: 13px; color: var(--n100); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.detail-right { flex-grow: 1; flex-shrink: 1; }
.detail-tabs { flex-shrink: 0; }
.detail-scroll { flex-grow: 1; }
.detail-note { -unity-font: resource("Fonts/BeVietnamPro-Medium"); font-size: 14px; color: var(--n300); white-space: normal; margin: 4px 0 10px 0; }

/* numbers as bars against the roster's best */
.stat-row { margin-bottom: 9px; }
.stat-head { flex-direction: row; align-items: center; }
.stat-name { flex-grow: 1; -unity-font: resource("Fonts/BeVietnamPro-SemiBold"); font-size: 15px; color: var(--n200); }
.stat-value { -unity-font: resource("Fonts/BarlowCondensed-Bold"); font-size: 24px; color: var(--n100); }
.stat-gain { -unity-font: resource("Fonts/BarlowCondensed-SemiBold"); font-size: 18px; color: #7fc4ff; margin-left: 8px; }
.stat-next { flex-direction: row; align-items: center; margin-left: 8px; }
.stat-next .icon { width: 16px; height: 16px; margin-right: 2px; --icon-color: #8fd694; }
.stat-next-text { -unity-font: resource("Fonts/BarlowCondensed-SemiBold"); font-size: 18px; color: var(--mint); }
.stat-bar { height: 12px; margin-top: 2px; background-color: var(--n950); border-radius: 6px; overflow: hidden; }
.stat-bar-next, .stat-bar-boost, .stat-bar-base { position: absolute; left: 0; top: 0; bottom: 0; border-radius: 6px; }
.stat-bar-next { background-color: rgba(143, 214, 148, 0.5); }
.stat-bar-boost { background-color: #4a9cff; }
.stat-bar-base { background-color: var(--n200); }
.stat-facts { flex-direction: row; flex-wrap: wrap; margin-top: 4px; }
.stat-fact {
    flex-direction: row; align-items: center; min-height: 38px; padding: 6px 14px 6px 10px; margin: 0 8px 8px 0;
    background-color: var(--n800); border-radius: 19px; flex-shrink: 1;
}
.stat-fact .icon { width: 20px; height: 20px; margin-right: 8px; --icon-color: #f2a33a; }
.stat-fact-text { -unity-font: resource("Fonts/BeVietnamPro-SemiBold"); font-size: 13px; color: var(--n200); white-space: normal; flex-shrink: 1; }

.weapon-row { flex-direction: row; align-items: center; padding: 12px 14px; margin-bottom: 8px; background-color: var(--n800); border-radius: 12px; }
.weapon-row > .icon { width: 34px; height: 34px; margin-right: 14px; --icon-color: #f5b55e; }
.weapon-text { flex-grow: 1; flex-shrink: 1; }
.weapon-name { -unity-font: resource("Fonts/BeVietnamPro-Bold"); font-size: 16px; color: var(--n100); }
.weapon-line { -unity-font: resource("Fonts/BeVietnamPro-SemiBold"); font-size: 13px; color: var(--n300); white-space: normal; margin-top: 2px; }
.weapon-line.ammo { color: var(--amber-light); }
.detail-gear { flex-direction: row; flex-wrap: wrap; }
.detail-gear .gear-slot2 { width: 114px; }

.detail-dock { justify-content: space-between; }
.full-page .wide.deck-toggle { width: 300px; height: 84px; margin-top: 0; justify-content: center; }
.full-page .wide.deck-toggle .wide-title { font-size: 18px; }
.wide.deck-toggle.chosen { background-color: var(--ally); border-bottom-color: var(--ally-dark); }
.detail-upgrade-box { flex-direction: row; align-items: center; flex-grow: 1; justify-content: flex-end; }
.detail-print-row { flex-direction: row; align-items: center; width: 270px; margin-right: 16px; }
.detail-print-row > .icon { width: 28px; height: 28px; --icon-color: #7fc4ff; }
.detail-print-track { flex-grow: 1; height: 16px; margin: 0 10px; background-color: var(--n950); border-radius: 8px; overflow: hidden; }
.detail-print-fill { height: 100%; width: 0; background-color: #4a9cff; border-radius: 8px; }
.detail-prints { -unity-font: resource("Fonts/BarlowCondensed-Bold"); font-size: 20px; color: var(--n100); min-width: 52px; }
.upgrade-big {
    flex-direction: row; align-items: center; justify-content: center; height: 88px; min-width: 360px; padding: 0 22px;
    background-color: var(--n700); border-radius: 14px; border-bottom-width: 5px; border-bottom-color: var(--n950);
}
.upgrade-big > .icon { width: 30px; height: 30px; margin-right: 10px; }
.upgrade-big-text { -unity-font: resource("Fonts/BeVietnamPro-Bold"); font-size: 19px; color: var(--n100); }
.upgrade-big.ready { background-color: var(--ally); border-bottom-color: var(--ally-dark); }
.upgrade-big.maxed { background-color: var(--n800); }
.upgrade-big.maxed .upgrade-big-text { color: var(--amber); }
.upgrade-big.pressed { translate: 0 3px; border-bottom-width: 2px; }

/* ================================================================ Shop tab: rail on the left */
.shop-page { flex-direction: row; }
.shop-rail { width: 176px; padding: 10px 0 10px 16px; }
.rail-button {
    flex-direction: row; align-items: center; height: 74px; margin-bottom: 6px; padding: 0 10px;
    background-color: var(--n800); border-radius: 12px; border-left-width: 4px; border-left-color: var(--n800);
}
.rail-button > .icon { width: 28px; height: 28px; margin-right: 8px; }
.rail-label { -unity-font: resource("Fonts/BeVietnamPro-Bold"); font-size: 14px; color: var(--n200); flex-shrink: 1; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.rail-button.chosen { background-color: var(--n700); border-left-color: var(--amber); }
.rail-button.chosen > .icon { --icon-color: #f2a33a; }
.rail-button.chosen .rail-label { color: var(--amber); }
.rail-button.pressed { translate: 0 2px; }
.shop-main { flex-grow: 1; flex-shrink: 1; padding: 10px 16px 0 14px; }
.shop-main > .menu-note { margin-top: 0; }
.shop-scroll { flex-grow: 1; }
.shop-page .shop-card { width: 170px; height: 214px; margin: 0 12px 12px 0; border-radius: 12px; }
.shop-page .unit-art, .shop-page .skin-swatch { height: 96px; }
.shop-page .unit-art .icon { width: 54px; height: 54px; }
.shop-page .shop-name { font-size: 15px; height: 42px; margin-top: 6px; }
.shop-page .shop-sub { font-size: 12px; }
.shop-page .price-tag { bottom: 12px; }
.shop-page .price-tag .icon { width: 20px; height: 20px; }
.shop-page .price-value { font-size: 21px; }
.shop-page .price-status { font-size: 13px; }
.item-owned { color: var(--mint); }
.shop-page .coin-card { justify-content: center; }
.shop-page .coin-card > .icon { width: 64px; height: 64px; margin: 0 0 8px 0; }
.shop-page .coin-card .shop-name { font-size: 26px; height: 34px; -unity-font: resource("Fonts/BarlowCondensed-Bold"); }
.shop-page .deal-card { width: 280px; height: 250px; }
.deal-art { width: 100%; height: 120px; align-items: center; justify-content: center; background-color: var(--n700); }
.deal-art .icon { width: 68px; height: 68px; }
.deal-card.free .deal-art { background-color: var(--ally-dark); }
.deal-card.ad .deal-art { background-color: #35566b; }
.deal-card.gold .deal-art { background-color: #5a3a12; }
.deal-card.gold .deal-art .icon { --icon-color: #f2c14e; }
.deal-status {
    position: absolute; left: 10px; right: 10px; bottom: 12px;
    -unity-font: resource("Fonts/BeVietnamPro-Bold"); font-size: 14px; color: var(--amber-light);
    -unity-text-align: middle-center; white-space: normal;
}
.shop-page .crate-tile { width: 48.5%; margin: 0 1.5% 12px 0; padding: 14px; border-radius: 14px; border-left-width: 6px; }
.crate-texts { flex-grow: 1; flex-shrink: 1; }
.shop-page .crate-top > .icon { width: 44px; height: 44px; margin-right: 14px; }
.shop-page .crate-name { font-size: 18px; }
.shop-page .crate-count { font-size: 13px; }
.crate-odds {
    width: 56px; height: 56px; border-radius: 28px; align-items: center; justify-content: center;
    background-color: var(--n700); border-bottom-width: 3px; border-bottom-color: var(--n950);
}
.shop-page .crate-top .crate-odds .icon { width: 26px; height: 26px; margin-right: 0; }
.crate-odds.pressed { translate: 0 2px; }
.shop-page .crate-buttons { margin-top: 12px; }
.shop-page .crate-button { height: 58px; padding: 0 16px; margin: 0 8px 0 0; border-radius: 10px; border-bottom-width: 3px; flex-grow: 1; justify-content: center; }
.shop-page .crate-button .icon { width: 22px; height: 22px; }
.shop-page .crate-button-text { font-size: 17px; }
.shop-dock { flex-direction: row; justify-content: flex-end; flex-shrink: 0; padding: 8px 0 12px 0; }
.tab-page .wide.shop-buy { width: 400px; height: 84px; margin-top: 0; }
.tab-page .wide.shop-buy .wide-title { font-size: 24px; letter-spacing: 2px; }

/* crate results with the pieces as tiles */
.loot-gear { flex-direction: row; flex-wrap: wrap; justify-content: center; margin-bottom: 8px; }
.loot-gear-cell { width: 120px; align-items: center; margin: 0 6px 10px 6px; }
.loot-gear-name { -unity-font: resource("Fonts/BeVietnamPro-Bold"); font-size: 13px; margin-top: 4px; width: 120px; height: 36px; -unity-text-align: upper-center; white-space: normal; overflow: hidden; }
.loot-gear-stat { -unity-font: resource("Fonts/BeVietnamPro-SemiBold"); font-size: 12px; color: var(--n300); }
.loot-card { width: 680px; max-height: 94%; }
.loot-card .loot-scroll { max-height: 460px; }
.loot-card .wide { height: 72px; justify-content: center; }

/* ================================================================ Events tab */
.events-columns { flex-direction: row; flex-grow: 1; flex-shrink: 1; padding: 6px 16px 0 16px; }
.events-left { width: 46%; margin-right: 16px; }
.events-right { flex-grow: 1; flex-shrink: 1; }
.event-daily {
    flex-direction: row; align-items: center; min-height: 88px; padding: 12px 12px 12px 16px; margin-bottom: 10px;
    background-color: var(--n800); border-radius: 14px;
}
.event-daily-info { flex-grow: 1; flex-shrink: 1; margin-right: 12px; }
.event-daily-text { -unity-font: resource("Fonts/BeVietnamPro-SemiBold"); font-size: 15px; color: var(--n100); white-space: normal; }
.event-daily-track { height: 10px; margin-top: 8px; background-color: var(--n950); border-radius: 5px; overflow: hidden; }
.event-daily-fill { height: 100%; width: 0; background-color: var(--amber); border-radius: 5px; }
.event-daily-progress { -unity-font: resource("Fonts/BarlowCondensed-SemiBold"); font-size: 16px; color: var(--n300); margin-top: 2px; }
.event-claim {
    flex-direction: row; align-items: center; justify-content: center; width: 124px; height: 64px;
    background-color: var(--n700); border-radius: 12px; border-bottom-width: 4px; border-bottom-color: var(--n950);
}
.event-claim .icon { width: 22px; height: 22px; }
.event-claim-text { -unity-font: resource("Fonts/BarlowCondensed-Bold"); font-size: 22px; color: var(--n100); margin-left: 6px; }
.event-claim.ready { background-color: var(--amber); border-bottom-color: var(--amber-deep); }
.event-claim.ready .icon { --icon-color: #1b1206; }
.event-claim.ready .event-claim-text { color: var(--amber-ink); }
.event-claim.claimed { background-color: var(--ally-dark); }
.event-claim.pressed { translate: 0 2px; border-bottom-width: 2px; }
.event-card {
    flex-direction: row; align-items: center; min-height: 116px; padding: 12px 14px 12px 16px; margin-bottom: 10px;
    background-color: var(--n800); border-radius: 14px; border-left-width: 6px; border-left-color: var(--amber-deep);
}
.event-card > .icon { width: 44px; height: 44px; margin-right: 14px; --icon-color: #f2a33a; }
.event-card-text { flex-grow: 1; flex-shrink: 1; }
.event-card-title { -unity-font: resource("Fonts/BeVietnamPro-Bold"); font-size: 19px; color: var(--n100); }
.event-card-sub { -unity-font: resource("Fonts/BeVietnamPro-Medium"); font-size: 13px; color: var(--n300); white-space: normal; }
.event-card-extra { -unity-font: resource("Fonts/BeVietnamPro-Bold"); font-size: 13px; color: var(--amber-light); margin-top: 2px; }
.event-play {
    flex-direction: row; align-items: center; justify-content: center; width: 144px; height: 78px; margin-left: 12px;
    background-color: var(--amber); border-radius: 14px; border-bottom-width: 5px; border-bottom-color: var(--amber-deep);
}
.event-play .icon { width: 26px; height: 26px; margin-right: 8px; --icon-color: #1b1206; }
.event-play-text { -unity-font: resource("Fonts/BeVietnamPro-Bold"); font-size: 20px; color: var(--amber-ink); }
.event-play.pressed { translate: 0 3px; border-bottom-width: 2px; }

/* ================================================================ Campaign tab and settings page */
.campaign-page .campaign-list { padding: 0 8px 0 16px; }
.campaign-page .mission-row { height: 64px; border-radius: 10px; }
.campaign-page .mission-name { font-size: 16px; }
.campaign-page .campaign-detail { margin: 10px 16px 10px 4px; }
.tab-page .wide.campaign-start { height: 84px; margin: 12px 14px 0 14px; justify-content: center; }
.tab-page .wide.campaign-start .wide-title { font-size: 26px; letter-spacing: 4px; }
.settings-page { padding-top: 6px; }
.settings-page .menu-body { padding: 0 90px; }
.settings-page .setting-row { height: 60px; border-radius: 10px; }
.settings-page .option { min-width: 84px; height: 46px; border-radius: 8px; }
.settings-page .option-label { font-size: 14px; }
.settings-page .setting-row .icon-button { width: 56px; height: 48px; border-radius: 8px; }
