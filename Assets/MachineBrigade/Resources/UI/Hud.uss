/* Machine Brigade HUD: "command console" design system (Stitch project "Machine Brigade UI
   Redesign"). Every panel and button is a solid, opaque surface; depth comes from solid layers
   (panel body, header strip, inner well) and from buttons with a darker bottom edge that press
   down. Amber marks what is selected or primary; green is ours, red is theirs. Headings,
   labels and numbers use Barlow Condensed; body text uses Inter. Authored for a 1280 x 720
   reference resolution (the panel scales with screen height). */

:root {
    --n950: #0c0f12;
    --n900: #111418;
    --n850: #161a20;
    --n800: #1b2126;
    --n750: #232b31;
    --n700: #2e3840;
    --n600: #3a4650;
    --n500: #52606d;
    --n400: #7e8f9c;
    --n300: #a9b4ba;
    --n200: #cfd7dc;
    --n100: #edeff0;
    --amber: #f2a33a;
    --amber-light: #f5b55e;
    --amber-dark: #d98620;
    --amber-deep: #b86814;
    --amber-ink: #1b1206;
    --ally: #6e8b3d;
    --ally-dark: #4a5f27;
    --mint: #8fd694;
    --danger: #e5533c;
    --danger-dark: #992211;
}

.hud {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    -unity-font: resource("Fonts/Inter-Regular");
    color: var(--n100);
    font-size: 13px;
}

.safe { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }

/* Icons take their colour from --icon-color (see IconElement); selected states turn them dark. */
.icon { --icon-color: #edeff0; }

/* ================================================================ shared building blocks */
.panel-header {
    flex-direction: row; align-items: center; justify-content: space-between;
    height: 28px; padding-left: 10px; padding-right: 10px;
    background-color: var(--n700);
}
.caps {
    -unity-font: resource("Fonts/BarlowCondensed-SemiBold");
    font-size: 13px; letter-spacing: 2px;
    color: var(--n300);
}

/* A solid, pressable button: face plus a darker bottom edge that flattens when pressed. */
.tool, .cmd, .wide, .segment, .toggle, .setting-row, .icon-button, .card, .point-chip, .option {
    border-bottom-width: 3px;
}
.tool:active, .cmd:active, .wide:active, .segment:active, .toggle:active, .icon-button:active, .card:active, .option:active {
    border-bottom-width: 1px;
    translate: 0 2px;
}

/* ================================================================ top bar */
.topbar {
    flex-direction: row;
    align-items: center;
    height: 54px;
    padding-left: 14px;
    padding-right: 10px;
    background-color: var(--n900);
    border-bottom-width: 2px;
    border-bottom-color: var(--n950);
}

.brand { flex-direction: row; align-items: center; width: 210px; }
.brand .icon { width: 28px; height: 28px; margin-right: 10px; --icon-color: #f2a33a; }
.brand-top { -unity-font: resource("Fonts/BarlowCondensed-Bold"); font-size: 20px; letter-spacing: 3px; color: var(--n100); }
.brand-bottom { -unity-font: resource("Fonts/BarlowCondensed-SemiBold"); font-size: 11px; letter-spacing: 4px; color: var(--amber); margin-top: -4px; }

.stats { flex-grow: 1; flex-direction: row; justify-content: center; align-items: center; }
.stat {
    flex-direction: row; align-items: center;
    height: 40px; padding-left: 12px; padding-right: 14px; margin-left: 4px; margin-right: 4px;
    background-color: var(--n800);
    border-radius: 6px;
}
.stat .icon { width: 20px; height: 20px; margin-right: 8px; }
.stat-number { -unity-font: resource("Fonts/BarlowCondensed-Bold"); font-size: 26px; -unity-text-align: middle-left; color: var(--n100); }
.stat-label { -unity-font: resource("Fonts/BarlowCondensed-SemiBold"); font-size: 10px; letter-spacing: 2px; color: var(--n400); margin-top: -6px; }
.stat-divider { width: 0; }

.topbar-right { flex-direction: row; align-items: center; width: 210px; justify-content: flex-end; }
.fps {
    -unity-font: resource("Fonts/BarlowCondensed-SemiBold"); font-size: 13px; color: var(--n300);
    margin-right: 10px; padding-left: 8px; padding-right: 8px;
    background-color: var(--n800); border-radius: 4px;
}

.icon-button {
    width: 42px; height: 40px;
    align-items: center; justify-content: center;
    background-color: var(--n700);
    border-radius: 6px;
    border-bottom-color: var(--n950);
}
.icon-button .icon { width: 20px; height: 20px; }

/* ================================================================ conquest score */
.score { flex-direction: row; align-items: center; }
.score-side {
    flex-direction: row; align-items: center; width: 200px; height: 40px;
    padding-left: 10px; padding-right: 10px;
    background-color: var(--n800); border-radius: 6px;
}
.score-side.theirs { justify-content: flex-end; }
.score-number { -unity-font: resource("Fonts/BarlowCondensed-Bold"); font-size: 30px; margin-left: 6px; margin-right: 6px; }
.score-side.ours .score-number { color: var(--mint); }
.score-side.theirs .score-number { color: var(--danger); }
.score-column { flex-grow: 1; }
.score-side .stat-label { margin-top: 0; }
.score-side.theirs .stat-label { -unity-text-align: middle-right; }
.score-track { height: 8px; margin-top: 3px; background-color: var(--n950); border-radius: 2px; }
.score-fill { height: 100%; width: 100%; border-radius: 2px; background-color: var(--ally); }
.score-side.theirs .score-track { flex-direction: row-reverse; }
.score-side.theirs .score-fill { background-color: var(--danger); }

.chips { flex-direction: row; margin-left: 12px; margin-right: 12px; }
.point-chip {
    width: 42px; height: 42px;
    margin-left: 5px; margin-right: 5px;
    align-items: center; justify-content: center;
    border-radius: 21px;
    background-color: var(--n600);
    border-bottom-color: var(--n800);
}
.point-letter { -unity-font: resource("Fonts/BarlowCondensed-Bold"); font-size: 20px; color: var(--n100); }
.point-chip.ours { background-color: var(--ally); border-bottom-color: var(--ally-dark); }
.point-chip.theirs { background-color: var(--danger); border-bottom-color: var(--danger-dark); }
.point-chip.contested { background-color: var(--amber); border-bottom-color: var(--amber-deep); }
.point-chip.contested .point-letter { color: var(--amber-ink); }
.point-chip.focus {
    border-left-width: 3px; border-right-width: 3px; border-top-width: 3px; border-bottom-width: 3px;
    border-color: var(--amber-light);
}

/* ================================================================ mission banner and hint */
.mission { align-items: center; }
.mission-strip {
    padding: 8px 28px 10px 20px;
    background-color: var(--n900);
    border-left-width: 8px; border-left-color: var(--amber);
    border-radius: 6px;
    border-bottom-width: 3px; border-bottom-color: var(--n950);
}
.kicker { -unity-font: resource("Fonts/BarlowCondensed-SemiBold"); font-size: 13px; letter-spacing: 4px; color: var(--amber); }
.mission-title { -unity-font: resource("Fonts/BarlowCondensed-Bold"); font-size: 40px; letter-spacing: 3px; color: var(--n100); margin-top: -4px; }
.mission-sub { -unity-font: resource("Fonts/BarlowCondensed-SemiBold"); font-size: 13px; letter-spacing: 3px; color: var(--n300); margin-top: -4px; }

.hint-bar { position: absolute; bottom: 132px; left: 0; right: 0; align-items: center; }
.hint {
    -unity-text-align: middle-center;
    -unity-font: resource("Fonts/BarlowCondensed-SemiBold");
    font-size: 13px; letter-spacing: 1px;
    color: var(--n200);
    padding: 4px 14px;
    background-color: var(--n900);
    border-radius: 12px;
}

/* ================================================================ tool column */
.left-column { position: absolute; left: 12px; top: 64px; }
.minimap {
    width: 184px; height: 184px;
    overflow: hidden;
    background-color: var(--n850);
    border-radius: 8px;
    border-bottom-width: 3px; border-bottom-color: var(--n950);
}
.tools { flex-direction: row; flex-wrap: wrap; width: 196px; margin-top: 8px; }
.tool {
    width: 43px; height: 52px;
    margin-right: 4px; margin-bottom: 4px;
    align-items: center; justify-content: center;
    background-color: var(--n700);
    border-radius: 6px;
    border-bottom-color: var(--n950);
}
.tool .icon { width: 20px; height: 20px; }
.tool-label { -unity-font: resource("Fonts/BarlowCondensed-SemiBold"); font-size: 11px; letter-spacing: 1px; margin-top: 2px; color: var(--n200); }
.tool.on { background-color: var(--amber); border-bottom-color: var(--amber-deep); }
.tool.on .tool-label { color: var(--amber-ink); }
.tool.on .icon { --icon-color: #1b1206; }

/* ================================================================ commander panel */
.commander {
    position: absolute; right: 12px; bottom: 222px;
    width: 280px;
    background-color: var(--n800);
    border-radius: 8px;
    border-bottom-width: 3px; border-bottom-color: var(--n950);
    overflow: hidden;
}
.commander-body { padding: 8px; }
.commander-row { flex-direction: row; margin-bottom: 6px; }
.commander-row.last-row { margin-bottom: 0; }
.toggle {
    flex-grow: 1; flex-basis: 0; height: 40px; margin-right: 6px;
    flex-direction: row; align-items: center; justify-content: center;
    background-color: var(--n700);
    border-radius: 6px;
    border-bottom-color: var(--n950);
}
.toggle.last-toggle { margin-right: 0; }
.toggle .icon { width: 18px; height: 18px; margin-right: 6px; }
.toggle-label { -unity-font: resource("Fonts/BarlowCondensed-Bold"); font-size: 14px; letter-spacing: 1px; color: var(--n200); }
.toggle.on { background-color: var(--amber); border-bottom-color: var(--amber-deep); }
.toggle.on .toggle-label { color: var(--amber-ink); }
.toggle.on .icon { --icon-color: #1b1206; }
.toggle.switch.on { background-color: var(--ally); border-bottom-color: var(--ally-dark); }
.toggle.switch.on .toggle-label { color: var(--n100); }
.toggle.switch.on .icon { --icon-color: #edeff0; }

/* ================================================================ selection (command) panel */
.command {
    position: absolute; right: 12px; bottom: 12px;
    width: 280px;
    background-color: var(--n800);
    border-radius: 8px;
    border-bottom-width: 3px; border-bottom-color: var(--n950);
    overflow: hidden;
}
.command-header {
    flex-direction: row; align-items: center; justify-content: space-between;
    height: 28px; padding-left: 10px; padding-right: 10px;
    background-color: var(--n700);
}
.command-body { padding: 8px; }
.details { flex-direction: row; align-items: center; margin-bottom: 8px; }
.portrait {
    width: 48px; height: 48px;
    margin-right: 10px;
    align-items: center; justify-content: center;
    background-color: var(--n700);
    border-radius: 6px;
}
.portrait .icon { width: 28px; height: 28px; }
.details-text { flex-grow: 1; }
.unit-name { -unity-font: resource("Fonts/BarlowCondensed-Bold"); font-size: 20px; letter-spacing: 1px; color: var(--n100); }
.unit-name.empty { font-size: 16px; color: var(--n400); }
.hp-track { height: 8px; margin-top: 4px; background-color: var(--n950); border-radius: 2px; }
.hp-fill { height: 100%; width: 100%; background-color: var(--mint); border-radius: 2px; }
.hp-fill.hurt { background-color: var(--amber); }
.hp-fill.critical { background-color: var(--danger); }
.hp-text { -unity-font: resource("Fonts/BarlowCondensed-SemiBold"); font-size: 13px; color: var(--n300); margin-top: 3px; }
.hp-text.hint-text { -unity-font: resource("Fonts/Inter-Regular"); font-size: 12px; }
.counter-text { -unity-font: resource("Fonts/Inter-Regular"); font-size: 11px; color: var(--amber-light); margin-top: 3px; white-space: normal; }

.buttons { flex-direction: row; }
.cmd {
    flex-grow: 1; flex-basis: 0;
    height: 52px;
    margin-right: 6px;
    align-items: center; justify-content: center;
    background-color: var(--n700);
    border-radius: 6px;
    border-bottom-color: var(--n950);
}
.cmd.last { margin-right: 0; }
.cmd .icon { width: 22px; height: 22px; }
.cmd-label { -unity-font: resource("Fonts/BarlowCondensed-Bold"); font-size: 13px; letter-spacing: 1px; margin-top: 2px; color: var(--n200); }
.cmd.armed { background-color: var(--amber); border-bottom-color: var(--amber-deep); }
.cmd.armed .cmd-label { color: var(--amber-ink); }
.cmd.armed .icon { --icon-color: #1b1206; }
.cmd.disabled { background-color: var(--n800); }
.cmd.disabled .cmd-label { color: var(--n500); }
.cmd.disabled .icon { --icon-color: #52606d; }

/* ================================================================ deck tray */
.deck {
    position: absolute; bottom: 10px; left: 206px; right: 302px;
    flex-direction: row; align-items: flex-end; justify-content: center;
}
.cp-meter {
    width: 96px; height: 106px; margin-right: 6px;
    background-color: var(--n800);
    border-radius: 8px;
    border-bottom-width: 3px; border-bottom-color: var(--n950);
    overflow: hidden;
}
.cp-top { flex-direction: row; align-items: center; justify-content: center; margin-top: 8px; }
.cp-top .icon { width: 20px; height: 20px; margin-right: 4px; --icon-color: #f2a33a; }
.cp-value { -unity-font: resource("Fonts/BarlowCondensed-Bold"); font-size: 38px; color: var(--amber); margin-top: -4px; margin-bottom: -4px; }
.cp-track { height: 8px; margin: 4px 8px 0 8px; background-color: var(--n950); border-radius: 2px; }
.cp-fill { height: 100%; width: 0; background-color: var(--amber); border-radius: 2px; }
.cp-army {
    -unity-font: resource("Fonts/BarlowCondensed-SemiBold"); font-size: 12px; letter-spacing: 1px; color: var(--n300);
    -unity-text-align: middle-center; margin-top: 6px; padding-top: 3px; padding-bottom: 3px;
    background-color: var(--n850);
}
.cards {
    flex-direction: row; align-items: flex-end;
    padding: 5px 3px;
    background-color: var(--n900);
    border-radius: 8px;
    border-bottom-width: 3px; border-bottom-color: var(--n950);
}
.card-gap { width: 8px; flex-shrink: 1; }
.card {
    width: 72px; height: 96px; min-width: 52px; flex-shrink: 1;
    margin-left: 3px; margin-right: 3px;
    align-items: center;
    overflow: hidden;
    background-color: var(--n700);
    border-radius: 6px;
    border-bottom-color: var(--n950);
}
.card .icon { width: 32px; height: 32px; margin-top: 22px; }
.card-name {
    position: absolute; left: 0; right: 0; bottom: 0;
    height: 30px;
    -unity-font: resource("Fonts/BarlowCondensed-SemiBold"); font-size: 12px;
    -unity-text-align: middle-center; white-space: normal;
    padding-left: 2px; padding-right: 2px;
    color: var(--n100);
    background-color: var(--n850);
}
.card-cost {
    position: absolute; top: 0; right: 0;
    min-width: 22px; height: 20px;
    padding: 0 5px;
    align-items: center; justify-content: center;
    background-color: var(--amber);
    border-bottom-left-radius: 6px;
}
.card-cost-text { -unity-font: resource("Fonts/BarlowCondensed-Bold"); font-size: 15px; color: var(--amber-ink); }
.card-cooldown { position: absolute; left: 0; right: 0; bottom: 0; height: 0; background-color: rgb(12, 15, 18); opacity: 0.78; }
.card.support { border-top-width: 5px; border-top-color: var(--danger); }
/* Disabled states stay solid and readable: dark card, grey icon, badge says why. */
.card.unaffordable .icon, .card.locked .icon { --icon-color: #52606d; }
.card.unaffordable .card-name, .card.locked .card-name { color: var(--n400); }
.card.unaffordable .card-cost { background-color: var(--n950); }
.card.unaffordable .card-cost-text { color: var(--danger); }
.card.locked { background-color: var(--n800); }
.card.locked .card-cost { background-color: var(--n600); }
.card.locked .card-cost-text { color: var(--n200); }
.card.selected { background-color: var(--danger); border-bottom-color: var(--danger-dark); translate: 0 -8px; }
.card.selected .card-name { background-color: var(--danger-dark); }

/* ================================================================ targeting prompt, toast */
.targeting {
    position: absolute; bottom: 128px; left: 0; right: 0;
    flex-direction: row; justify-content: center; align-items: center;
}
.targeting-text {
    height: 42px; padding: 0 16px; margin-right: 8px;
    -unity-text-align: middle-left;
    -unity-font: resource("Fonts/BarlowCondensed-Bold"); font-size: 17px; letter-spacing: 1px;
    color: var(--n100);
    background-color: var(--danger);
    border-radius: 6px;
    border-bottom-width: 3px; border-bottom-color: var(--danger-dark);
}

.toast {
    position: absolute; top: 64px; left: 0; right: 0;
    align-items: center;
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.2s;
}
.toast.visible { opacity: 1; }
.toast-box {
    padding: 8px 20px 9px 20px;
    background-color: var(--amber);
    border-radius: 18px;
    border-bottom-width: 3px; border-bottom-color: var(--amber-deep);
}
.toast-text { -unity-font: resource("Fonts/BarlowCondensed-Bold"); font-size: 17px; letter-spacing: 1px; color: var(--amber-ink); }
.toast-box.error { background-color: var(--danger); border-bottom-color: var(--danger-dark); }
.toast-box.error .toast-text { color: var(--n100); }

.banner {
    position: absolute; top: 96px; left: 0; right: 0;
    align-items: center;
    opacity: 0;
    transition-property: opacity; transition-duration: 0.4s;
}
.banner.visible { opacity: 1; }

.selection-box {
    position: absolute;
    background-color: rgba(242, 163, 58, 0.14);
    border-width: 2px;
    border-color: var(--amber);
    display: none;
}

/* ================================================================ wide buttons (menus, overlays) */
.wide {
    flex-direction: row; align-items: center;
    height: 50px;
    padding-left: 14px; padding-right: 16px;
    margin-top: 8px;
    background-color: var(--n700);
    border-radius: 6px;
    border-bottom-color: var(--n950);
}
.wide .icon { width: 22px; height: 22px; margin-right: 12px; }
.wide-title { -unity-font: resource("Fonts/BarlowCondensed-Bold"); font-size: 19px; letter-spacing: 2px; color: var(--n100); }
.wide-text { flex-shrink: 1; }
.wide-sub { font-size: 11px; color: var(--n300); margin-top: 0; white-space: normal; }
.wide.primary { background-color: var(--amber); border-bottom-color: var(--amber-deep); border-bottom-width: 5px; }
.wide.primary .wide-title { color: var(--amber-ink); }
.wide.primary .icon { --icon-color: #1b1206; }
.wide.big { height: 64px; justify-content: center; }
.wide.big .wide-title { font-size: 28px; letter-spacing: 5px; }
.wide.small-wide { height: 42px; margin-top: 0; }
.wide.danger { background-color: var(--danger); border-bottom-color: var(--danger-dark); }

/* ================================================================ overlays: pause and result */
.overlay {
    position: absolute; left: 0; top: 0; right: 0; bottom: 0;
    align-items: center; justify-content: center;
    background-color: rgba(8, 10, 12, 0.72);
}
.result-card {
    width: 400px;
    align-items: stretch;
    background-color: var(--n800);
    border-radius: 10px;
    border-bottom-width: 4px; border-bottom-color: var(--n950);
    overflow: hidden;
    padding-bottom: 18px;
}
.result-head { align-items: center; padding: 14px 20px 10px 20px; background-color: var(--n700); }
.result-head.victory { background-color: var(--ally); }
.result-head.defeat { background-color: var(--danger); }
.result-head .icon { width: 40px; height: 40px; }
.result-title {
    -unity-font: resource("Fonts/BarlowCondensed-Bold"); font-size: 46px; letter-spacing: 8px;
    -unity-text-align: middle-center; margin-top: 2px; color: var(--n100);
}
.result-sub {
    -unity-font: resource("Fonts/BarlowCondensed-SemiBold");
    -unity-text-align: middle-center; font-size: 14px; letter-spacing: 4px; color: var(--n300);
    margin-top: 10px; margin-bottom: 4px;
}
.result-row {
    flex-direction: row; justify-content: space-between;
    margin-left: 18px; margin-right: 18px; margin-top: 6px;
    padding: 8px 12px;
    background-color: var(--n750); border-radius: 5px;
}
.result-label { -unity-font: resource("Fonts/BarlowCondensed-SemiBold"); color: var(--n300); font-size: 15px; letter-spacing: 1px; }
.result-value { -unity-font: resource("Fonts/BarlowCondensed-Bold"); font-size: 17px; color: var(--n100); }
.result-buttons { margin: 12px 18px 0 18px; }

/* ================================================================ main menu */
.menu { position: absolute; left: 0; top: 0; bottom: 0; right: 0; }
.menu-panel {
    position: absolute; left: 0; top: 0; bottom: 0;
    width: 470px;
    background-color: var(--n850);
    border-right-width: 3px; border-right-color: var(--n950);
}
.menu-panel.wide-panel { width: 700px; }
.menu-body { flex-grow: 1; flex-shrink: 1; padding: 0 22px; overflow: hidden; }
.menu-brand {
    flex-direction: row; align-items: center;
    height: 64px; padding-left: 22px; flex-shrink: 0;
    background-color: var(--n900);
    border-bottom-width: 2px; border-bottom-color: var(--n950);
}
.menu-brand .icon { width: 34px; height: 34px; margin-right: 12px; --icon-color: #f2a33a; }
.menu-brand-text { flex-direction: row; align-items: center; }
.menu-title { -unity-font: resource("Fonts/BarlowCondensed-Bold"); font-size: 30px; letter-spacing: 5px; color: var(--n100); margin-right: 8px; }
.menu-title.accent { color: var(--amber); }
.menu-tagline {
    -unity-font: resource("Fonts/BarlowCondensed-SemiBold");
    color: var(--n400); font-size: 14px; letter-spacing: 2px;
    margin-top: 10px;
}
.menu-caps {
    -unity-font: resource("Fonts/BarlowCondensed-Bold");
    font-size: 15px; letter-spacing: 3px; color: var(--n200);
    margin-top: 12px; margin-bottom: 6px;
}
.menu-modes { flex-direction: row; }
.mode-card {
    flex-grow: 1; flex-basis: 0; height: 68px; margin-right: 8px; margin-top: 0; padding-right: 8px;
    background-color: var(--n750);
    border-left-width: 6px; border-left-color: var(--n750);
}
.mode-card.last-card { margin-right: 0; }
.mode-card .wide-sub { font-size: 10px; }
.mode-card.chosen { background-color: var(--n700); border-left-color: var(--amber); }
.mode-card.chosen .wide-title { color: var(--amber); }
.mode-card.chosen .icon { --icon-color: #f2a33a; }

.maps { flex-direction: row; }
.map-card {
    flex-grow: 1; flex-basis: 0; height: 84px; margin-right: 6px;
    background-color: var(--n750);
    border-radius: 6px;
    border-width: 3px; border-color: var(--n750);
    border-bottom-color: var(--n950);
    overflow: hidden;
}
.map-card.last-card { margin-right: 0; }
.map-art { height: 44px; align-items: center; justify-content: center; background-color: var(--n700); }
.map-art .icon { width: 24px; height: 24px; }
.map-art.temperate { background-color: #4f6b3a; }
.map-art.desert { background-color: #9a7440; }
.map-art.snow { background-color: #7d93a3; }
.map-art.harbor { background-color: #35566b; }
.map-name { -unity-font: resource("Fonts/BarlowCondensed-Bold"); font-size: 15px; letter-spacing: 1px; margin: 2px 6px 0 6px; color: var(--n100); }
.map-sub { -unity-font: resource("Fonts/BarlowCondensed-SemiBold"); font-size: 11px; letter-spacing: 0; margin: -3px 6px 0 6px; color: var(--n400); }
.map-name, .map-sub { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.map-card.chosen { border-left-color: var(--amber); border-right-color: var(--amber); border-top-color: var(--amber); border-bottom-color: var(--amber); }
.map-card.chosen .map-name { color: var(--amber); }
.map-card.locked .map-art { background-color: var(--n700); }
.map-card.locked .map-art .icon { --icon-color: #52606d; }
.map-card.locked .map-name, .map-card.locked .map-sub { color: var(--n500); }

.segments { flex-direction: row; flex-wrap: wrap; }
.segment {
    flex-grow: 1; flex-basis: 0; height: 40px; margin-right: 5px; margin-bottom: 5px;
    flex-direction: row; align-items: center; justify-content: center;
    background-color: var(--n750);
    border-radius: 6px;
    border-bottom-color: var(--n950);
}
.segment.last-segment { margin-right: 0; }
.segments.grid .segment { flex-basis: 18%; }
.segment .icon { width: 16px; height: 16px; margin-right: 5px; }
.segment-label { -unity-font: resource("Fonts/BarlowCondensed-Bold"); font-size: 14px; letter-spacing: 1px; color: var(--n200); }
.segment.chosen { background-color: var(--amber); border-bottom-color: var(--amber-deep); }
.segment.chosen .segment-label { color: var(--amber-ink); }
.segment.chosen .icon { --icon-color: #1b1206; }

.menu-actions {
    flex-shrink: 0;
    padding: 10px 22px 14px 22px;
    background-color: var(--n900);
    border-top-width: 2px; border-top-color: var(--n950);
}
.menu-small { flex-direction: row; }
.menu-small .wide { flex-grow: 1; flex-basis: 0; margin-right: 8px; justify-content: center; }
.menu-small .wide.last-card { margin-right: 0; }

.deck-grid { flex-direction: row; flex-wrap: wrap; margin-bottom: 8px; }
.deck-card { margin-bottom: 8px; border-left-width: 3px; border-right-width: 3px; border-top-width: 3px; border-color: var(--n700); border-bottom-color: var(--n950); }
.deck-card.support { border-top-color: var(--danger); }
.deck-card.chosen { border-left-color: var(--amber); border-right-color: var(--amber); border-top-color: var(--amber); }
.deck-card.chosen .card-name { background-color: var(--amber); color: var(--amber-ink); }

.setting-row {
    flex-direction: row; align-items: center; height: 50px; padding-left: 14px; padding-right: 8px; margin-top: 7px;
    background-color: var(--n750);
    border-radius: 6px;
    border-bottom-color: var(--n950);
}
.setting-row > .icon { width: 20px; height: 20px; margin-right: 12px; }
.setting-label { flex-grow: 1; -unity-font: resource("Fonts/BarlowCondensed-Bold"); font-size: 17px; letter-spacing: 1px; color: var(--n100); }
.setting-value {
    -unity-font: resource("Fonts/BarlowCondensed-Bold"); font-size: 15px; color: var(--amber);
    min-width: 96px; height: 32px; padding: 0 8px;
    -unity-text-align: middle-center;
    background-color: var(--n900); border-radius: 5px;
}
.setting-row .icon-button { width: 36px; height: 34px; margin-left: 4px; margin-right: 4px; background-color: var(--n600); }

/* Settings list: rows with segmented choices, scrolling under the brand strip. */
.settings-scroll { flex-grow: 1; }
.settings-scroll > .unity-scroll-view__content-viewport > .unity-scroll-view__content-container { padding-bottom: 14px; }
.option-row { height: 54px; margin-top: 6px; }
.option-row .setting-label { font-size: 16px; }
.options { flex-direction: row; }
.option {
    min-width: 68px; height: 38px; margin-left: 5px; padding: 0 10px;
    align-items: center; justify-content: center;
    background-color: var(--n850);
    border-radius: 5px;
    border-bottom-color: var(--n950);
}
.option-label { -unity-font: resource("Fonts/BarlowCondensed-Bold"); font-size: 14px; letter-spacing: 1px; color: var(--n300); }
.option.chosen { background-color: var(--amber); border-bottom-color: var(--amber-deep); }
.option.chosen .option-label { color: var(--amber-ink); }
.custom-tag {
    -unity-font: resource("Fonts/BarlowCondensed-Bold"); font-size: 12px; letter-spacing: 1px;
    color: var(--amber-ink); background-color: var(--amber-light);
    padding: 2px 8px; margin-right: 10px; border-radius: 9px;
}

/* ================================================================ menu: profile, campaign banner, modes */
.menu-brand .brand-profile { flex-direction: row; align-items: center; margin-left: auto; margin-right: 14px; }
.rank-pill, .coin-pill {
    flex-direction: row; align-items: center; height: 34px; padding: 0 10px; margin-left: 8px;
    background-color: var(--n800); border-radius: 17px;
    border-bottom-width: 2px; border-bottom-color: var(--n950);
}
.rank-pill .icon, .coin-pill .icon { width: 18px; height: 18px; margin-right: 6px; --icon-color: #f2a33a; }
.rank-label { -unity-font: resource("Fonts/BarlowCondensed-Bold"); font-size: 13px; letter-spacing: 1px; color: var(--n100); }
.rank-track { width: 56px; height: 4px; margin-top: 1px; background-color: var(--n950); border-radius: 2px; }
.rank-fill { height: 100%; width: 0; background-color: var(--mint); border-radius: 2px; }
.coin-label { -unity-font: resource("Fonts/BarlowCondensed-Bold"); font-size: 17px; color: var(--amber); }

.campaign-banner {
    flex-direction: row; align-items: center; height: 74px; margin-top: 12px; padding: 0 14px;
    background-color: var(--amber-deep); border-radius: 8px;
    border-bottom-color: #7a4410; border-bottom-width: 4px;
}
.campaign-banner:active { border-bottom-width: 1px; translate: 0 3px; }
.campaign-banner > .icon { width: 34px; height: 34px; margin-right: 12px; --icon-color: #fff1dc; }
.campaign-banner-text { flex-grow: 1; }
.campaign-banner-title { -unity-font: resource("Fonts/BarlowCondensed-Bold"); font-size: 21px; letter-spacing: 3px; color: #fff4e2; }
.campaign-banner-sub { -unity-font: resource("Fonts/BarlowCondensed-SemiBold"); font-size: 13px; color: #ffd9a8; margin-top: -2px; }
.campaign-banner-next {
    -unity-font: resource("Fonts/BarlowCondensed-Bold"); font-size: 13px; color: var(--amber-ink);
    background-color: var(--amber-light); border-radius: 12px; padding: 3px 10px; max-width: 170px;
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}

.grid-modes { flex-wrap: wrap; }
.grid-modes .mode-card { flex-basis: 31%; flex-grow: 1; height: 58px; margin-right: 6px; margin-bottom: 6px; }
.grid-modes .mode-card .wide-title { font-size: 16px; letter-spacing: 1px; }
.grid-modes .mode-card .icon { width: 20px; height: 20px; margin-right: 8px; }
.maps { flex-wrap: wrap; }
.maps .map-card { flex-basis: 23%; margin-bottom: 6px; }

.menu-note {
    -unity-font: resource("Fonts/Inter-Regular"); font-size: 12px; color: var(--n300); white-space: normal;
    margin-top: 2px; margin-bottom: 8px;
}
.menu-note.warn { color: var(--amber-light); }
.menu-small .wide { padding-left: 8px; padding-right: 8px; }

/* deck locks */
.card-lock {
    position: absolute; left: 0; top: 0; width: 26px; height: 22px; align-items: center; justify-content: center;
    background-color: var(--n950); border-bottom-right-radius: 6px; display: none;
}
.card-lock .icon { width: 14px; height: 14px; --icon-color: #7e8f9c; }
.card.locked .card-lock { display: flex; }

/* shared */
.dock-row { flex-direction: row; }
.dock-row .wide { margin-top: 0; }
.dock-row .wide.big { flex-grow: 1; margin-right: 10px; }
.dock-row .back-button { width: 160px; height: 64px; }
.wide.disabled { background-color: var(--n700); border-bottom-color: var(--n950); }
.wide.disabled .wide-title { color: var(--n400); }
.wide.disabled .icon { --icon-color: #52606d; }
.star-on { --icon-color: #f2a33a; }
.star-off { --icon-color: #3a4650; }

/* ================================================================ campaign page */
.campaign-columns { flex-direction: row; flex-grow: 1; flex-shrink: 1; overflow: hidden; }
.campaign-list { flex-basis: 56%; flex-grow: 0; flex-shrink: 0; padding-right: 8px; }
.campaign-detail {
    flex-grow: 1; margin: 12px 18px 12px 4px; padding-bottom: 12px;
    background-color: var(--n800); border-radius: 8px; overflow: hidden;
}
.map-group { flex-direction: row; align-items: center; margin-top: 10px; margin-bottom: 4px; }
.map-group-swatch { width: 18px; height: 18px; border-radius: 4px; margin-right: 8px; background-color: var(--n600); }
.map-group-swatch.temperate { background-color: #4f6b3a; }
.map-group-swatch.desert { background-color: #9a7440; }
.map-group-swatch.snow { background-color: #7d93a3; }
.map-group-swatch.harbor { background-color: #35566b; }
.map-group-name { -unity-font: resource("Fonts/BarlowCondensed-Bold"); font-size: 13px; letter-spacing: 2px; color: var(--n300); }
.mission-row {
    flex-direction: row; align-items: center; height: 54px; margin-bottom: 5px; padding: 0 10px;
    background-color: var(--n750); border-radius: 6px; border-bottom-color: var(--n950); border-bottom-width: 3px;
    border-left-width: 4px; border-left-color: var(--n750);
}
.mission-row:active { border-bottom-width: 1px; translate: 0 2px; }
.mission-row.boss { border-left-color: var(--danger-dark); }
.mission-row.chosen { background-color: var(--n700); border-left-color: var(--amber); }
.mission-row.locked { background-color: var(--n850); }
.mission-row.locked .mission-name, .mission-row.locked .mission-number { color: var(--n500); }
.mission-number { -unity-font: resource("Fonts/BarlowCondensed-Bold"); font-size: 22px; color: var(--amber); width: 34px; }
.mission-text { flex-grow: 1; flex-shrink: 1; }
.mission-name { -unity-font: resource("Fonts/BarlowCondensed-Bold"); font-size: 16px; color: var(--n100); }
.mission-goal-text { -unity-font: resource("Fonts/BarlowCondensed-SemiBold"); font-size: 11px; letter-spacing: 1px; color: var(--n400); margin-top: -3px; }
.mission-stars { flex-direction: row; }
.mission-stars .icon { width: 15px; height: 15px; margin-left: 1px; }
.mission-lock { width: 16px; height: 16px; margin-left: 8px; --icon-color: #7e8f9c; display: none; }
.mission-row.locked .mission-lock { display: flex; }
.mission-row.locked .mission-stars { display: none; }

.detail-art { height: 64px; flex-direction: row; align-items: center; padding: 0 14px; background-color: var(--n700); }
.detail-art.temperate { background-color: #4f6b3a; }
.detail-art.desert { background-color: #9a7440; }
.detail-art.snow { background-color: #7d93a3; }
.detail-art.harbor { background-color: #35566b; }
.detail-art .icon { width: 28px; height: 28px; margin-right: 10px; }
.detail-kicker { -unity-font: resource("Fonts/BarlowCondensed-Bold"); font-size: 13px; letter-spacing: 2px; color: #f4f7f8; }
.detail-name { -unity-font: resource("Fonts/BarlowCondensed-Bold"); font-size: 26px; letter-spacing: 1px; color: var(--n100); margin: 8px 14px 0 14px; }
.detail-line { flex-direction: row; align-items: center; margin: 4px 14px 0 14px; }
.detail-line .icon { width: 16px; height: 16px; margin-right: 6px; --icon-color: #f2a33a; }
.detail-goal { -unity-font: resource("Fonts/BarlowCondensed-Bold"); font-size: 14px; color: var(--amber); margin-right: 14px; }
.detail-weather { -unity-font: resource("Fonts/BarlowCondensed-SemiBold"); font-size: 13px; color: var(--n300); }
.detail-brief { -unity-font: resource("Fonts/Inter-Regular"); font-size: 12px; color: var(--n200); white-space: normal; margin: 8px 14px 0 14px; }
.detail-stars { flex-direction: row; margin: 10px 14px 0 14px; }
.detail-stars .icon { width: 22px; height: 22px; margin-right: 3px; }
.detail-rules { -unity-font: resource("Fonts/Inter-Regular"); font-size: 11px; color: var(--n400); white-space: normal; margin: 2px 14px 0 14px; }
.reward-line { margin-top: 10px; }
.detail-reward { -unity-font: resource("Fonts/BarlowCondensed-Bold"); font-size: 15px; color: var(--n100); }
.detail-unlocks { margin: 6px 14px 0 14px; }
.unlock-chip {
    flex-direction: row; align-items: center; height: 28px; padding: 0 10px; margin-top: 4px;
    background-color: var(--ally-dark); border-radius: 14px; align-self: flex-start;
}
.unlock-chip .icon { width: 15px; height: 15px; margin-right: 6px; }
.unlock-chip.owned { background-color: var(--n700); }
.unlock-text { -unity-font: resource("Fonts/BarlowCondensed-Bold"); font-size: 13px; color: #eaf5dd; }

/* ================================================================ shop */
.shop-head { padding: 10px 22px 0 22px; flex-shrink: 0; }
.shop-tabs .segment { flex-basis: 30%; }
.shop-grid { flex-direction: row; flex-wrap: wrap; }
.shop-card {
    width: 150px; height: 150px; margin: 0 8px 8px 0; align-items: center;
    background-color: var(--n750); border-radius: 8px; overflow: hidden;
    border-width: 3px; border-color: var(--n750); border-bottom-color: var(--n950);
}
.shop-card:active { translate: 0 2px; }
.shop-card.chosen { border-color: var(--amber); }
.shop-card.equipped { background-color: var(--ally-dark); border-color: var(--ally); }
.shop-card.soon { background-color: var(--n850); }
.skin-swatch { flex-direction: row; width: 100%; height: 70px; }
.skin-band { flex-grow: 1; height: 100%; }
.skin-swatch.metal { border-bottom-width: 3px; border-bottom-color: #ffffff; }
.unit-art { width: 100%; height: 70px; align-items: center; justify-content: center; background-color: var(--n700); }
.unit-art.premium { background-color: #5a3a12; }
.unit-art .icon { width: 40px; height: 40px; }
.unit-art.premium .icon { --icon-color: #f5b55e; }
.shop-name { -unity-font: resource("Fonts/BarlowCondensed-Bold"); font-size: 15px; color: var(--n100); margin-top: 6px; -unity-text-align: middle-center; white-space: normal; padding: 0 6px; }
.shop-sub { -unity-font: resource("Fonts/BarlowCondensed-SemiBold"); font-size: 11px; color: var(--n400); margin-top: -2px; }
.shop-soon { -unity-font: resource("Fonts/BarlowCondensed-Bold"); font-size: 12px; color: var(--n400); margin-top: 6px; }
.price-tag { flex-direction: row; align-items: center; margin-top: auto; margin-bottom: 8px; }
.price-tag .icon { width: 15px; height: 15px; margin-right: 4px; --icon-color: #f2a33a; }
.price-value { -unity-font: resource("Fonts/BarlowCondensed-Bold"); font-size: 15px; color: var(--amber); }
.price-status { -unity-font: resource("Fonts/BarlowCondensed-Bold"); font-size: 12px; color: var(--mint); margin-left: 6px; }
.shop-card.owned .price-value { display: none; }
.shop-card.owned .price-tag .icon { display: none; }

/* ================================================================ result rewards, ad screen */
.result-stars { flex-direction: row; justify-content: center; margin-top: 6px; }
.result-stars .icon { width: 30px; height: 30px; margin: 0 3px; }
.result-reward { flex-direction: row; justify-content: center; margin: 10px 18px 0 18px; }
.reward-item {
    flex-direction: row; align-items: center; height: 40px; padding: 0 14px; margin: 0 4px;
    background-color: var(--n900); border-radius: 8px;
}
.reward-item .icon { width: 20px; height: 20px; margin-right: 8px; --icon-color: #f2a33a; }
.reward-item.xp .icon { --icon-color: #8fd694; }
.reward-value { -unity-font: resource("Fonts/BarlowCondensed-Bold"); font-size: 22px; color: var(--n100); }
.reward-doubled {
    -unity-font: resource("Fonts/BarlowCondensed-Bold"); font-size: 14px; color: var(--amber-ink);
    background-color: var(--amber); border-radius: 9px; padding: 0 6px; margin-left: 6px;
}
.result-unlocks { align-items: center; margin-top: 6px; }
.result-unlocks .unlock-chip { align-self: center; }
.wide.ad-button { background-color: var(--ally); border-bottom-color: var(--ally-dark); }
.wide.ad-button .wide-sub { color: #dcebc9; }

.ad-screen { background-color: var(--n950); }
.ad-card {
    width: 460px; align-items: stretch; padding: 22px; background-color: var(--n800); border-radius: 10px;
    border-bottom-width: 4px; border-bottom-color: var(--n950);
}
.ad-card > .icon { width: 44px; height: 44px; align-self: center; --icon-color: #f2a33a; }
.ad-title { -unity-font: resource("Fonts/BarlowCondensed-Bold"); font-size: 30px; letter-spacing: 6px; color: var(--n100); -unity-text-align: middle-center; margin-top: 6px; }
.ad-body { -unity-font: resource("Fonts/Inter-Regular"); font-size: 12px; color: var(--n300); white-space: normal; -unity-text-align: middle-center; margin-top: 4px; }
.ad-count { -unity-font: resource("Fonts/BarlowCondensed-Bold"); font-size: 64px; color: var(--amber); -unity-text-align: middle-center; height: 80px; }

/* ================================================================ in-battle: timer, mission bar, boss bar */
.score-centre { align-items: center; }
.score-timer {
    -unity-font: resource("Fonts/BarlowCondensed-Bold"); font-size: 13px; letter-spacing: 1px; color: var(--n200);
    background-color: var(--n800); border-radius: 8px; padding: 0 8px; margin-top: 2px;
}
.score-timer.urgent { background-color: var(--danger); color: #fff1ec; }
.mission-clock.urgent { background-color: var(--danger); color: #fff1ec; }
.mission-bar {
    flex-direction: row; align-items: center; height: 44px; padding: 0 12px;
    background-color: var(--n800); border-radius: 6px;
}
.mission-bar-text { width: 190px; }
.mission-goal { -unity-font: resource("Fonts/BarlowCondensed-Bold"); font-size: 15px; letter-spacing: 1px; color: var(--amber); }
.mission-detail { -unity-font: resource("Fonts/BarlowCondensed-SemiBold"); font-size: 13px; color: var(--n200); margin-top: -3px; }
.mission-track { width: 150px; height: 8px; background-color: var(--n950); border-radius: 2px; margin: 0 10px; }
.mission-fill { height: 100%; width: 0; background-color: var(--amber); border-radius: 2px; }
.mission-chips { margin-left: 0; }
.mission-clock {
    -unity-font: resource("Fonts/BarlowCondensed-Bold"); font-size: 18px; color: var(--n100);
    background-color: var(--n900); border-radius: 6px; padding: 2px 10px; margin-left: 8px;
}
.boss-bar {
    position: absolute; top: 60px; left: 30%; right: 30%; height: 38px; padding: 4px 10px;
    background-color: var(--danger-dark); border-radius: 6px; border-bottom-width: 3px; border-bottom-color: #5c140a;
}
.boss-head { flex-direction: row; align-items: center; }
.boss-head .icon { width: 16px; height: 16px; margin-right: 6px; }
.boss-name { -unity-font: resource("Fonts/BarlowCondensed-Bold"); font-size: 13px; letter-spacing: 2px; color: #ffe6e0; }
.boss-track { height: 9px; margin-top: 2px; background-color: #3a0c05; border-radius: 3px; }
.boss-fill { height: 100%; width: 100%; background-color: #ff6a4d; border-radius: 3px; }

/* cinematic bars */
.letterbox { position: absolute; left: 0; right: 0; height: 0; background-color: #000000; display: none; }
.letterbox.top { top: 0; }
.letterbox.bottom { bottom: 0; }
