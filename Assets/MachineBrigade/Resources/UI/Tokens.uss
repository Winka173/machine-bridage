/* Field Command 2.0: the design tokens and the component classes of the UI kit (Game/Hud/Kit).

   This is the one theme file. Every colour, font, type size, spacing step, border and control
   size is a --fc-* variable in the two blocks at the top; everything below uses var() only, so a
   colour or size changes here and nowhere else (UiThemeTests fails on a literal colour or font
   size outside these blocks). Theme.tss imports this file, so every panel of the game has the
   tokens at its root.

   Units (prompt 14). Sizes are device points: 1 pt = 1.823 panel px (Kit.PanelPxPerPoint: the kit's
   44 pt touch target is 80.2 px). The menus scale with the device's pixel density (BattleHud.MenuScale),
   so a point is a point on every phone and tablet, whatever its width; a panel 720 px high is a phone
   395 pt high, the reference phone. The comments give the points. Hairlines, bars and the spacing
   scale keep their literal pixels (4 px is about 2 pt, 8 px 4 pt, 16 px 9 pt: the small end of the
   brief's 4 / 8 / 12 / 16 / 24 pt scale, which cards and panels use inside).
   The battle HUD keeps its own sizes (prompt 11): the .fc-hud block below restores them, and the
   battle's overlays (result, pause, the choice between stages; .fc-overlay) take the menus' again. */

:root {
    /* ---- A. colour: surfaces */
    --fc-bg: #101317;                         /* nền */
    --fc-bg-2: #121519;                       /* nền phụ */
    --fc-panel: #171b20;                      /* panel */
    --fc-panel-raised: #1b2026;               /* panel nổi: dialogs, toasts, tooltips, cards */
    --fc-panel-selected: #1f252c;             /* panel được chọn */
    --fc-panel-field: rgba(18, 22, 27, 0.93); /* panel trên chiến trường: #12161b at 93 % */
    --fc-border: #2c333b;                     /* viền */
    --fc-border-strong: #3a424b;              /* viền đậm */
    --fc-scrim: rgba(8, 10, 12, 0.72);        /* behind a dialog */
    --fc-wash: rgba(233, 230, 223, 0.08);     /* a pressed ghost button */
    --fc-danger-wash: rgba(224, 81, 58, 0.14);
    --fc-clear: rgba(0, 0, 0, 0);             /* no fill, no line */

    /* ---- A. colour: text */
    --fc-text: #e9e6df;                       /* chữ chính */
    --fc-text-2: #aab2ba;                     /* chữ phụ */
    --fc-text-dim: #8a939b;                   /* chữ mờ: only at the body size and up */
    --fc-ink: #101317;                        /* dark text on the accent, coin and text fills */

    /* ---- A. colour: accent and meaning */
    --fc-accent: #f2a33a;                     /* the one main button, the chosen nav item and tab */
    --fc-accent-press: #d88a22;
    --fc-coin: #e8c15a;                       /* coins and rewards */
    --fc-coin-press: #cfa640;
    --fc-coin-glow: #f3d67f;                  /* the claim button's slow pulse */
    --fc-danger: #e0513a;                     /* danger, notices, defeat: borders, the dot, icons */
    --fc-danger-text: #ea6a55;                /* danger as text: #e0513a reads 4.45:1 on a panel (needs 4.5) */
    --fc-positive: #9ccb5e;                   /* better in a comparison */
    --fc-ally: #6cc0ff;                       /* our side (minimap, HUD): brighter than the enemy */
    --fc-enemy: #e0513a;                      /* their side */
    --fc-enemy-cb: #f29a3a;                   /* their side for colour-blind players (Settings: orange against our blue) */
    --fc-dialogue-ally: #9ad4ff;              /* prompt 23 H.2: our speakers' names, a light blue, brighter than the enemy's */
    --fc-dialogue-enemy: #ea6a55;             /* the enemy's speakers' names, a darker red */
    --fc-dialogue-enemy-cb: #d9802a;          /* ...for colour-blind players: a darker orange against our light blue */
    --fc-dialogue-strip: rgba(8, 10, 12, 0.62);   /* the dim strip under a dialogue line (not a panel) */
    --fc-accord: #6bc7ff;                     /* prompt 23 F: the Meridian Accord's (allied AI) reinforcements and arrows: sky blue */
    --fc-accord-cb: #3fd6c6;                  /* ...for colour-blind players: teal, apart from our blue and their orange */
    --fc-flash: #ffe6b8;                      /* the flash of a huge blast over the battlefield */
    --fc-range-ground: rgba(226, 132, 48, 0.06);  /* the Base screen's ground cover: a nearly clear orange tint (play-test 8 A: ranges are borders) */
    --fc-range-air: rgba(170, 214, 255, 0.07);    /* its air cover: a nearly clear light blue tint */

    /* ---- A. colour: vehicle branches (always shown with the class icon) */
    --fc-branch-armor: #8fb3d6;
    --fc-branch-light: #a9cf7a;
    --fc-branch-artillery: #e0956a;
    --fc-branch-air: #bba6e6;
    --fc-branch-support: #cfc8b8;

    /* ---- A. colour: rarity (legendary is redder than the accent, so it never reads as the main button) */
    --fc-rarity-common: #9aa3ab;
    --fc-rarity-uncommon: #6fbf5a;
    --fc-rarity-rare: #4f9be8;
    --fc-rarity-epic: #a877e8;
    --fc-rarity-legendary: #ff7a2e;

    /* ---- B. fonts: Barlow Condensed 600/700 for titles, labels and big numbers; Barlow 400/500/600 for text */
    --fc-font-display: resource("Fonts/BarlowCondensed-Bold");
    --fc-font-display-semi: resource("Fonts/BarlowCondensed-SemiBold");
    --fc-font-text: resource("Fonts/Barlow-Regular");
    --fc-font-text-medium: resource("Fonts/Barlow-Medium");
    --fc-font-text-semi: resource("Fonts/Barlow-SemiBold");

    /* ---- B. type scale, Normal text size, in points (prompt 14: the brief's range in brackets) */
    --fc-fs-primary: 35px;                    /* main button: 19 pt (18-20) */
    --fc-fs-title: 33px;                      /* screen title: 18 pt (17-20) */
    --fc-fs-panel-title: 26px;                /* panel title: 14.3 pt (14-15) */
    --fc-fs-button: 26px;                     /* other buttons, tabs, chips: panel title size */
    --fc-fs-body: 24px;                       /* body text: 13.2 pt (13-14) */
    --fc-fs-small: 20px;                      /* secondary text: 11 pt; nothing under 10 pt (18.2 px) */
    --fc-fs-number: 36px;                     /* big numbers: 19.7 pt */
    --fc-fs-number-small: 25px;               /* numbers in a row of text: 13.7 pt */
    --fc-fs-card: 22px;                       /* a card's name: 12 pt (cards are narrow; between the secondary and panel title sizes) */
    --fc-fs-dialogue: 24px;                   /* prompt 23 H.2: the battle's dialogue line, the body size: 13.2 pt */

    /* ---- B. touch targets, corners, borders */
    --fc-touch: 81px;                         /* 44 pt: every tap target, a larger invisible one round a smaller face */
    --fc-control: 64px;                       /* the visible face of a chip, text button or plus inside its touch target */
    --fc-icon: 28px;
    --fc-icon-small: 22px;
    --fc-chamfer: 20px;                       /* the main button's two cut corners: 18 px (20.0) */
    --fc-line: 1px;                           /* every border */
    --fc-underline: 2px;                      /* the chosen tab */
    --fc-bar: 3px;                            /* the branch bar on a card, the chosen nav item's accent */
    --fc-progress: 4px;                       /* progress bars: 3-4 px */
    --fc-dot: 8px;                            /* notification dot */
    --fc-press-shift: 2px;                    /* a pressed button sinks by this */

    /* ---- B. spacing scale 4 / 8 / 12 / 16 / 20 / 24 / 32 */
    --fc-space-1: 4px;
    --fc-space-2: 8px;
    --fc-space-3: 12px;
    --fc-space-4: 16px;
    --fc-space-5: 20px;
    --fc-space-6: 24px;
    --fc-space-7: 32px;

    /* ---- component sizes (prompt 14: cards in lists 22 % smaller) */
    --fc-card-width: 144px;                   /* 79 pt (184 px before) */
    --fc-card-art: 116px;
    --fc-card-compact-width: 112px;           /* 61 pt (136 px before) */
    --fc-card-compact-art: 78px;
    --fc-gear-width: 128px;                   /* 70 pt (164 px before) */
    --fc-gear-art: 82px;
    --fc-dialog-width: 620px;
    --fc-tooltip-width: 380px;
    --fc-thumb-width: 112px;
    --fc-thumb-height: 63px;
    --fc-nav-width: 132px;                    /* the left rail: 72 pt (72-80) */
    --fc-nav-icon: 42px;                      /* its icons: 23 pt (22-24); labels are the secondary size, 11 pt */
    --fc-tab: 73px;                           /* a row of tabs: 40 pt (the tabs' targets reach 44 pt) */
    --fc-switch-width: 64px;
    --fc-switch-height: 34px;
    --fc-knob: 24px;

    /* ---- prompt 15: armour and weapon icons (KitCombat) */
    --fc-cicon: 34px;                         /* an armour icon or a weapon chip in tight places: 18.7 pt (18-20) */
    --fc-cicon-large: 52px;                   /* on the detail page: 28.5 pt */
    --fc-cmark: 17px;                         /* the damage-type mark in a chip's corner */
    --fc-cmark-large: 24px;
    --fc-chip-bg: var(--fc-panel-raised);     /* under the corner mark: the surface the chip sits on */
    --fc-effect-weapon: 60px;                 /* the effectiveness table's first column */
    --fc-armour-diagram: 150px;

    /* ---- screen layout (Screens.uss) */
    --fc-topbar: 81px;                        /* the top bar: 44.4 pt (44-48) */
    --fc-home-column: 440px;
    --fc-detail-column: 470px;
    --fc-detail-stage: 250px;                 /* the turntable's box on the detail page's left */
    --fc-detail-side: 400px;                  /* the In action theatre's info column beside the big preview */
    --fc-scrim-home: rgba(8, 10, 12, 0.38);   /* the home screen's battle, dimmed 38 % */
}

/* ---- B. type scale, Large text size (Settings > Text size > Large): the whole scale about 1.2x */
.fc-text-large {
    --fc-fs-primary: 42px;
    --fc-fs-title: 40px;
    --fc-fs-panel-title: 31px;
    --fc-fs-button: 31px;
    --fc-fs-body: 29px;
    --fc-fs-small: 24px;
    --fc-fs-number: 43px;
    --fc-fs-number-small: 30px;
    --fc-fs-card: 26px;
    --fc-fs-dialogue: 29px;
    --fc-topbar: 87px;                        /* 47.7 pt: the rank's two lines at Large text */
}

/* ---- the battle HUD keeps its own type and target sizes (prompt 11; it scales with the screen's height) */
.fc-hud {
    --fc-fs-primary: 42px;
    --fc-fs-title: 30px;
    --fc-fs-panel-title: 23px;
    --fc-fs-button: 23px;
    --fc-fs-body: 21px;
    --fc-fs-small: 19px;
    --fc-fs-number: 36px;
    --fc-fs-number-small: 23px;
    --fc-touch: 82px;
    --fc-fs-dialogue: 24px;                   /* the dialogue line keeps the menus' body size (prompt 23 H.2), not the HUD's */
}
.fc-hud.fc-text-large {
    --fc-fs-primary: 48px;
    --fc-fs-title: 34px;
    --fc-fs-panel-title: 26px;
    --fc-fs-button: 26px;
    --fc-fs-body: 24px;
    --fc-fs-small: 22px;
    --fc-fs-number: 41px;
    --fc-fs-number-small: 26px;
    --fc-fs-dialogue: 29px;
}
/* ...and the battle's overlays (result, pause, the choice, the ad) are the menus' sizes again. */
.fc-hud .fc-overlay {
    --fc-fs-primary: 35px;
    --fc-fs-title: 33px;
    --fc-fs-panel-title: 26px;
    --fc-fs-button: 26px;
    --fc-fs-body: 24px;
    --fc-fs-small: 20px;
    --fc-fs-number: 36px;
    --fc-fs-number-small: 25px;
    --fc-touch: 81px;
}
.fc-hud .fc-overlay.fc-text-large {
    --fc-fs-primary: 42px;
    --fc-fs-title: 40px;
    --fc-fs-panel-title: 31px;
    --fc-fs-button: 31px;
    --fc-fs-body: 29px;
    --fc-fs-small: 24px;
    --fc-fs-number: 43px;
    --fc-fs-number-small: 30px;
}

/* ================================================================================================
   Components. Nothing below this line may hold a literal colour or font size.
   ================================================================================================ */

/* ---- roots and text: every label wraps; nothing is ever cut with an ellipsis ------------------ */
.fc-root {
    -unity-font: var(--fc-font-text);
    font-size: var(--fc-fs-body);
    color: var(--fc-text);
}
.fc-root Label, .fc-text {
    white-space: normal;
    text-overflow: clip;
    flex-shrink: 0;                           /* a text never gives up height: it pushes, it is never squashed */
}
/* In a row a text may give up width, and wraps instead. */
.fc-btn__row > .fc-text, .fc-toast > .fc-text, .fc-chip__face > .fc-text, .fc-type-row > .fc-text, .fc-compare-row > .fc-text,
.fc-toggle > .fc-text, .fc-preview__top > .fc-text, .fc-currency > .fc-text, .fc-sample__rank .fc-text, .fc-root .fc-row-text {
    flex-shrink: 1;
}
.fc-icon { --icon-color: var(--fc-text); flex-shrink: 0; }
/* A tap never scales a kit control (the old menu's ".menu .pressed" does). */
.fc-root .mb-tap.pressed { scale: 1 1; }
.fc-screen { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: var(--fc-bg); }
.fc-safe { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }

.fc-title { -unity-font: var(--fc-font-display); font-size: var(--fc-fs-title); color: var(--fc-text); letter-spacing: 1.5px; }
.fc-panel-title { -unity-font: var(--fc-font-display-semi); font-size: var(--fc-fs-panel-title); color: var(--fc-text); letter-spacing: 1px; }
.fc-body { -unity-font: var(--fc-font-text); font-size: var(--fc-fs-body); color: var(--fc-text); }
.fc-body-2 { -unity-font: var(--fc-font-text); font-size: var(--fc-fs-body); color: var(--fc-text-2); }
.fc-dim { -unity-font: var(--fc-font-text); font-size: var(--fc-fs-body); color: var(--fc-text-dim); }
.fc-small { -unity-font: var(--fc-font-text-medium); font-size: var(--fc-fs-small); color: var(--fc-text-2); }
.fc-caption { -unity-font: var(--fc-font-display-semi); font-size: var(--fc-fs-small); color: var(--fc-text-2); letter-spacing: 1.5px; }
.fc-number { -unity-font: var(--fc-font-display); font-size: var(--fc-fs-number); color: var(--fc-text); }
.fc-number-small { -unity-font: var(--fc-font-display-semi); font-size: var(--fc-fs-number-small); color: var(--fc-text); }
.fc-danger-text { color: var(--fc-danger-text); }
.fc-coin-text { color: var(--fc-coin); }
.fc-positive-text { color: var(--fc-positive); }

/* ---- surfaces: panels, dialogs, toasts and tooltips share one border and background ------------ */
.fc-surface {
    background-color: var(--fc-panel-raised);
    border-top-width: var(--fc-line); border-right-width: var(--fc-line); border-bottom-width: var(--fc-line); border-left-width: var(--fc-line);
    border-top-color: var(--fc-border-strong); border-right-color: var(--fc-border-strong); border-bottom-color: var(--fc-border-strong); border-left-color: var(--fc-border-strong);
}
.fc-surface--field { background-color: var(--fc-panel-field); }
.fc-panel { padding: var(--fc-space-4); }
.fc-panel__title { margin-bottom: var(--fc-space-3); }
.fc-panel__body { flex-shrink: 1; }

.fc-scrim {
    position: absolute; left: 0; top: 0; right: 0; bottom: 0;
    align-items: center; justify-content: center;
    background-color: var(--fc-scrim);
}
.fc-dialog { width: var(--fc-dialog-width); max-width: 92%; padding: var(--fc-space-6); }
.fc-dialog__title { margin-bottom: var(--fc-space-3); }
.fc-dialog__body { margin-bottom: var(--fc-space-6); }
.fc-dialog__buttons { flex-direction: row; justify-content: flex-end; flex-wrap: wrap; }
.fc-dialog__buttons > * { margin-left: var(--fc-space-3); }

.fc-toast {
    flex-direction: row; align-items: center;
    padding: var(--fc-space-3) var(--fc-space-5);
    min-height: var(--fc-control);
}
.fc-toast > .fc-icon { width: var(--fc-icon); height: var(--fc-icon); margin-right: var(--fc-space-3); }
.fc-toast--reward > .fc-icon { --icon-color: var(--fc-coin); }
.fc-toast--alert > .fc-icon { --icon-color: var(--fc-danger); }
.fc-toast-host {
    position: absolute; left: 0; right: 0; bottom: var(--fc-space-7);
    align-items: center;
}

.fc-tooltip { max-width: var(--fc-tooltip-width); padding: var(--fc-space-3) var(--fc-space-4); }
.fc-tooltip__title { margin-bottom: var(--fc-space-1); }

/* ---- buttons: five tiers, each normal / pressed / disabled (with a reason) / loading --------- */
.fc-btn {
    min-height: var(--fc-touch); min-width: var(--fc-touch);
    padding: var(--fc-space-2) var(--fc-space-6);
    align-items: center; justify-content: center;
    background-color: var(--fc-clear);
    border-top-width: var(--fc-line); border-right-width: var(--fc-line); border-bottom-width: var(--fc-line); border-left-width: var(--fc-line);
    border-top-color: var(--fc-clear); border-right-color: var(--fc-clear); border-bottom-color: var(--fc-clear); border-left-color: var(--fc-clear);
    translate: 0 0;
    transition-property: translate, background-color, -unity-background-image-tint-color;
    transition-duration: 0.06s;
}
.fc-btn__row { flex-direction: row; align-items: center; justify-content: center; flex-shrink: 1; }
.fc-btn__icon { width: var(--fc-icon); height: var(--fc-icon); margin-right: var(--fc-space-2); }
.fc-btn__label {
    -unity-font: var(--fc-font-display-semi); font-size: var(--fc-fs-button); letter-spacing: 1.2px;
    -unity-text-align: middle-center; color: var(--fc-text);
}
.fc-btn__reason {
    -unity-font: var(--fc-font-text-medium); font-size: var(--fc-fs-small); color: var(--fc-text-2);
    -unity-text-align: middle-center; margin-top: var(--fc-space-1);
    display: none;
}
.fc-btn__spinner { width: var(--fc-icon); height: var(--fc-icon); margin-right: var(--fc-space-2); display: none; }
.fc-btn--disabled .fc-btn__reason { display: flex; }
.fc-btn--loading .fc-btn__spinner { display: flex; }
.fc-btn--loading .fc-btn__icon { display: none; }
.fc-root .fc-btn.pressed, .fc-btn--pressed { translate: 0 var(--fc-press-shift); scale: 1 1; }
.fc-root .fc-btn--disabled.pressed { translate: 0 0; scale: 1 1; }

/* Primary: the accent face with two opposite corners cut. At most one on a screen. */
.fc-btn--primary {
    min-height: 96px; padding: var(--fc-space-2) var(--fc-space-7);
    background-image: resource("UI/Skin/fc_primary");
    -unity-slice-left: 40; -unity-slice-top: 40; -unity-slice-right: 40; -unity-slice-bottom: 40; -unity-slice-scale: 0.5px;
    -unity-background-image-tint-color: var(--fc-accent);
}
.fc-btn--primary .fc-btn__label { -unity-font: var(--fc-font-display); font-size: var(--fc-fs-primary); color: var(--fc-ink); letter-spacing: 3px; }
.fc-btn--primary .fc-btn__icon, .fc-btn--primary .fc-btn__spinner { --icon-color: var(--fc-ink); width: 34px; height: 34px; margin-right: var(--fc-space-3); }
.fc-btn--primary .fc-btn__reason { color: var(--fc-ink); }
.fc-root .fc-btn--primary.pressed, .fc-btn--primary.fc-btn--pressed { -unity-background-image-tint-color: var(--fc-accent-press); scale: 1 1; }
.fc-btn--primary.fc-btn--disabled { -unity-background-image-tint-color: var(--fc-border-strong); }
.fc-btn--primary.fc-btn--disabled .fc-btn__label, .fc-btn--primary.fc-btn--disabled .fc-btn__reason { color: var(--fc-text-2); }
.fc-btn--primary.fc-btn--disabled .fc-btn__icon { --icon-color: var(--fc-text-2); }

/* Secondary: an outline in the text colour, no fill. */
.fc-btn--secondary { border-top-color: var(--fc-text); border-right-color: var(--fc-text); border-bottom-color: var(--fc-text); border-left-color: var(--fc-text); }
.fc-root .fc-btn--secondary.pressed, .fc-btn--secondary.fc-btn--pressed { background-color: var(--fc-panel-selected); scale: 1 1; }
.fc-btn--secondary.fc-btn--disabled { border-top-color: var(--fc-border-strong); border-right-color: var(--fc-border-strong); border-bottom-color: var(--fc-border-strong); border-left-color: var(--fc-border-strong); }
.fc-btn--secondary.fc-btn--disabled .fc-btn__label { color: var(--fc-text-2); }
.fc-btn--secondary.fc-btn--disabled .fc-btn__icon { --icon-color: var(--fc-text-2); }

/* Claim reward: the coin face, dark text, a coin icon and a slow pulse; only while there is a reward. */
.fc-btn--claim {
    background-color: var(--fc-coin);
    transition-property: translate, background-color;
    transition-duration: 0.06s, 0.9s;
}
.fc-btn--claim.fc-btn--glow { background-color: var(--fc-coin-glow); }
.fc-btn--claim .fc-btn__label, .fc-btn--claim .fc-btn__reason { color: var(--fc-ink); }
.fc-btn--claim .fc-btn__icon, .fc-btn--claim .fc-btn__spinner { --icon-color: var(--fc-ink); }
.fc-root .fc-btn--claim.pressed, .fc-btn--claim.fc-btn--pressed { background-color: var(--fc-coin-press); scale: 1 1; }
.fc-btn--claim.fc-btn--disabled { background-color: var(--fc-border-strong); }
.fc-btn--claim.fc-btn--disabled .fc-btn__label, .fc-btn--claim.fc-btn--disabled .fc-btn__reason { color: var(--fc-text-2); }
.fc-btn--claim.fc-btn--disabled .fc-btn__icon { --icon-color: var(--fc-text-2); }

/* Text only: the accent colour, no face, still a full touch target. */
.fc-btn--text { padding: 0 var(--fc-space-3); }
.fc-btn--text .fc-btn__label { color: var(--fc-accent); -unity-font: var(--fc-font-display-semi); }
.fc-btn--text .fc-btn__icon, .fc-btn--text .fc-btn__spinner { --icon-color: var(--fc-accent); }
.fc-root .fc-btn--text.pressed .fc-btn__label, .fc-btn--text.fc-btn--pressed .fc-btn__label { color: var(--fc-accent-press); scale: 1 1; }
.fc-btn--text.fc-btn--disabled .fc-btn__label { color: var(--fc-text-2); }
.fc-btn--text.fc-btn--disabled .fc-btn__icon { --icon-color: var(--fc-text-2); }

/* Danger: a red outline; it always asks first (Merge all, Sell, Change tower branch, Reset). */
.fc-btn--danger { border-top-color: var(--fc-danger); border-right-color: var(--fc-danger); border-bottom-color: var(--fc-danger); border-left-color: var(--fc-danger); }
.fc-btn--danger .fc-btn__label { color: var(--fc-danger-text); }
.fc-btn--danger .fc-btn__icon, .fc-btn--danger .fc-btn__spinner { --icon-color: var(--fc-danger-text); }
.fc-root .fc-btn--danger.pressed, .fc-btn--danger.fc-btn--pressed { background-color: var(--fc-danger-wash); scale: 1 1; }
.fc-btn--danger.fc-btn--disabled { border-top-color: var(--fc-border-strong); border-right-color: var(--fc-border-strong); border-bottom-color: var(--fc-border-strong); border-left-color: var(--fc-border-strong); }
.fc-btn--danger.fc-btn--disabled .fc-btn__label { color: var(--fc-text-2); }
.fc-btn--danger.fc-btn--disabled .fc-btn__icon { --icon-color: var(--fc-text-2); }

/* ---- icon buttons: a fixed square, always with an accessibility label ------------------------ */
.fc-icon-btn {
    width: var(--fc-touch); height: var(--fc-touch);
    align-items: center; justify-content: center;
    background-color: var(--fc-panel);
    border-top-width: var(--fc-line); border-right-width: var(--fc-line); border-bottom-width: var(--fc-line); border-left-width: var(--fc-line);
    border-top-color: var(--fc-border-strong); border-right-color: var(--fc-border-strong); border-bottom-color: var(--fc-border-strong); border-left-color: var(--fc-border-strong);
    translate: 0 0;
}
.fc-icon-btn > .fc-icon { width: var(--fc-icon); height: var(--fc-icon); }
.fc-root .fc-icon-btn.pressed, .fc-icon-btn.fc-btn--pressed { background-color: var(--fc-panel-selected); translate: 0 var(--fc-press-shift); scale: 1 1; }
.fc-icon-btn.fc-btn--disabled > .fc-icon { --icon-color: var(--fc-text-dim); }
/* A plus beside a number (buy coins): a small face inside the full target. */
.fc-icon-btn--plain { background-color: var(--fc-clear); border-top-color: var(--fc-clear); border-right-color: var(--fc-clear); border-bottom-color: var(--fc-clear); border-left-color: var(--fc-clear); }
.fc-icon-btn__face {
    width: 44px; height: 44px; align-items: center; justify-content: center;
    background-color: var(--fc-panel-selected);
    border-top-width: var(--fc-line); border-right-width: var(--fc-line); border-bottom-width: var(--fc-line); border-left-width: var(--fc-line);
    border-top-color: var(--fc-border-strong); border-right-color: var(--fc-border-strong); border-bottom-color: var(--fc-border-strong); border-left-color: var(--fc-border-strong);
}
.fc-icon-btn__face > .fc-icon { width: var(--fc-icon-small); height: var(--fc-icon-small); }
.fc-root .fc-icon-btn--plain.pressed .fc-icon-btn__face { background-color: var(--fc-border-strong); scale: 1 1; }

/* ---- tabs: panel background, the chosen one underlined in the accent ------------------------- */
.fc-tabs {
    flex-direction: row; align-items: stretch;
    background-color: var(--fc-panel);
    border-bottom-width: var(--fc-line); border-bottom-color: var(--fc-border);
}
.fc-tab {
    min-height: var(--fc-touch); min-width: var(--fc-touch);
    padding: 0 var(--fc-space-6);
    align-items: center; justify-content: center;
    border-bottom-width: var(--fc-underline); border-bottom-color: var(--fc-clear);
    /* The row is 40 pt; each tab's 44 pt target reaches past it, unseen (and 1 px over the row's line). */
    margin-top: -4px; margin-bottom: -5px;
}
.fc-tab__label { -unity-font: var(--fc-font-display-semi); font-size: var(--fc-fs-button); letter-spacing: 1.2px; color: var(--fc-text-2); -unity-text-align: middle-center; }
.fc-root .fc-tab.pressed { background-color: var(--fc-panel-raised); scale: 1 1; }
.fc-tab--selected { border-bottom-color: var(--fc-accent); }
.fc-tab--selected .fc-tab__label { color: var(--fc-text); }

/* ---- filter chips: chosen = text-colour face with dark text; the rest an outline -------------- */
.fc-chip-row { flex-direction: row; align-items: flex-start; flex-wrap: nowrap; }
.fc-chip-row__chips { flex-direction: row; flex-wrap: wrap; flex-grow: 1; flex-shrink: 1; align-items: center; }
.fc-chip-row__divider { width: var(--fc-line); height: 40px; margin: 21px var(--fc-space-3) 0 var(--fc-space-3); flex-shrink: 0; background-color: var(--fc-border-strong); }
.fc-chip-row > .fc-sort { flex-shrink: 0; margin-right: 0; }
.fc-chip {
    min-height: var(--fc-touch); min-width: var(--fc-touch);
    justify-content: center; align-items: center;
    margin-right: var(--fc-space-2);
}
.fc-chip__face {
    min-height: var(--fc-control);
    flex-direction: row; align-items: center; justify-content: center;
    padding: 0 var(--fc-space-4);
    border-top-width: var(--fc-line); border-right-width: var(--fc-line); border-bottom-width: var(--fc-line); border-left-width: var(--fc-line);
    border-top-color: var(--fc-border-strong); border-right-color: var(--fc-border-strong); border-bottom-color: var(--fc-border-strong); border-left-color: var(--fc-border-strong);
}
.fc-chip__label { -unity-font: var(--fc-font-display-semi); font-size: var(--fc-fs-button); letter-spacing: 1px; color: var(--fc-text); -unity-text-align: middle-center; }
.fc-chip__icon { width: var(--fc-icon-small); height: var(--fc-icon-small); margin-right: var(--fc-space-2); }
.fc-chip__swatch { width: 12px; height: 12px; margin-right: var(--fc-space-2); }
.fc-root .fc-chip.pressed .fc-chip__face { background-color: var(--fc-panel-selected); scale: 1 1; }
.fc-chip--selected .fc-chip__face {
    background-color: var(--fc-text);
    border-top-color: var(--fc-text); border-right-color: var(--fc-text); border-bottom-color: var(--fc-text); border-left-color: var(--fc-text);
}
.fc-chip--selected .fc-chip__label { color: var(--fc-ink); }
.fc-chip--selected .fc-chip__icon { --icon-color: var(--fc-ink); }
.fc-root .fc-chip--selected.pressed .fc-chip__face { background-color: var(--fc-text-2); scale: 1 1; }
/* The sort button stands apart from the filter chips: a caret instead of a state. */
.fc-sort .fc-chip__face { background-color: var(--fc-panel); }
.fc-sort .fc-chip__caret { width: var(--fc-icon-small); height: var(--fc-icon-small); margin-left: var(--fc-space-2); }

/* Branch colours: a swatch or a bar, never alone (the class icon goes with it). */
.fc-branch--armor { background-color: var(--fc-branch-armor); }
.fc-branch--light { background-color: var(--fc-branch-light); }
.fc-branch--artillery { background-color: var(--fc-branch-artillery); }
.fc-branch--air { background-color: var(--fc-branch-air); }
.fc-branch--support { background-color: var(--fc-branch-support); }

/* ---- dropdowns: label, current value, caret, an optional thumbnail --------------------------- */
.fc-dropdown {
    min-height: var(--fc-touch);
    flex-direction: row; align-items: center;
    padding: var(--fc-space-2) var(--fc-space-4) var(--fc-space-2) var(--fc-space-2);
    background-color: var(--fc-panel);
    border-top-width: var(--fc-line); border-right-width: var(--fc-line); border-bottom-width: var(--fc-line); border-left-width: var(--fc-line);
    border-top-color: var(--fc-border-strong); border-right-color: var(--fc-border-strong); border-bottom-color: var(--fc-border-strong); border-left-color: var(--fc-border-strong);
    translate: 0 0;
}
.fc-root .fc-dropdown.pressed, .fc-dropdown.fc-btn--pressed { background-color: var(--fc-panel-selected); translate: 0 var(--fc-press-shift); scale: 1 1; }
.fc-dropdown__thumb { width: var(--fc-thumb-width); height: var(--fc-thumb-height); margin-right: var(--fc-space-3); -unity-background-scale-mode: scale-and-crop; background-color: var(--fc-bg-2); }
.fc-dropdown__text { flex-grow: 1; flex-shrink: 1; padding-left: var(--fc-space-2); }
.fc-dropdown__label { -unity-font: var(--fc-font-display-semi); font-size: var(--fc-fs-small); letter-spacing: 1.5px; color: var(--fc-text-2); }
.fc-dropdown__value { -unity-font: var(--fc-font-text-semi); font-size: var(--fc-fs-body); color: var(--fc-text); }
.fc-dropdown__caret { width: var(--fc-icon); height: var(--fc-icon); margin-left: var(--fc-space-3); }
/* The list a dropdown opens (in a dialog surface). */
.fc-picker { width: var(--fc-dialog-width); max-width: 92%; max-height: 90%; padding: var(--fc-space-4); }
.fc-picker__scroll { flex-shrink: 1; }
.fc-option {
    min-height: var(--fc-touch);
    flex-direction: row; align-items: center;
    padding: var(--fc-space-2) var(--fc-space-3);
    border-bottom-width: var(--fc-line); border-bottom-color: var(--fc-border);
}
.fc-root .fc-option.pressed { background-color: var(--fc-panel-selected); scale: 1 1; }
.fc-option--selected { background-color: var(--fc-panel-selected); }
.fc-option__text { flex-grow: 1; flex-shrink: 1; }
.fc-option__check { width: var(--fc-icon); height: var(--fc-icon); margin-left: var(--fc-space-3); visibility: hidden; }
.fc-option--selected .fc-option__check { visibility: visible; }

/* ---- vehicle cards ------------------------------------------------------------------------------ */
.fc-vcard {
    width: var(--fc-card-width); flex-shrink: 0;
    background-color: var(--fc-panel-raised);
    border-top-width: 0; border-right-width: var(--fc-line); border-bottom-width: var(--fc-line); border-left-width: var(--fc-line);
    border-right-color: var(--fc-border); border-bottom-color: var(--fc-border); border-left-color: var(--fc-border);
    margin-right: var(--fc-space-3); margin-bottom: var(--fc-space-3);
    translate: 0 0;
}
.fc-root .fc-vcard.pressed { translate: 0 var(--fc-press-shift); background-color: var(--fc-panel-selected); scale: 1 1; }
/* Play-test 6: a card in the deck reads at a glance on a phone: a 4 px outline in the accent all round and a check
   in an accent square on its picture (the old one-line light outline was hard to see). */
.fc-vcard--chosen { background-color: var(--fc-panel-selected); border-right-color: var(--fc-accent); border-bottom-color: var(--fc-accent); border-left-color: var(--fc-accent); }
/* The outline is drawn over the card (it does not move the card's parts, which line up across a row). */
.fc-vcard__outline {
    position: absolute; left: 0; top: 0; right: 0; bottom: 0;
    border-top-width: 4px; border-right-width: 3px; border-bottom-width: 3px; border-left-width: 3px;
    border-top-color: var(--fc-accent); border-right-color: var(--fc-accent); border-bottom-color: var(--fc-accent); border-left-color: var(--fc-accent);
    display: none;
}
.fc-vcard--chosen .fc-vcard__outline { display: flex; }
.fc-vcard--chosen .fc-vcard__name { color: var(--fc-accent); }
.fc-vcard__badge {
    position: absolute; left: var(--fc-space-2); bottom: var(--fc-space-2);
    width: 32px; height: 32px; align-items: center; justify-content: center;
    background-color: var(--fc-accent);
    display: none;
}
.fc-vcard__badge-icon { width: var(--fc-icon-small); height: var(--fc-icon-small); --icon-color: var(--fc-ink); }
.fc-vcard--chosen .fc-vcard__badge { display: flex; }
/* In the deck strip a tap takes the card out: a remove mark on a dark square instead of the check. */
.fc-vcard--removable .fc-vcard__badge { display: flex; background-color: var(--fc-bg); border-top-width: var(--fc-line); border-right-width: var(--fc-line); border-bottom-width: var(--fc-line); border-left-width: var(--fc-line); border-top-color: var(--fc-border-strong); border-right-color: var(--fc-border-strong); border-bottom-color: var(--fc-border-strong); border-left-color: var(--fc-border-strong); }
.fc-vcard--removable .fc-vcard__badge-icon { --icon-color: var(--fc-text); }
.fc-vcard__bar { height: var(--fc-bar); }
.fc-vcard__art { height: var(--fc-card-art); -unity-background-scale-mode: scale-to-fit; background-color: var(--fc-bg-2); }
.fc-vcard__class { position: absolute; left: var(--fc-space-2); top: var(--fc-space-2); width: var(--fc-icon-small); height: var(--fc-icon-small); --icon-color: var(--fc-text-2); }
.fc-vcard__cp {
    position: absolute; right: 0; top: 0;
    flex-direction: row; align-items: center;
    padding: var(--fc-space-1) var(--fc-space-2);
    background-color: var(--fc-bg);
    border-left-width: var(--fc-line); border-bottom-width: var(--fc-line); border-left-color: var(--fc-border-strong); border-bottom-color: var(--fc-border-strong);
}
.fc-vcard__cp-value { -unity-font: var(--fc-font-display); font-size: var(--fc-fs-number-small); color: var(--fc-text); }
.fc-vcard__cp-unit { -unity-font: var(--fc-font-display-semi); font-size: var(--fc-fs-small); color: var(--fc-text-2); margin-left: var(--fc-space-1); }
.fc-vcard__upgrade {
    position: absolute; right: var(--fc-space-2); bottom: var(--fc-space-2);
    width: 32px; height: 32px; align-items: center; justify-content: center;
    background-color: var(--fc-text);
}
.fc-vcard__upgrade > .fc-icon { width: var(--fc-icon-small); height: var(--fc-icon-small); --icon-color: var(--fc-ink); }
.fc-vcard__body { padding: var(--fc-space-2); }
.fc-vcard__name { -unity-font: var(--fc-font-display-semi); font-size: var(--fc-fs-card); letter-spacing: 0.5px; color: var(--fc-text); }
.fc-vcard__level { -unity-font: var(--fc-font-text-medium); font-size: var(--fc-fs-small); color: var(--fc-text-2); margin-top: var(--fc-space-1); }
.fc-vcard__content { transition-property: opacity; transition-duration: 0.1s; }
.fc-vcard--locked .fc-vcard__content { opacity: 0.45; }
.fc-vcard__lock {
    flex-direction: row; align-items: center;
    padding: var(--fc-space-2) var(--fc-space-3);
    border-top-width: var(--fc-line); border-top-color: var(--fc-border);
    display: none;
}
.fc-vcard--locked .fc-vcard__lock { display: flex; }
.fc-vcard__lock > .fc-icon { width: var(--fc-icon-small); height: var(--fc-icon-small); margin-right: var(--fc-space-2); --icon-color: var(--fc-text-2); }
.fc-vcard__lock-text { -unity-font: var(--fc-font-text-medium); font-size: var(--fc-fs-small); color: var(--fc-text); }
/* The compact card: the home screen's deck strip (8 + 2 in a row), name and cost only. */
.fc-vcard--compact { width: var(--fc-card-compact-width); margin-right: var(--fc-space-2); }
.fc-vcard--compact .fc-vcard__art { height: var(--fc-card-compact-art); }
.fc-vcard--compact .fc-vcard__name { font-size: var(--fc-fs-small); }
.fc-vcard--compact .fc-vcard__level { display: none; }
.fc-vcard--compact .fc-vcard__cp-unit { display: none; }
.fc-vcard--compact.fc-vcard--show-level .fc-vcard__level { display: flex; }
.fc-vcard--compact .fc-vcard__body { padding: var(--fc-space-2) var(--fc-space-1); }

/* ---- gear cards: a picture per item type in a rarity frame, the short main stat, the level ---- */
.fc-gcard {
    width: var(--fc-gear-width); flex-shrink: 0;
    background-color: var(--fc-panel-raised);
    border-top-width: var(--fc-bar); border-right-width: var(--fc-line); border-bottom-width: var(--fc-line); border-left-width: var(--fc-line);
    margin-right: var(--fc-space-3); margin-bottom: var(--fc-space-3);
    translate: 0 0;
}
.fc-root .fc-gcard.pressed { translate: 0 var(--fc-press-shift); background-color: var(--fc-panel-selected); scale: 1 1; }
.fc-gcard--chosen { background-color: var(--fc-panel-selected); }
.fc-rarity-0 { border-top-color: var(--fc-rarity-common); border-right-color: var(--fc-rarity-common); border-bottom-color: var(--fc-rarity-common); border-left-color: var(--fc-rarity-common); }
.fc-rarity-1 { border-top-color: var(--fc-rarity-uncommon); border-right-color: var(--fc-rarity-uncommon); border-bottom-color: var(--fc-rarity-uncommon); border-left-color: var(--fc-rarity-uncommon); }
.fc-rarity-2 { border-top-color: var(--fc-rarity-rare); border-right-color: var(--fc-rarity-rare); border-bottom-color: var(--fc-rarity-rare); border-left-color: var(--fc-rarity-rare); }
.fc-rarity-3 { border-top-color: var(--fc-rarity-epic); border-right-color: var(--fc-rarity-epic); border-bottom-color: var(--fc-rarity-epic); border-left-color: var(--fc-rarity-epic); }
.fc-rarity-4 { border-top-color: var(--fc-rarity-legendary); border-right-color: var(--fc-rarity-legendary); border-bottom-color: var(--fc-rarity-legendary); border-left-color: var(--fc-rarity-legendary); }
.fc-gcard__art { height: var(--fc-gear-art); align-items: center; justify-content: center; background-color: var(--fc-bg-2); }
.fc-gcard__picture { width: 88px; height: 88px; -unity-background-scale-mode: scale-to-fit; }
.fc-gcard__level {
    position: absolute; left: 0; top: 0;
    padding: var(--fc-space-1) var(--fc-space-2);
    background-color: var(--fc-bg);
    -unity-font: var(--fc-font-display-semi); font-size: var(--fc-fs-small); color: var(--fc-text);
}
.fc-gcard__equipped { position: absolute; right: var(--fc-space-1); top: var(--fc-space-1); width: var(--fc-icon-small); height: var(--fc-icon-small); --icon-color: var(--fc-text); }
.fc-gcard__body { padding: var(--fc-space-2); }
.fc-gcard__name { -unity-font: var(--fc-font-display-semi); font-size: var(--fc-fs-small); letter-spacing: 0.5px; color: var(--fc-text); }
.fc-gcard__stat { -unity-font: var(--fc-font-text-semi); font-size: var(--fc-fs-small); color: var(--fc-text-2); margin-top: var(--fc-space-1); }
.fc-gcard__compare { -unity-font: var(--fc-font-text-semi); font-size: var(--fc-fs-small); margin-top: var(--fc-space-1); color: var(--fc-text-2); }
.fc-gcard__compare--better { color: var(--fc-positive); }
.fc-gcard__compare--worse { color: var(--fc-danger-text); }
/* The comparison rows beside a picked piece: stat, worn, this one, change. */
.fc-compare-row { flex-direction: row; align-items: center; min-height: 40px; border-bottom-width: var(--fc-line); border-bottom-color: var(--fc-border); }
.fc-compare-row__stat { flex-grow: 1; flex-shrink: 1; }
.fc-compare-row__value { width: 96px; -unity-text-align: middle-right; }

/* ---- progress bars: 3-4 px, a border-coloured track, a text-2 fill; the accent once it is enough */
.fc-progress { height: var(--fc-progress); background-color: var(--fc-border); overflow: hidden; }
.fc-progress__fill { height: 100%; width: 0; background-color: var(--fc-text-2); }
.fc-progress--ready .fc-progress__fill { background-color: var(--fc-accent); }

/* ---- the notification dot: a red 8 px square, only for something to do now ------------------- */
.fc-dot { position: absolute; top: var(--fc-space-2); right: var(--fc-space-2); width: var(--fc-dot); height: var(--fc-dot); background-color: var(--fc-danger); }

/* ---- navigation rail item (the left rail): chosen = selected panel, a 3 px accent bar, accent icon and text */
.fc-nav { width: var(--fc-nav-width); flex-shrink: 0; background-color: var(--fc-bg-2); border-right-width: var(--fc-line); border-right-color: var(--fc-border); }
.fc-nav-item {
    min-height: 92px;
    align-items: center; justify-content: center;
    padding: var(--fc-space-2) var(--fc-space-1);
    border-left-width: var(--fc-bar); border-left-color: var(--fc-clear);
}
.fc-nav-item > .fc-icon { width: var(--fc-nav-icon); height: var(--fc-nav-icon); --icon-color: var(--fc-text-2); }
.fc-nav-item__label { -unity-font: var(--fc-font-display-semi); font-size: var(--fc-fs-small); letter-spacing: 1px; color: var(--fc-text-2); margin-top: var(--fc-space-1); -unity-text-align: middle-center; }
.fc-root .fc-nav-item.pressed { background-color: var(--fc-panel); scale: 1 1; }
.fc-nav-item--selected { background-color: var(--fc-panel-selected); border-left-color: var(--fc-accent); }
.fc-nav-item--selected > .fc-icon { --icon-color: var(--fc-accent); }
.fc-nav-item--selected .fc-nav-item__label { color: var(--fc-accent); }

/* ---- the coin count with its plus -------------------------------------------------------------- */
.fc-currency { flex-direction: row; align-items: center; }
.fc-currency > .fc-icon { width: var(--fc-icon); height: var(--fc-icon); --icon-color: var(--fc-coin); margin-right: var(--fc-space-2); }
.fc-currency__value { -unity-font: var(--fc-font-display-semi); font-size: var(--fc-fs-number-small); color: var(--fc-text); }

/* ---- on/off switch (settings, Auto buy, Support) ------------------------------------------------ */
.fc-toggle { min-height: var(--fc-touch); flex-direction: row; align-items: center; }
.fc-toggle__label { flex-grow: 1; flex-shrink: 1; margin-right: var(--fc-space-4); }
.fc-toggle__track {
    width: var(--fc-switch-width); height: var(--fc-switch-height);
    padding: 0 4px; justify-content: center;
    background-color: var(--fc-panel);
    border-top-width: var(--fc-line); border-right-width: var(--fc-line); border-bottom-width: var(--fc-line); border-left-width: var(--fc-line);
    border-top-color: var(--fc-border-strong); border-right-color: var(--fc-border-strong); border-bottom-color: var(--fc-border-strong); border-left-color: var(--fc-border-strong);
}
.fc-toggle__knob { width: var(--fc-knob); height: var(--fc-knob); background-color: var(--fc-text-2); translate: 0 0; transition-property: translate; transition-duration: 0.1s; }
.fc-toggle__state { -unity-font: var(--fc-font-display-semi); font-size: var(--fc-fs-small); color: var(--fc-text-2); width: 56px; -unity-text-align: middle-right; margin-right: var(--fc-space-3); }
.fc-toggle--on .fc-toggle__track {
    background-color: var(--fc-text);
    border-top-color: var(--fc-text); border-right-color: var(--fc-text); border-bottom-color: var(--fc-text); border-left-color: var(--fc-text);
}
.fc-toggle--on .fc-toggle__knob { background-color: var(--fc-ink); translate: 30px 0; }
.fc-toggle--on .fc-toggle__state { color: var(--fc-text); }

/* ---- the kit preview (debug: -mb-ui-kit) --------------------------------------------------------- */
.fc-preview__top {
    flex-direction: row; align-items: center;
    min-height: 96px; padding: 0 var(--fc-space-4);
    background-color: var(--fc-bg-2);
    border-bottom-width: var(--fc-line); border-bottom-color: var(--fc-border);
}
.fc-preview__title { flex-grow: 1; flex-shrink: 1; }
.fc-preview__main { flex-grow: 1; flex-direction: row; }
.fc-preview__content { flex-grow: 1; flex-shrink: 1; }
.fc-preview__page { padding: var(--fc-space-6); }
.fc-preview__section { margin-bottom: var(--fc-space-7); }
.fc-preview__section-title { margin-bottom: var(--fc-space-3); }
.fc-preview__row { flex-direction: row; flex-wrap: wrap; align-items: flex-start; }
.fc-preview__row > * { margin-right: var(--fc-space-4); margin-bottom: var(--fc-space-4); }
.fc-preview__specimen { align-items: flex-start; }
.fc-preview__specimen-label { margin-bottom: var(--fc-space-1); }
.fc-preview__group { flex-direction: row; align-items: center; margin-left: var(--fc-space-4); }
.fc-preview__group > .fc-caption { margin-right: var(--fc-space-2); }
.fc-swatch { width: 240px; margin-right: var(--fc-space-3); margin-bottom: var(--fc-space-3); padding: var(--fc-space-2); background-color: var(--fc-panel-raised); }
/* The preview swatches: each paints its token (the colour comes from here, not from code). */
.fc-swatch--fc-bg { background-color: var(--fc-bg); }
.fc-swatch--fc-bg-2 { background-color: var(--fc-bg-2); }
.fc-swatch--fc-panel { background-color: var(--fc-panel); }
.fc-swatch--fc-panel-raised { background-color: var(--fc-panel-raised); }
.fc-swatch--fc-panel-selected { background-color: var(--fc-panel-selected); }
.fc-swatch--fc-panel-field { background-color: var(--fc-panel-field); }
.fc-swatch--fc-border { background-color: var(--fc-border); }
.fc-swatch--fc-border-strong { background-color: var(--fc-border-strong); }
.fc-swatch--fc-text { background-color: var(--fc-text); }
.fc-swatch--fc-text-2 { background-color: var(--fc-text-2); }
.fc-swatch--fc-text-dim { background-color: var(--fc-text-dim); }
.fc-swatch--fc-accent { background-color: var(--fc-accent); }
.fc-swatch--fc-accent-press { background-color: var(--fc-accent-press); }
.fc-swatch--fc-coin { background-color: var(--fc-coin); }
.fc-swatch--fc-danger { background-color: var(--fc-danger); }
.fc-swatch--fc-danger-text { background-color: var(--fc-danger-text); }
.fc-swatch--fc-positive { background-color: var(--fc-positive); }
.fc-swatch--fc-ally { background-color: var(--fc-ally); }
.fc-swatch--fc-enemy { background-color: var(--fc-enemy); }
.fc-swatch--fc-branch-armor { background-color: var(--fc-branch-armor); }
.fc-swatch--fc-branch-light { background-color: var(--fc-branch-light); }
.fc-swatch--fc-branch-artillery { background-color: var(--fc-branch-artillery); }
.fc-swatch--fc-branch-air { background-color: var(--fc-branch-air); }
.fc-swatch--fc-branch-support { background-color: var(--fc-branch-support); }
.fc-swatch--fc-rarity-common { background-color: var(--fc-rarity-common); }
.fc-swatch--fc-rarity-uncommon { background-color: var(--fc-rarity-uncommon); }
.fc-swatch--fc-rarity-rare { background-color: var(--fc-rarity-rare); }
.fc-swatch--fc-rarity-epic { background-color: var(--fc-rarity-epic); }
.fc-swatch--fc-rarity-legendary { background-color: var(--fc-rarity-legendary); }
.fc-swatch__colour { height: 44px; border-top-width: var(--fc-line); border-right-width: var(--fc-line); border-bottom-width: var(--fc-line); border-left-width: var(--fc-line); border-top-color: var(--fc-border-strong); border-right-color: var(--fc-border-strong); border-bottom-color: var(--fc-border-strong); border-left-color: var(--fc-border-strong); }
.fc-type-row { flex-direction: row; align-items: center; margin-bottom: var(--fc-space-2); }
.fc-type-row__name { width: 220px; }
.fc-sample__top { flex-direction: row; align-items: center; min-height: 96px; padding: 0 var(--fc-space-4); background-color: var(--fc-bg-2); border-bottom-width: var(--fc-line); border-bottom-color: var(--fc-border); }
.fc-sample__rank { flex-direction: row; align-items: center; flex-grow: 1; flex-shrink: 1; }
.fc-sample__rank > .fc-icon { width: 36px; height: 36px; margin-right: var(--fc-space-3); }
.fc-sample__xp { width: 160px; margin-top: var(--fc-space-1); }
.fc-sample__body { flex-direction: row; flex-grow: 1; }
.fc-sample__column { flex-grow: 1; flex-shrink: 1; flex-basis: 0; min-width: 0; padding: var(--fc-space-4); }
.fc-sample__side { width: 440px; flex-shrink: 0; padding: var(--fc-space-4); }
.fc-sample__side-scroll { flex-grow: 1; flex-shrink: 1; }
.fc-sample__deck { flex-grow: 0; flex-shrink: 0; margin-top: var(--fc-space-2); }
.fc-sample__deck .unity-scroll-view__content-container { flex-direction: row; }
.fc-sample__column--end { justify-content: flex-end; }
.fc-text-large .fc-sample__modes { flex-direction: column; }
.fc-preview__row--center { align-items: center; }
.fc-preview__nav-row { flex-direction: row; width: auto; align-self: flex-start; border-right-width: 0; }
.fc-preview__nav-row > .fc-nav-item { width: var(--fc-nav-width); }
.fc-preview__w-wide { width: 460px; }
.fc-preview__w-narrow { width: 280px; }
.fc-preview__w-toggle { width: 380px; }
.fc-preview__w-compare { width: 560px; }
.fc-preview__w-panel { width: 360px; }
.fc-vcard__art { align-items: center; justify-content: center; }
.fc-vcard__fallback { width: 72px; height: 72px; --icon-color: var(--fc-text-2); }

/* ---- layout helpers on the spacing scale ---------------------------------------------------------- */
.fc-grow { flex-grow: 1; flex-shrink: 1; }
.fc-nowrap { flex-wrap: nowrap; }
.fc-self-start { align-self: flex-start; }
.fc-mt-1 { margin-top: var(--fc-space-1); }
.fc-mt-2 { margin-top: var(--fc-space-2); }
.fc-mt-3 { margin-top: var(--fc-space-3); }
.fc-mt-4 { margin-top: var(--fc-space-4); }
.fc-ml-2 { margin-left: var(--fc-space-2); }
.fc-ml-4 { margin-left: var(--fc-space-4); }
.fc-keep { flex-shrink: 0; }
.fc-preview__specimen > .fc-nav-item { width: var(--fc-nav-width); }
.fc-scroll .unity-scroll-view__content-container { width: 100%; }

/* ---- kit variants the screens need ---------------------------------------------------------------- */
.fc-rarity-text-0 { color: var(--fc-rarity-common); }
.fc-rarity-text-1 { color: var(--fc-rarity-uncommon); }
.fc-rarity-text-2 { color: var(--fc-rarity-rare); }
.fc-rarity-text-3 { color: var(--fc-rarity-epic); }
.fc-rarity-text-4 { color: var(--fc-rarity-legendary); }
.fc-vcard--empty {
    min-height: 180px; align-items: center; justify-content: center;
    border-top-width: var(--fc-line); border-top-color: var(--fc-border);
    background-color: var(--fc-bg-2);
}
.fc-vcard__plus { width: 36px; height: 36px; --icon-color: var(--fc-text-2); }
.fc-gcard--empty { border-top-color: var(--fc-border); border-right-color: var(--fc-border); border-bottom-color: var(--fc-border); border-left-color: var(--fc-border); border-top-width: var(--fc-line); min-height: 150px; }
.fc-gcard--unfit { opacity: 0.45; }
.fc-portrait { width: 88px; height: 88px; flex-shrink: 0; margin-right: var(--fc-space-3); -unity-background-scale-mode: scale-and-crop; background-color: var(--fc-bg-2); border-top-width: var(--fc-line); border-right-width: var(--fc-line); border-bottom-width: var(--fc-line); border-left-width: var(--fc-line); border-top-color: var(--fc-border-strong); border-right-color: var(--fc-border-strong); border-bottom-color: var(--fc-border-strong); border-left-color: var(--fc-border-strong); }
.fc-portrait--small { width: 56px; height: 56px; }
.fc-star { width: var(--fc-icon-small); height: var(--fc-icon-small); --icon-color: var(--fc-border-strong); }
.fc-star--on { --icon-color: var(--fc-coin); }
.fc-stars { flex-direction: row; }
.fc-rule-icon { width: var(--fc-icon-small); height: var(--fc-icon-small); --icon-color: var(--fc-text-2); }
.fc-paint { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }

/* ---- prompt 15: armour and weapon icons (KitCombat) ------------------------------------------------ */
.fc-cicon { width: var(--fc-cicon); height: var(--fc-cicon); --icon-color: var(--fc-text); }
.fc-cicon--large { width: var(--fc-cicon-large); height: var(--fc-cicon-large); }
.fc-crow { flex-direction: row; align-items: center; height: var(--fc-cicon); flex-shrink: 0; margin-top: var(--fc-space-1); }
.fc-crow > .fc-cicon, .fc-crow > .fc-wchip { margin-right: 2px; }
.fc-vcard__combat { margin-left: -4px; margin-right: -4px; }
.fc-vcard--compact .fc-vcard__combat { margin-left: -2px; margin-right: -2px; }
.fc-crow__more { flex-shrink: 0; white-space: nowrap; padding: 0 2px; }
.fc-wchip { width: var(--fc-cicon); height: var(--fc-cicon); flex-shrink: 0; }
.fc-wchip--large { width: var(--fc-cicon-large); height: var(--fc-cicon-large); }
.fc-wchip__form { position: absolute; left: 0; top: 0; right: 0; bottom: 0; --icon-color: var(--fc-text); }
.fc-wchip__mark {
    position: absolute; right: -3px; bottom: -3px; width: var(--fc-cmark); height: var(--fc-cmark);
    background-color: var(--fc-chip-bg); padding: 1px;
}
.fc-wchip--large > .fc-wchip__mark { width: var(--fc-cmark-large); height: var(--fc-cmark-large); right: -4px; bottom: -4px; }
.fc-wchip__mark-icon { flex-grow: 1; --icon-color: var(--fc-text); }
.fc-wchip-group { align-items: center; flex-shrink: 0; }
.fc-wchip-group > .fc-wchip { margin-right: var(--fc-space-2); }
.fc-xmark { width: var(--fc-cmark-large); height: var(--fc-cmark-large); margin-right: var(--fc-space-1); --icon-color: var(--fc-text-2); }
.fc-xmark--large { width: var(--fc-cicon); height: var(--fc-cicon); }

.fc-armour { flex-direction: row; align-items: center; flex-shrink: 0; margin-bottom: var(--fc-space-3); }
.fc-armour__diagram { width: var(--fc-armour-diagram); height: var(--fc-armour-diagram); flex-shrink: 0; margin-right: var(--fc-space-4); --icon-color: var(--fc-text); }
.fc-armour__legend { flex-grow: 1; flex-shrink: 1; }
.fc-armour__line { align-items: center; margin-bottom: var(--fc-space-1); }
.fc-armour__line > .fc-cicon { margin-right: var(--fc-space-2); }
.fc-armour__words { flex-shrink: 1; }

.fc-effect { flex-shrink: 0; margin-top: var(--fc-space-3); }
.fc-effect__row { align-items: center; min-height: var(--fc-cicon); margin-bottom: var(--fc-space-2); }
.fc-effect__head { margin-bottom: var(--fc-space-2); }
.fc-effect__weapon { width: var(--fc-effect-weapon); flex-shrink: 0; }
.fc-effect__cell { flex-grow: 1; flex-basis: 0; align-items: center; justify-content: center; padding: 0 var(--fc-space-1); }
.fc-effect__track { width: 100%; height: 10px; background-color: var(--fc-border); }
.fc-effect__bar { height: 100%; background-color: var(--fc-text); }
.fc-effect__num { margin-top: 2px; }

.fc-strongweak { flex-shrink: 0; margin-top: var(--fc-space-2); }
.fc-strongweak__line { align-items: center; flex-wrap: wrap; margin-bottom: var(--fc-space-2); }
.fc-strongweak__line > .fc-cicon, .fc-strongweak__line > .fc-wchip { margin-right: var(--fc-space-2); }
.fc-strongweak__label { width: 130px; flex-shrink: 0; }

.fc-cover { align-items: center; flex-shrink: 0; }
.fc-cover__cell { margin-right: var(--fc-space-1); }
.fc-cover__cell--missing > .fc-cicon { --icon-color: var(--fc-danger); opacity: 0.55; }
.fc-cover__strike {
    position: absolute; left: 2px; right: 2px; top: 50%; height: 2px; margin-top: -1px;
    background-color: var(--fc-danger); rotate: -35deg;
}

.fc-verdict { width: var(--fc-cmark-large); height: var(--fc-cmark-large); margin-right: var(--fc-space-1); --icon-color: var(--fc-text); }
.fc-verdict--poor { --icon-color: var(--fc-text-2); }
.fc-verdict--none { --icon-color: var(--fc-danger); }

.fc-enemytip { padding: var(--fc-space-2) var(--fc-space-3); width: 300px; }
.fc-enemytip__head { align-items: center; margin-bottom: var(--fc-space-1); }
.fc-enemytip__head > .fc-cicon { margin-right: var(--fc-space-2); }
.fc-enemytip__grid { flex-direction: row; flex-wrap: wrap; }
.fc-enemytip__cell { width: 100%; align-items: center; min-height: 28px; }
