/* Field Command 2.0: the screens' layout on the kit (Tokens.uss). Colours, fonts, type sizes and
   spacing come from the tokens only (UiThemeTests checks this file like the kit's rules); what is
   written here is where things sit and how wide the columns are. Panel pixels at 1280 x 720.
   BattleHud loads it on the HUD's root after Hud.uss, not from the theme: UI Toolkit counts a sheet
   the theme imports as a default sheet, which loses to Hud.uss whatever the selectors. */

/* ================================================================ menu chrome: top bar, left rail, pages */
.fc-menu { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.fc-backdrop { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: var(--fc-bg); }
.fc-home-scrim { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: var(--fc-scrim-home); }
.fc-top {
    position: absolute; left: 0; top: 0; right: 0; height: var(--fc-topbar);
    flex-direction: row; align-items: center;
    padding: 0 var(--fc-space-4) 0 var(--fc-space-2);
    background-color: var(--fc-panel-field);
    border-bottom-width: var(--fc-line); border-bottom-color: var(--fc-border);
}
.fc-top__lead { flex-direction: row; align-items: center; flex-grow: 1; flex-shrink: 1; }
.fc-top__logo { flex-direction: row; align-items: center; padding-left: var(--fc-space-3); }
.fc-top__logo > .fc-icon { width: 36px; height: 36px; margin-right: var(--fc-space-3); --icon-color: var(--fc-text); }
.fc-top__brand { -unity-font: var(--fc-font-display); font-size: var(--fc-fs-title); letter-spacing: 3px; color: var(--fc-text); }
.fc-top__title { margin-left: var(--fc-space-3); }
.fc-top__rank { flex-direction: row; align-items: center; margin-right: var(--fc-space-6); }
.fc-top__rank > .fc-icon { width: 34px; height: 34px; margin-right: var(--fc-space-3); --icon-color: var(--fc-text); }
.fc-top__rank-text { width: 250px; }
.fc-top__xp { margin-top: var(--fc-space-1); }
.fc-top__xp-text { margin-top: var(--fc-space-1); }
.fc-top__gear { margin-left: var(--fc-space-4); }
.fc-menu-nav { position: absolute; left: 0; top: var(--fc-topbar); bottom: 0; padding-top: var(--fc-space-2); }
.fc-page { position: absolute; left: var(--fc-nav-width); top: var(--fc-topbar); right: 0; bottom: 0; }
.fc-page--full { left: 0; }
.fc-page--opaque { background-color: var(--fc-bg); }
.fc-page__scroll { flex-grow: 1; flex-shrink: 1; flex-basis: 0; }
.fc-page__body { padding: var(--fc-space-5) var(--fc-space-6) var(--fc-space-7) var(--fc-space-6); }
.fc-page__head { flex-direction: row; align-items: center; justify-content: space-between; padding: var(--fc-space-4) var(--fc-space-6) 0 var(--fc-space-6); }
.fc-section { margin-bottom: var(--fc-space-6); }
.fc-section__title { margin-bottom: var(--fc-space-3); }
.fc-row { flex-direction: row; align-items: center; }
.fc-row--wrap { flex-wrap: wrap; }
.fc-row--top { align-items: flex-start; }
.fc-row--spread { justify-content: space-between; }
.fc-col { flex-direction: column; }
.fc-gap-2 > * { margin-right: var(--fc-space-2); }
.fc-gap-3 > * { margin-right: var(--fc-space-3); }
.fc-mb-2 { margin-bottom: var(--fc-space-2); }
.fc-mb-3 { margin-bottom: var(--fc-space-3); }
.fc-mb-4 { margin-bottom: var(--fc-space-4); }
.fc-mt-5 { margin-top: var(--fc-space-5); }
.fc-mt-6 { margin-top: var(--fc-space-6); }
.fc-toast-host { bottom: var(--fc-space-7); }

/* ================================================================ E1 home: the battle behind, the campaign and the dailies on the right, the deck and Deploy below */
.fc-home__right {
    position: absolute; right: var(--fc-space-4); top: var(--fc-space-4); bottom: var(--fc-space-4); width: var(--fc-home-column);
}
.fc-home__right-scroll { flex-grow: 1; flex-shrink: 1; }
.fc-home__launch { margin-top: var(--fc-space-3); flex-shrink: 0; }
.fc-home__grid { flex-direction: row; flex-wrap: wrap; justify-content: space-between; }
.fc-home__grid > .fc-dropdown { width: 49%; margin-bottom: var(--fc-space-2); }
/* Large text: one dropdown a row (two did not hold "Conquest" at 13 pt Large). */
.fc-text-large .fc-home__grid > .fc-dropdown { width: 100%; }
/* The base set in the home's deck panel: three small chips. */
.fc-home__plans { flex-direction: row; align-items: center; flex-shrink: 1; }
.fc-home__plans > .fc-caption { margin-right: var(--fc-space-2); }
.fc-home__plans > .fc-chip { margin-right: var(--fc-space-1); }
.fc-home__plans .fc-chip__face { padding: 0 var(--fc-space-2); min-height: 48px; }
.fc-home__deck {
    position: absolute; left: var(--fc-space-4); bottom: var(--fc-space-4); right: 472px;
    padding: var(--fc-space-3) var(--fc-space-4);
}
.fc-home__deck-head { flex-direction: row; align-items: center; justify-content: space-between; }
.fc-home__deck-strip { margin-top: var(--fc-space-2); }
.fc-home__deck-strip .unity-scroll-view__content-container { flex-direction: row; align-items: stretch; }
.fc-deck-divider { width: var(--fc-line); height: 120px; margin: var(--fc-space-4) var(--fc-space-3) 0 var(--fc-space-1); background-color: var(--fc-border-strong); }
.fc-campaign-card { padding: var(--fc-space-4); }
.fc-campaign-card__unlocks { flex-direction: row; flex-wrap: wrap; margin-top: var(--fc-space-2); }
.fc-campaign-card__progress { flex-direction: row; align-items: center; margin-top: var(--fc-space-3); }
.fc-campaign-card__progress > .fc-progress { flex-grow: 1; margin-right: var(--fc-space-3); }
.fc-daily { margin-top: var(--fc-space-3); }
.fc-daily__head { flex-direction: row; flex-wrap: wrap; align-items: center; justify-content: space-between; margin-bottom: var(--fc-space-2); }
.fc-daily__row { flex-direction: row; align-items: center; padding: var(--fc-space-2) 0; border-top-width: var(--fc-line); border-top-color: var(--fc-border); }
.fc-daily__text { flex-grow: 1; flex-shrink: 1; margin-right: var(--fc-space-3); }
.fc-daily__text > .fc-progress { margin-top: var(--fc-space-2); }
.fc-daily__side { align-items: flex-end; flex-shrink: 0; }
.fc-tag {
    flex-direction: row; align-items: center; flex-shrink: 0;
    padding: var(--fc-space-1) var(--fc-space-2); margin: 0 var(--fc-space-2) var(--fc-space-2) 0;
    background-color: var(--fc-bg-2);
    border-top-width: var(--fc-line); border-right-width: var(--fc-line); border-bottom-width: var(--fc-line); border-left-width: var(--fc-line);
    border-top-color: var(--fc-border); border-right-color: var(--fc-border); border-bottom-color: var(--fc-border); border-left-color: var(--fc-border);
}
.fc-tag > .fc-icon { width: var(--fc-icon-small); height: var(--fc-icon-small); margin-right: var(--fc-space-2); --icon-color: var(--fc-text-2); }
.fc-tag--ok > .fc-icon { --icon-color: var(--fc-positive); }
.fc-tag--missing { border-top-color: var(--fc-danger); border-right-color: var(--fc-danger); border-bottom-color: var(--fc-danger); border-left-color: var(--fc-danger); }
.fc-tag--missing > .fc-icon { --icon-color: var(--fc-danger); }

/* ================================================================ E11 settings */
.fc-settings { width: 100%; }
.fc-setting {
    flex-direction: row; align-items: center; flex-wrap: wrap;
    padding: var(--fc-space-1) var(--fc-space-4);
    border-bottom-width: var(--fc-line); border-bottom-color: var(--fc-border);
}
.fc-setting > .fc-icon { width: var(--fc-icon); height: var(--fc-icon); margin-right: var(--fc-space-3); --icon-color: var(--fc-text-2); }
.fc-setting__label { width: 300px; flex-shrink: 1; margin-right: var(--fc-space-3); }
.fc-setting__choices { flex-direction: row; flex-wrap: wrap; flex-grow: 1; flex-shrink: 1; }
.fc-setting__value { width: 96px; -unity-text-align: middle-center; }
.fc-setting__tag { margin-right: var(--fc-space-3); }
.fc-tag--boss { border-top-color: var(--fc-danger); border-right-color: var(--fc-danger); border-bottom-color: var(--fc-danger); border-left-color: var(--fc-danger); }
.fc-tag--boss > .fc-icon { --icon-color: var(--fc-danger); }
.fc-tag--operation > .fc-icon { --icon-color: var(--fc-text); }

/* ================================================================ E2 campaign: the chapters, then a chapter's missions */
.fc-campaign__act { margin: var(--fc-space-3) 0 var(--fc-space-2) 0; }
.fc-campaign__chapters { flex-direction: row; flex-wrap: wrap; }
.fc-chapter {
    width: 32%; margin-right: 1%; margin-bottom: var(--fc-space-3);
    background-color: var(--fc-panel-raised);
    border-top-width: var(--fc-line); border-right-width: var(--fc-line); border-bottom-width: var(--fc-line); border-left-width: var(--fc-line);
    border-top-color: var(--fc-border-strong); border-right-color: var(--fc-border-strong); border-bottom-color: var(--fc-border-strong); border-left-color: var(--fc-border-strong);
}
.fc-root .fc-chapter.pressed { background-color: var(--fc-panel-selected); }
.fc-chapter__art { height: 120px; -unity-background-scale-mode: scale-and-crop; background-color: var(--fc-bg-2); }
.fc-chapter__number {
    position: absolute; left: 0; top: 0; padding: var(--fc-space-1) var(--fc-space-3);
    background-color: var(--fc-bg);
}
.fc-chapter__lock {
    position: absolute; left: 0; top: 0; right: 0; bottom: 0; align-items: center; justify-content: center;
    background-color: var(--fc-scrim);
}
.fc-chapter__lock > .fc-icon { width: 36px; height: 36px; }
.fc-chapter__body { padding: var(--fc-space-3); }
.fc-chapter--locked .fc-chapter__body > .fc-panel-title { color: var(--fc-text-2); }

.fc-campaign__chapter { position: absolute; left: 0; top: 0; right: 0; bottom: 0; flex-direction: row; }
.fc-campaign__list { width: 440px; flex-shrink: 0; padding: var(--fc-space-3) 0 var(--fc-space-3) var(--fc-space-4); }
.fc-campaign__detail { flex-grow: 1; flex-shrink: 1; margin: var(--fc-space-3) var(--fc-space-4); }
.fc-campaign__detail-scroll { flex-grow: 1; flex-shrink: 1; }
.fc-campaign__detail-body { padding: var(--fc-space-4) var(--fc-space-5); }
.fc-campaign__art { height: 150px; margin-bottom: var(--fc-space-3); -unity-background-scale-mode: scale-and-crop; background-color: var(--fc-bg-2); }
.fc-campaign__start { margin: var(--fc-space-3) var(--fc-space-5) var(--fc-space-4) var(--fc-space-5); }
.fc-mission {
    min-height: var(--fc-touch);
    flex-direction: row; align-items: center;
    padding: var(--fc-space-2) var(--fc-space-3);
    margin-right: var(--fc-space-3);
    border-bottom-width: var(--fc-line); border-bottom-color: var(--fc-border);
    border-left-width: var(--fc-bar); border-left-color: var(--fc-clear);
}
.fc-root .fc-mission.pressed { background-color: var(--fc-panel); }
.fc-mission--chosen { background-color: var(--fc-panel-selected); border-left-color: var(--fc-text); }
.fc-mission--locked .fc-mission__text > .fc-body { color: var(--fc-text-2); }
.fc-mission__number { width: 56px; flex-shrink: 0; }
.fc-mission__icon { width: var(--fc-icon); height: var(--fc-icon); margin-right: var(--fc-space-3); --icon-color: var(--fc-text-2); }
.fc-mission__text { flex-grow: 1; flex-shrink: 1; }
.fc-mission__text > .fc-row { margin-top: var(--fc-space-1); }
.fc-mission__side { align-items: flex-end; flex-shrink: 0; margin-left: var(--fc-space-2); }
.fc-mission__lock { width: var(--fc-icon); height: var(--fc-icon); --icon-color: var(--fc-text-2); }
.fc-briefing { flex-direction: row; align-items: flex-start; margin-top: var(--fc-space-4); padding: var(--fc-space-3); background-color: var(--fc-bg-2); }
.fc-briefing__text { flex-grow: 1; flex-shrink: 1; }

/* The story card: chapter openings, briefings, the epilogue. */
.fc-story { width: 760px; max-width: 94%; max-height: 94%; flex-direction: row; }
.fc-story__art { width: 260px; flex-shrink: 0; -unity-background-scale-mode: scale-and-crop; background-color: var(--fc-bg-2); }
.fc-story__column { flex-grow: 1; flex-shrink: 1; }
.fc-story__scroll { flex-grow: 1; flex-shrink: 1; }
.fc-story__main { padding: var(--fc-space-5) var(--fc-space-6) var(--fc-space-2) var(--fc-space-6); }
.fc-story__buttons { flex-shrink: 0; padding: var(--fc-space-2) var(--fc-space-6) var(--fc-space-5) var(--fc-space-6); }
.fc-story__who { flex-direction: row; align-items: center; margin: var(--fc-space-3) 0; }
.fc-story__aside { flex-direction: row; align-items: center; margin-top: var(--fc-space-3); padding: var(--fc-space-2); background-color: var(--fc-bg-2); }

/* The Dossier. */
.fc-dossier__entry { flex-direction: row; align-items: flex-start; padding: var(--fc-space-3); margin-bottom: var(--fc-space-2); }
.fc-dossier__entry--enemy { border-left-width: var(--fc-bar); border-left-color: var(--fc-enemy); }
.fc-dossier__entry--locked .fc-portrait { opacity: 0.45; }
.fc-dossier__text { flex-grow: 1; flex-shrink: 1; }

/* ================================================================ E8 operations */
.fc-ops { flex-direction: row; }
.fc-ops__list { width: 440px; flex-shrink: 0; padding: var(--fc-space-3) 0 var(--fc-space-3) var(--fc-space-4); }
.fc-ops__card { flex-direction: row; margin: 0 var(--fc-space-3) var(--fc-space-2) 0; min-height: var(--fc-touch); }
.fc-root .fc-ops__card.pressed { background-color: var(--fc-panel-selected); }
.fc-ops__card--chosen { background-color: var(--fc-panel-selected); border-left-width: var(--fc-bar); border-left-color: var(--fc-text); }
.fc-ops__art { width: 128px; flex-shrink: 0; -unity-background-scale-mode: scale-and-crop; background-color: var(--fc-bg-2); align-items: center; justify-content: center; }
.fc-ops__art-icon { width: 40px; height: 40px; --icon-color: var(--fc-text-2); }
.fc-ops__text { flex-grow: 1; flex-shrink: 1; padding: var(--fc-space-2) var(--fc-space-3); }
.fc-ops__detail { flex-grow: 1; flex-shrink: 1; margin: var(--fc-space-3) var(--fc-space-4); }
.fc-ops__detail-scroll { flex-grow: 1; flex-shrink: 1; }
.fc-ops__detail-body { padding: var(--fc-space-4) var(--fc-space-5); }
.fc-ops__start { margin: var(--fc-space-3) var(--fc-space-5) var(--fc-space-4) var(--fc-space-5); }

/* ================================================================ E3 / E5 / E6 army */
.fc-army__deck-strip { flex-shrink: 0; margin-bottom: var(--fc-space-3); }
.fc-army__deck-strip .unity-scroll-view__content-container { flex-direction: row; align-items: stretch; }
.fc-army__overview { flex-direction: row; align-items: flex-start; margin-bottom: var(--fc-space-2); }
.fc-army__overview-part { margin-right: var(--fc-space-6); flex-shrink: 1; }
.fc-army__doctrine { width: 340px; flex-shrink: 0; }
.fc-army__collection { margin-top: var(--fc-space-3); }
/* Cards in a row are one height (prompt 11 B2): the tallest (a locked card with its unlock line) sets it. */
.fc-army__grid { flex-direction: row; flex-wrap: wrap; align-items: stretch; }
.fc-army__gear { position: absolute; left: 0; top: var(--fc-tab); right: 0; bottom: 0; flex-direction: row; }
.fc-army__gear-left { flex-grow: 1; flex-shrink: 1; }
.fc-army__gear-right { width: 520px; flex-shrink: 0; margin: var(--fc-space-3) var(--fc-space-4); padding: var(--fc-space-3); }
.fc-army__gear-info { flex-shrink: 0; margin-bottom: var(--fc-space-3); }
.fc-army__gear-list { flex-grow: 1; flex-shrink: 1; }
.fc-army__slots { margin-top: var(--fc-space-3); }
.fc-army__slot { margin-right: var(--fc-space-1); }
.fc-army__slot > .fc-caption { margin-bottom: var(--fc-space-1); }
/* A slot's card fills its cell, so an empty slot is as tall as a worn one beside it (prompt 11 B2). */
.fc-army__slot > .fc-gcard { flex-grow: 1; }
.fc-army__base { position: absolute; left: 0; top: var(--fc-tab); right: 0; bottom: 0; }
.fc-gear-lines { margin-top: var(--fc-space-2); }
.fc-gear-line { flex-direction: row; align-items: center; margin-bottom: var(--fc-space-1); }
.fc-gear-line__roll { width: 72px; margin-left: var(--fc-space-3); }

/* ================================================================ E4 vehicle detail */
.fc-detail { flex-direction: row; }
.fc-detail__left { width: var(--fc-detail-column); flex-shrink: 0; }
.fc-detail__left-scroll { flex-grow: 1; flex-shrink: 1; flex-basis: 0; }
.fc-detail__left-body { padding: var(--fc-space-4) var(--fc-space-5); }
.fc-detail__stage { height: var(--fc-detail-stage); margin-bottom: var(--fc-space-2); background-color: var(--fc-bg-2); }
.fc-detail__art { position: absolute; left: 0; top: 0; right: 0; bottom: 0; -unity-background-scale-mode: scale-to-fit; }
.fc-detail__preview { position: absolute; left: 0; top: 0; right: 0; bottom: 0; -unity-background-scale-mode: scale-and-crop; }
/* The name with the arrows beside it (small faces in full touch targets), off the picture. */
.fc-detail__head { align-items: center; }
.fc-detail__head > .fc-icon-btn { flex-shrink: 0; }
.fc-detail__previous > .fc-icon-btn__face { rotate: 180deg; }
.fc-detail__right { flex-grow: 1; flex-shrink: 1; }
/* The In action tab: a theatre. The preview fills the space under the tabs; the name, the weapons,
   the deck toggle and the dock (blueprints over the level-up) stand in the side column. */
.fc-detail--theatre .fc-detail__left { width: var(--fc-detail-side); border-right-width: var(--fc-line); border-right-color: var(--fc-border); }
.fc-detail--theatre .fc-detail__stage { height: auto; flex-grow: 1; flex-shrink: 1; margin: var(--fc-space-3) var(--fc-space-4); }
.fc-detail--theatre .fc-detail__body-scroll, .fc-detail--theatre .fc-detail__tags, .fc-detail--theatre .fc-detail__counters { display: none; }
.fc-detail--theatre .fc-detail__left-body > .fc-page__body { padding: var(--fc-space-2) 0 0 0; }
.fc-detail--theatre .fc-detail__dock { flex-direction: column; align-items: stretch; }
.fc-detail--theatre .fc-detail__dock > * { margin-right: 0; }
.fc-detail--theatre .fc-detail__prints { flex-grow: 0; margin-bottom: var(--fc-space-3); }
.fc-detail__dock {
    flex-direction: row; align-items: center; flex-wrap: nowrap;
    padding: var(--fc-space-3) var(--fc-space-5);
    background-color: var(--fc-bg-2);
    border-top-width: var(--fc-line); border-top-color: var(--fc-border);
}
.fc-detail__dock > * { margin-right: var(--fc-space-3); }
.fc-detail__prints { flex-grow: 1; flex-shrink: 1; }
.fc-detail__prints > .fc-progress { margin-top: var(--fc-space-2); }
.fc-legend { margin: 0 var(--fc-space-4) var(--fc-space-1) 0; }
.fc-legend__swatch { width: 16px; height: 10px; margin-right: var(--fc-space-2); }
.fc-stat { margin-bottom: var(--fc-space-3); }
.fc-stat__name { width: 220px; flex-shrink: 1; }
.fc-stat__gain { margin-left: var(--fc-space-3); }
.fc-statbar { height: 8px; margin-top: var(--fc-space-1); background-color: var(--fc-border); }
.fc-statbar__next, .fc-statbar__boost, .fc-statbar__base { position: absolute; left: 0; top: 0; bottom: 0; }
.fc-statbar__next { background-color: var(--fc-border-strong); }
.fc-statbar__boost { background-color: var(--fc-text); }
.fc-statbar__base { background-color: var(--fc-text-2); }
.fc-statbar__avg { position: absolute; top: -3px; bottom: -3px; width: 2px; margin-left: -1px; background-color: var(--fc-positive); }
.fc-legend__swatch.fc-statbar__avg { position: relative; top: 0; bottom: 0; width: 4px; height: 12px; margin-left: 0; }
.fc-legend__swatch.fc-statbar__next, .fc-legend__swatch.fc-statbar__boost, .fc-legend__swatch.fc-statbar__base { position: relative; }
.fc-weapon { flex-direction: row; align-items: flex-start; padding: var(--fc-space-3); margin-bottom: var(--fc-space-2); }
.fc-weapon--chosen { background-color: var(--fc-panel-selected); border-top-color: var(--fc-text); border-right-color: var(--fc-text); border-bottom-color: var(--fc-text); border-left-color: var(--fc-text); }
.fc-menu.menu .base-info { margin-left: var(--fc-space-2); flex-shrink: 0; }
.fc-weapon__icon { width: 36px; height: 36px; margin-right: var(--fc-space-3); --icon-color: var(--fc-text-2); }

/* ================================================================ E9 shop */
.fc-shop__grid { flex-direction: row; flex-wrap: wrap; align-items: flex-start; }
.fc-shop__tile { width: 32%; margin: 0 1% var(--fc-space-3) 0; }
.fc-root .fc-shop__tile.pressed { background-color: var(--fc-panel-selected); }
.fc-shop__tile--chosen { background-color: var(--fc-panel-selected); border-top-color: var(--fc-text); border-right-color: var(--fc-text); border-bottom-color: var(--fc-text); border-left-color: var(--fc-text); }
.fc-shop__art { height: 150px; align-items: center; justify-content: center; -unity-background-scale-mode: scale-to-fit; background-color: var(--fc-bg-2); }
.fc-shop__art-icon { width: 64px; height: 64px; --icon-color: var(--fc-text-2); }
.fc-shop__body { padding: var(--fc-space-3); }
.fc-shop__price { margin-top: var(--fc-space-2); }
.fc-shop__buttons { margin-top: var(--fc-space-2); }
.fc-shop__dock {
    flex-direction: row; justify-content: flex-end;
    padding: var(--fc-space-3) var(--fc-space-5);
    background-color: var(--fc-bg-2);
    border-top-width: var(--fc-line); border-top-color: var(--fc-border);
}
.fc-rarity-frame-1 { border-top-width: var(--fc-bar); border-top-color: var(--fc-rarity-common); }
.fc-rarity-frame-2 { border-top-width: var(--fc-bar); border-top-color: var(--fc-rarity-rare); }
.fc-rarity-frame-3 { border-top-width: var(--fc-bar); border-top-color: var(--fc-rarity-epic); }
.fc-rarity-frame-4 { border-top-width: var(--fc-bar); border-top-color: var(--fc-rarity-legendary); }
.fc-sheet { width: 720px; }
.fc-page > .fc-tabs { flex-shrink: 0; }

/* ================================================================ prompt 14: the Base and Outpost screens */
/* The bar along the top, the tray, the map and the panel side by side, the cover strip along the bottom. The
   slots sit on the map at their real places: a transparent 44 pt target round a face sized by class. */
.fc-base { flex-direction: column; padding: var(--fc-space-2) var(--fc-space-3); }
.fc-base__bar { flex-direction: row; align-items: center; flex-wrap: wrap; flex-shrink: 0; margin-bottom: var(--fc-space-1); }
.fc-base__hq { flex-direction: row; align-items: center; width: 320px; flex-shrink: 1; margin-right: var(--fc-space-3); }
.fc-base__hq-icon { width: var(--fc-icon); height: var(--fc-icon); margin-right: var(--fc-space-2); flex-shrink: 0; }
.fc-base__hq-text { flex-grow: 1; flex-shrink: 1; }
.fc-base__map-pick { width: 250px; flex-shrink: 1; margin-right: var(--fc-space-3); }
.fc-base__map-dot { top: var(--fc-space-1); right: var(--fc-space-1); }
.fc-base__plans { flex-direction: row; margin-right: var(--fc-space-2); }
.fc-base__plans > .fc-chip { margin-right: var(--fc-space-1); }
.fc-base__plans .fc-chip__face { padding: 0 var(--fc-space-3); }
.fc-base__bar > .fc-btn { padding: var(--fc-space-1) var(--fc-space-3); }
.fc-base__saved { flex-direction: row; align-items: center; margin-left: var(--fc-space-3); opacity: 0; transition-property: opacity; transition-duration: 0.3s; }
.fc-base__saved--on { opacity: 1; }
.fc-base__saved-icon { width: var(--fc-icon-small); height: var(--fc-icon-small); margin-right: var(--fc-space-1); --icon-color: var(--fc-positive); }
.fc-base__body { flex-direction: row; flex-grow: 1; flex-shrink: 1; flex-basis: 0; min-height: 0; }
.fc-base__tray { width: 290px; flex-shrink: 0; margin-right: var(--fc-space-2); }
.fc-base__centre { flex-grow: 1; flex-shrink: 1; flex-basis: 0; min-width: 0; margin-right: var(--fc-space-2); }
/* The map's two switches in its bottom corner, where the picture is off the battlefield. */
.fc-base__map-tools { position: absolute; right: var(--fc-space-1); bottom: -8px; flex-direction: row; }
.fc-base__map-tools > .fc-chip { margin-right: 0; margin-left: var(--fc-space-1); }
.fc-base__map-tools > .fc-chip .fc-chip__face { background-color: var(--fc-panel-field); padding: 0 var(--fc-space-2); min-height: 48px; }
.fc-base__map-tools .fc-chip__label { font-size: var(--fc-fs-small); }
.fc-base__map-tools > .fc-chip.fc-chip--selected .fc-chip__face { background-color: var(--fc-text); }
.fc-base__legend { position: absolute; left: var(--fc-space-1); top: var(--fc-space-1); padding: var(--fc-space-1) var(--fc-space-2); }
.fc-base__swatch { width: 18px; height: 12px; margin-right: var(--fc-space-2); flex-shrink: 0; }
.fc-base__swatch--ground { background-color: var(--fc-range-ground); border-top-width: var(--fc-line); border-right-width: var(--fc-line); border-bottom-width: var(--fc-line); border-left-width: var(--fc-line); border-top-color: var(--fc-accent); border-right-color: var(--fc-accent); border-bottom-color: var(--fc-accent); border-left-color: var(--fc-accent); }
.fc-base__swatch--air { background-color: var(--fc-range-air); border-top-width: var(--fc-line); border-right-width: var(--fc-line); border-bottom-width: var(--fc-line); border-left-width: var(--fc-line); border-top-color: var(--fc-ally); border-right-color: var(--fc-ally); border-bottom-color: var(--fc-ally); border-left-color: var(--fc-ally); }
.fc-base__panel { width: 300px; flex-shrink: 0; padding: var(--fc-space-2) var(--fc-space-3); }
.fc-base__panel-scroll { flex-grow: 1; flex-shrink: 1; flex-basis: 0; }
.fc-base__head { flex-direction: row; align-items: center; margin-bottom: var(--fc-space-2); }
.fc-base__head-art { width: 72px; height: 72px; flex-shrink: 0; margin-right: var(--fc-space-2); align-items: center; justify-content: center; -unity-background-scale-mode: scale-to-fit; background-color: var(--fc-bg-2); }
.fc-base__head-icon { width: var(--fc-icon); height: var(--fc-icon); }
.fc-base__head-text { flex-grow: 1; flex-shrink: 1; }
.fc-base__caption { margin-top: var(--fc-space-1); margin-bottom: var(--fc-space-1); }
.fc-base__stat { margin-bottom: var(--fc-space-1); }
.fc-base__reach { margin-top: var(--fc-space-1); }
.fc-base__tabs { margin-top: var(--fc-space-2); margin-bottom: var(--fc-space-2); }
.fc-base__tabs > .fc-tab { flex-grow: 1; padding: 0 var(--fc-space-2); }
.fc-base__note { margin-bottom: var(--fc-space-2); }
.fc-base__branch { padding: var(--fc-space-2); margin-bottom: var(--fc-space-2); min-height: var(--fc-touch); }
.fc-base__branch--chosen { background-color: var(--fc-panel-selected); border-top-color: var(--fc-text); border-right-color: var(--fc-text); border-bottom-color: var(--fc-text); border-left-color: var(--fc-text); }
.fc-base__branch--locked { opacity: 0.6; }
.fc-base__branch-lock { width: var(--fc-icon-small); height: var(--fc-icon-small); margin-left: var(--fc-space-2); --icon-color: var(--fc-text-2); }
.fc-base__branch-tag { margin-left: var(--fc-space-2); color: var(--fc-positive); }
.fc-base__gear { flex-direction: row; justify-content: space-between; }
.fc-base__gear-slot { width: var(--fc-touch); min-height: var(--fc-touch); align-items: center; }
.fc-base__gear-slot--open { background-color: var(--fc-panel-selected); }
.fc-base__gear-empty { width: 64px; height: 64px; align-items: center; justify-content: center; border-top-width: var(--fc-line); border-right-width: var(--fc-line); border-bottom-width: var(--fc-line); border-left-width: var(--fc-line); border-top-color: var(--fc-border-strong); border-right-color: var(--fc-border-strong); border-bottom-color: var(--fc-border-strong); border-left-color: var(--fc-border-strong); }
.fc-base__gear-name { -unity-text-align: upper-center; }
.fc-base__gear-choices { flex-direction: row; flex-wrap: wrap; margin-top: var(--fc-space-2); }
.fc-base__gear-choice { width: var(--fc-touch); min-height: var(--fc-touch); align-items: center; justify-content: center; margin: 0 var(--fc-space-1) var(--fc-space-1) 0; }
.fc-base__gear-choice--worn { background-color: var(--fc-panel-selected); }
.fc-base__buttons { flex-direction: row; flex-wrap: wrap; margin-top: var(--fc-space-3); }
.fc-base__buttons > .fc-btn { margin: 0 var(--fc-space-2) var(--fc-space-2) 0; padding: var(--fc-space-1) var(--fc-space-3); }
.fc-base__strength-big { margin-top: var(--fc-space-3); padding: var(--fc-space-2); background-color: var(--fc-bg-2); }
.fc-base__strength-big > .fc-number { color: var(--fc-accent); }
.fc-base__strip { flex-direction: row; align-items: center; flex-shrink: 0; margin-top: var(--fc-space-1); padding: var(--fc-space-1) var(--fc-space-3); }
.fc-base__cover { flex-grow: 1; flex-shrink: 1; }
.fc-base__cover > .fc-row > .fc-tag { margin: var(--fc-space-1) var(--fc-space-1) 0 0; padding: 0 var(--fc-space-2); }
.fc-base__cover-title { margin: var(--fc-space-1) var(--fc-space-2) 0 0; }
.fc-base__numbers { align-items: flex-end; flex-shrink: 0; margin-left: var(--fc-space-3); }
.fc-base__strength { margin-left: var(--fc-space-2); color: var(--fc-accent); }
.fc-base__ghost { position: absolute; width: 72px; height: 72px; align-items: center; justify-content: center; -unity-background-scale-mode: scale-to-fit; }
.fc-base__ghost-icon { width: var(--fc-icon); height: var(--fc-icon); }

/* the map */
.fc-base-map {
    --base-arrow: var(--fc-danger); --base-range-ground: var(--fc-range-ground); --base-range-air: var(--fc-range-air);
    --base-ring: var(--fc-text); --base-drop: var(--fc-coin);
    flex-grow: 1; background-color: var(--fc-bg-2); border-top-width: var(--fc-line); border-right-width: var(--fc-line); border-bottom-width: var(--fc-line); border-left-width: var(--fc-line); border-top-color: var(--fc-border); border-right-color: var(--fc-border); border-bottom-color: var(--fc-border); border-left-color: var(--fc-border); }
.fc-base-map__world { -unity-background-scale-mode: stretch-to-fill; }
.fc-base-map__scrim { background-color: var(--fc-bg); }
.fc-base-hq { position: absolute; align-items: center; justify-content: center; background-color: var(--fc-panel-selected); border-top-width: 2px; border-right-width: 2px; border-bottom-width: 2px; border-left-width: 2px; border-top-color: var(--fc-text); border-right-color: var(--fc-text); border-bottom-color: var(--fc-text); border-left-color: var(--fc-text); }
.fc-base-hq__icon { width: 60%; height: 60%; }
.fc-base-slot { position: absolute; align-items: center; justify-content: center; }
.fc-base-face {
    align-items: center; justify-content: center;
    background-color: var(--fc-panel-field);
    border-top-width: 2px; border-right-width: 2px; border-bottom-width: 2px; border-left-width: 2px;
    border-top-color: var(--fc-border-strong); border-right-color: var(--fc-border-strong); border-bottom-color: var(--fc-border-strong); border-left-color: var(--fc-border-strong);
    --slot-fill: var(--fc-panel-field); --slot-line: var(--fc-border-strong); --slot-tick: var(--fc-text);
}
.fc-base-face--hex { background-color: var(--fc-clear); border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; }
.fc-base-slot--filled .fc-base-face { background-color: var(--fc-panel-selected); --slot-fill: var(--fc-panel-selected); }
.fc-base-slot--filled .fc-base-face--hex { background-color: var(--fc-clear); }
.fc-base-slot--lit .fc-base-face { border-top-color: var(--fc-text); border-right-color: var(--fc-text); border-bottom-color: var(--fc-text); border-left-color: var(--fc-text); --slot-line: var(--fc-text); }
.fc-base-slot--hover .fc-base-face { border-top-color: var(--fc-positive); border-right-color: var(--fc-positive); border-bottom-color: var(--fc-positive); border-left-color: var(--fc-positive); --slot-line: var(--fc-positive); }
.fc-base-slot--picked .fc-base-face { border-top-color: var(--fc-accent); border-right-color: var(--fc-accent); border-bottom-color: var(--fc-accent); border-left-color: var(--fc-accent); --slot-line: var(--fc-accent); }
.fc-base-slot--dim { opacity: 0.35; }
.fc-base-slot--closed .fc-base-face { background-color: var(--fc-bg-2); border-top-color: var(--fc-border); border-right-color: var(--fc-border); border-bottom-color: var(--fc-border); border-left-color: var(--fc-border); --slot-fill: var(--fc-bg-2); --slot-line: var(--fc-border); }
.fc-base-face--hex > .fc-base-face__art { left: 12%; right: 12%; top: 12%; bottom: 12%; }
.fc-base-face__art { position: absolute; left: 2px; top: 2px; right: 2px; bottom: 2px; -unity-background-scale-mode: scale-to-fit; }
/* An empty or closed slot's word under its face (the face may be smaller than the word). */
.fc-base-face__word {
    position: absolute; top: 100%; left: -40px; right: -40px; margin-top: 1px;
    -unity-font: var(--fc-font-display-semi); font-size: var(--fc-fs-small); color: var(--fc-text); -unity-text-align: upper-center;
    white-space: nowrap; -unity-text-outline-width: 1px; -unity-text-outline-color: var(--fc-bg);
}
.fc-base-face__lock { position: absolute; left: -5px; top: -5px; width: 16px; height: 16px; background-color: var(--fc-bg); --icon-color: var(--fc-text-2); }
/* The level a closed slot needs, centred on its face in a box of its own (a small face is shorter than the figure). */
.fc-base-face__need {
    position: absolute; left: -12px; right: -12px; top: 50%; height: 36px; margin-top: -18px;
    -unity-font: var(--fc-font-display-semi); font-size: var(--fc-fs-small); color: var(--fc-text); -unity-text-align: middle-center;
    -unity-text-outline-width: 1px; -unity-text-outline-color: var(--fc-bg);
}
.fc-base-face__branch { position: absolute; right: -6px; top: -6px; width: var(--fc-icon-small); height: var(--fc-icon-small); background-color: var(--fc-bg); --icon-color: var(--fc-accent); }

/* the tray */
.fc-base-tray { flex-direction: row; }
.fc-base-tray__tabs { width: var(--fc-touch); flex-shrink: 0; }
.fc-base-tray__tab { width: var(--fc-touch); min-height: var(--fc-touch); align-items: center; justify-content: center; border-left-width: var(--fc-bar); border-left-color: var(--fc-clear); }
.fc-base-tray__tab--on { background-color: var(--fc-panel-selected); border-left-color: var(--fc-accent); }
.fc-base-tray__tab-icon { width: var(--fc-icon); height: var(--fc-icon); --icon-color: var(--fc-text-2); }
.fc-base-tray__tab--on > .fc-base-tray__tab-icon { --icon-color: var(--fc-accent); }
.fc-base-tray__tab-word { -unity-font: var(--fc-font-display-semi); font-size: var(--fc-fs-small); color: var(--fc-text-2); -unity-text-align: middle-center; }
.fc-base-tray__tab--on > .fc-base-tray__tab-word { color: var(--fc-text); }
.fc-base-tray__list { flex-grow: 1; flex-shrink: 1; flex-basis: 0; }
.fc-base-tray__end { height: var(--fc-space-7); }
.fc-base-row {
    flex-direction: row; align-items: center; min-height: var(--fc-touch); padding: var(--fc-space-1); margin-bottom: var(--fc-space-1);
    background-color: var(--fc-panel-raised);
    border-top-width: var(--fc-line); border-right-width: var(--fc-line); border-bottom-width: var(--fc-line); border-left-width: var(--fc-bar);
    border-top-color: var(--fc-border); border-right-color: var(--fc-border); border-bottom-color: var(--fc-border); border-left-color: var(--fc-clear);
}
.fc-root .fc-base-row.pressed { background-color: var(--fc-panel-selected); }
.fc-base-row--armed { background-color: var(--fc-panel-selected); border-left-color: var(--fc-accent); }
.fc-base-row--nofit { opacity: 0.45; }
.fc-base-row--locked .fc-base-row__art, .fc-base-row--locked .fc-base-row__name { opacity: 0.45; }
.fc-base-row__art { width: 64px; height: 56px; flex-shrink: 0; margin-right: var(--fc-space-2); align-items: center; justify-content: center; -unity-background-scale-mode: scale-to-fit; background-color: var(--fc-bg-2); }
.fc-base-row__icon { width: var(--fc-icon); height: var(--fc-icon); --icon-color: var(--fc-text-2); }
.fc-base-row__text { flex-grow: 1; flex-shrink: 1; }
.fc-base-row__name { -unity-font: var(--fc-font-display-semi); font-size: var(--fc-fs-card); color: var(--fc-text); }

/* the outpost */
.fc-outpost__site { flex-grow: 1; flex-shrink: 1; flex-basis: 0; margin-right: var(--fc-space-2); padding: var(--fc-space-3); align-items: center; }
.fc-outpost__ring {
    flex-direction: row; align-items: center; justify-content: center; margin: var(--fc-space-6) 0; padding: var(--fc-space-7);
    border-top-left-radius: 50%; border-top-right-radius: 50%; border-bottom-left-radius: 50%; border-bottom-right-radius: 50%;
    border-top-width: 2px; border-right-width: 2px; border-bottom-width: 2px; border-left-width: 2px;
    border-top-color: var(--fc-border-strong); border-right-color: var(--fc-border-strong); border-bottom-color: var(--fc-border-strong); border-left-color: var(--fc-border-strong);
    background-color: var(--fc-bg-2);
}
.fc-outpost__slot { position: relative; margin: 0 var(--fc-space-5) var(--fc-space-5) var(--fc-space-5); width: 110px; height: 110px; }
.fc-outpost__slot.fc-base-slot--small > .fc-base-face { width: 60px; height: 60px; }
.fc-outpost__slot.fc-base-slot--medium > .fc-base-face { width: 84px; height: 84px; }
.fc-outpost__caption { -unity-text-align: middle-center; }

/* ================================================================ E10 result, the choice between stages, pause */
/* One card over the dimmed battle: the outcome and the name on the left with the numbers, what it paid and
   (after a defeat) what to change on the right, the buttons along the bottom (secondary, Claim, the main one). */
.fc-result__card { width: 1100px; max-width: 94%; max-height: 94%; padding: var(--fc-space-6); }
.fc-result__scroll { flex-grow: 1; flex-shrink: 1; }
.fc-result__columns { flex-direction: row; align-items: flex-start; }
.fc-result__main { flex-grow: 1; flex-shrink: 1; flex-basis: 0; min-width: 0; }
.fc-result__side { width: 420px; flex-shrink: 0; margin-left: var(--fc-space-6); }
.fc-result__outcome { flex-direction: row; align-items: center; margin-bottom: var(--fc-space-1); }
.fc-result__outcome > .fc-icon { width: var(--fc-icon); height: var(--fc-icon); margin-right: var(--fc-space-2); --icon-color: var(--fc-text-2); }
.fc-result__outcome--win > .fc-icon { --icon-color: var(--fc-positive); }
.fc-result__outcome--win > .fc-caption { color: var(--fc-positive); }
.fc-result__outcome--loss > .fc-icon { --icon-color: var(--fc-danger); }
.fc-result__outcome--loss > .fc-caption { color: var(--fc-danger-text); }
.fc-result__title { margin-bottom: var(--fc-space-2); }
.fc-result__note { margin-bottom: var(--fc-space-2); }
.fc-result__stars { margin-bottom: var(--fc-space-3); }
.fc-result__stars > .fc-star { width: var(--fc-icon); height: var(--fc-icon); margin-right: var(--fc-space-1); }
.fc-result__rows { margin-top: var(--fc-space-2); }
.fc-result__row {
    flex-direction: row; align-items: center; justify-content: space-between; min-height: 40px;
    border-bottom-width: var(--fc-line); border-bottom-color: var(--fc-border);
}
.fc-result__value { margin-left: var(--fc-space-4); -unity-text-align: middle-right; flex-shrink: 1; }
.fc-result__block { padding: var(--fc-space-4); margin-bottom: var(--fc-space-3); background-color: var(--fc-panel); border-top-width: var(--fc-line); border-right-width: var(--fc-line); border-bottom-width: var(--fc-line); border-left-width: var(--fc-line); border-top-color: var(--fc-border); border-right-color: var(--fc-border); border-bottom-color: var(--fc-border); border-left-color: var(--fc-border); }
.fc-result__reward { flex-direction: row; flex-wrap: wrap; align-items: center; margin-top: var(--fc-space-2); }
.fc-result__pay { flex-direction: row; align-items: center; margin-right: var(--fc-space-6); }
.fc-result__pay > .fc-icon { width: var(--fc-icon); height: var(--fc-icon); margin-right: var(--fc-space-2); }
.fc-result__coin { --icon-color: var(--fc-coin); }
.fc-result__doubled { margin-left: var(--fc-space-2); }
.fc-result__claim { flex-direction: row; margin-top: var(--fc-space-3); }
.fc-result__unlocks { margin-top: var(--fc-space-2); }
.fc-result__unlocks > .fc-tag { margin: var(--fc-space-1) var(--fc-space-2) 0 0; }
.fc-result__hint { flex-direction: row; align-items: flex-start; margin-top: var(--fc-space-2); }
.fc-result__hint > .fc-icon { width: var(--fc-icon-small); height: var(--fc-icon-small); margin: var(--fc-space-1) var(--fc-space-2) 0 0; --icon-color: var(--fc-danger); }
.fc-result__hints > .fc-btn { align-self: flex-start; margin-top: var(--fc-space-2); }
.fc-result__buttons { flex-direction: row; justify-content: flex-end; align-items: center; flex-wrap: wrap; flex-shrink: 0; margin-top: var(--fc-space-4); }
.fc-result__buttons > * { margin-left: var(--fc-space-3); }

.fc-choice__card { width: 760px; }
.fc-choice__icon { width: var(--fc-icon); height: var(--fc-icon); margin-right: var(--fc-space-2); }
.fc-choice__option { margin-top: var(--fc-space-3); }
.fc-choice__option > .fc-btn { align-self: stretch; }
.fc-choice__detail { margin-top: var(--fc-space-1); }

.fc-pause__card { width: 520px; }
.fc-pause__card > .fc-row > .fc-icon { width: var(--fc-icon); height: var(--fc-icon); margin-right: var(--fc-space-2); }
.fc-pause__buttons > .fc-btn { align-self: stretch; margin-top: var(--fc-space-3); }

/* ================================================================ G the battle HUD on the kit */
/* The battlefield owns the middle: the minimap and its tools top left, the score (or the mission, or the waves)
   top centre with the boss and the fortress pieces under it, pause top right, the commander's rail down the right,
   the deck along the bottom, the selection's orders beside the rail. Panels on the battlefield are the field
   surface with a hairline; every control is a full touch target. Panel pixels at 1280 x 720. */
.hud.fc-hud { -unity-font: var(--fc-font-text); font-size: var(--fc-fs-body); color: var(--fc-text); }
.fc-hud-flash { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: var(--fc-flash); }
.cb { --fc-enemy: var(--fc-enemy-cb); }

/* top: score, mission or waves; pause and the frame rate in the corner */
.fc-hud__top { position: absolute; top: var(--fc-space-3); left: 244px; right: 124px; flex-direction: row; justify-content: center; align-items: flex-start; }
.fc-hud__corner { position: absolute; top: var(--fc-space-3); right: var(--fc-space-3); flex-direction: row; align-items: center; }
.fc-hud__fps { margin-right: var(--fc-space-2); }
.fc-hud__stats { flex-direction: row; }
.fc-hud__stat { flex-direction: row; align-items: center; min-height: 64px; padding: var(--fc-space-2) var(--fc-space-4); margin: 0 var(--fc-space-1); }
.fc-hud__stat-icon { width: var(--fc-icon); height: var(--fc-icon); margin-right: var(--fc-space-3); }
.fc-hud__stat--ours .fc-hud__stat-icon { --icon-color: var(--fc-ally); }
.fc-hud__stat--theirs .fc-hud__stat-icon { --icon-color: var(--fc-enemy); }
.fc-hud__clock { padding: 0 var(--fc-space-2); margin-top: var(--fc-space-1); background-color: var(--fc-panel-field); -unity-text-align: middle-center; }
.fc-hud__clock--urgent { color: var(--fc-danger-text); }

.fc-score { flex-direction: row; align-items: flex-start; }
.fc-score__side { flex-direction: row; align-items: center; width: 200px; min-height: 64px; padding: var(--fc-space-2) var(--fc-space-3); }
.fc-score__side--theirs { justify-content: flex-end; }
.fc-score__number { margin: 0 var(--fc-space-2); }
.fc-score__side--ours .fc-score__number { color: var(--fc-ally); }
.fc-score__side--theirs .fc-score__number { color: var(--fc-enemy); }
.fc-score__column { flex-grow: 1; flex-shrink: 1; }
.fc-score__side--theirs .fc-caption { -unity-text-align: upper-right; }
.fc-score__track { height: var(--fc-progress); margin-top: var(--fc-space-1); background-color: var(--fc-border); overflow: hidden; }
.fc-score__fill { height: 100%; width: 100%; background-color: var(--fc-ally); }
.fc-score__side--theirs .fc-score__track { flex-direction: row-reverse; }
.fc-score__side--theirs .fc-score__fill { background-color: var(--fc-enemy); }
.fc-score__centre { align-items: center; margin: 0 var(--fc-space-2); }
.fc-score__chips { flex-direction: row; }

/* an objective: a full touch target, its ring and letter inside */
.fc-point {
    width: var(--fc-touch); height: var(--fc-touch); padding: var(--fc-space-2); margin: 0 var(--fc-space-1);
    --point-ours: var(--fc-ally); --point-theirs: var(--fc-enemy); --point-track: var(--fc-border-strong);
}
.fc-point__face { flex-grow: 1; align-items: center; justify-content: center; background-color: var(--fc-panel-field); border-top-left-radius: 50%; border-top-right-radius: 50%; border-bottom-left-radius: 50%; border-bottom-right-radius: 50%; }
.fc-point--ours .fc-point__letter { color: var(--fc-ally); }
.fc-point--theirs .fc-point__letter { color: var(--fc-enemy); }
.fc-point--contested .fc-point__face { background-color: var(--fc-panel-selected); }
.fc-point--focus .fc-point__face { border-top-width: 2px; border-right-width: 2px; border-bottom-width: 2px; border-left-width: 2px; border-top-color: var(--fc-accent); border-right-color: var(--fc-accent); border-bottom-color: var(--fc-accent); border-left-color: var(--fc-accent); }

.fc-mission-bar { flex-direction: row; align-items: center; min-height: 64px; padding: var(--fc-space-2) var(--fc-space-3); }
.fc-mission-bar__text { width: 320px; flex-shrink: 1; }
.fc-mission-bar__goal { color: var(--fc-accent); }
.fc-mission-bar__progress { margin-top: var(--fc-space-2); }
.fc-mission-bar > .fc-score__chips { margin-left: var(--fc-space-2); }
.fc-mission-bar > .fc-hud__clock { margin: 0 0 0 var(--fc-space-3); }

/* under the top bar: the boss, then the fortress pieces */
.fc-hud__under { position: absolute; top: 128px; left: 25%; right: 25%; align-items: center; }
.fc-boss { width: 100%; padding: var(--fc-space-2) var(--fc-space-3); margin-bottom: var(--fc-space-2); border-top-color: var(--fc-danger); border-right-color: var(--fc-danger); border-bottom-color: var(--fc-danger); border-left-color: var(--fc-danger); }
.fc-boss__head { flex-direction: row; align-items: center; }
.fc-boss__icon { width: var(--fc-icon); height: var(--fc-icon); margin-right: var(--fc-space-2); --icon-color: var(--fc-danger); }
.fc-boss__name { flex-grow: 1; }
.fc-boss__phase { margin-left: var(--fc-space-2); color: var(--fc-accent); }
.fc-boss__hp { margin-left: var(--fc-space-3); color: var(--fc-text-2); }
.fc-boss__track { height: 10px; margin-top: var(--fc-space-1); background-color: var(--fc-border); }
.fc-boss__fill { height: 100%; width: 100%; background-color: var(--fc-danger); }
.fc-boss__mark { position: absolute; top: -2px; bottom: -2px; width: 2px; margin-left: -1px; background-color: var(--fc-text); }
.fc-boss--transforming .fc-boss__fill { background-color: var(--fc-accent); }
.fc-boss-parts { flex-direction: row; flex-wrap: wrap; margin-top: var(--fc-space-2); }
.fc-boss-part {
    width: var(--fc-touch); height: var(--fc-touch); margin: 0 var(--fc-space-1) var(--fc-space-1) 0; padding: var(--fc-space-2);
    align-items: center; justify-content: space-between; background-color: var(--fc-panel-raised);
    border-top-width: var(--fc-line); border-right-width: var(--fc-line); border-bottom-width: var(--fc-line); border-left-width: var(--fc-line);
    border-top-color: var(--fc-border); border-right-color: var(--fc-border); border-bottom-color: var(--fc-border); border-left-color: var(--fc-border);
}
.fc-boss-part__icon { width: 36px; height: 36px; }
.fc-boss-part__track { width: 100%; height: var(--fc-progress); background-color: var(--fc-border); }
.fc-boss-part__fill { height: 100%; width: 100%; background-color: var(--fc-text-2); }
.fc-boss-part__cross { position: absolute; left: 50%; top: 8px; bottom: 8px; width: 2px; margin-left: -1px; background-color: var(--fc-danger); rotate: 45deg; display: none; }
.fc-boss-part__cross--flip { rotate: -45deg; }
.fc-boss-part--broken { opacity: 0.45; }
.fc-boss-part--broken .fc-boss-part__cross { display: flex; }
.fc-boss-part--focused { background-color: var(--fc-panel-selected); border-top-color: var(--fc-accent); border-right-color: var(--fc-accent); border-bottom-color: var(--fc-accent); border-left-color: var(--fc-accent); }
.fc-hud .fortress-panel { position: relative; top: 0; left: 0; right: 0; }
.fc-hud .gun-timer, .fc-hud .wave-preview { background-color: var(--fc-panel-field); border-top-left-radius: 0; border-top-right-radius: 0; border-bottom-left-radius: 0; border-bottom-right-radius: 0; }
.fc-hud .gun-timer { min-height: 64px; }
.fc-hud .gun-timer-name, .fc-hud .wave-preview-title { -unity-font: var(--fc-font-display-semi); font-size: var(--fc-fs-small); }
.fc-hud .gun-timer-clock, .fc-hud .wave-preview-clock, .fc-hud .wave-chip-count { -unity-font: var(--fc-font-display); font-size: var(--fc-fs-number-small); }
.fc-hud .wave-chip { height: 36px; background-color: var(--fc-panel-raised); border-top-left-radius: 0; border-top-right-radius: 0; border-bottom-left-radius: 0; border-bottom-right-radius: 0; }
.fc-hud .wave-preview-held { -unity-font: var(--fc-font-text-medium); font-size: var(--fc-fs-small); color: var(--fc-text-2); white-space: normal; }

/* left: minimap and its tools (two by two) */
.fc-hud__left { position: absolute; left: var(--fc-space-3); top: var(--fc-space-3); width: 216px; }
.fc-hud .minimap { border-top-left-radius: 0; border-top-right-radius: 0; border-bottom-left-radius: 0; border-bottom-right-radius: 0; background-color: var(--fc-panel-field); border-top-color: var(--fc-border-strong); border-right-color: var(--fc-border-strong); border-bottom-color: var(--fc-border-strong); border-left-color: var(--fc-border-strong); }
.fc-hud__tools { flex-direction: row; flex-wrap: wrap; margin-top: var(--fc-space-2); }
.fc-hud__tools > .fc-icon-btn { margin: 0 var(--fc-space-2) var(--fc-space-2) 0; background-color: var(--fc-panel-field); }
.fc-icon-btn--on { background-color: var(--fc-text); }
.fc-icon-btn--on > .fc-icon { --icon-color: var(--fc-ink); }
.fc-hud .item-strip { left: var(--fc-space-3); top: 404px; flex-direction: row; flex-wrap: wrap; width: 216px; }
.fc-hud .item { width: var(--fc-touch); height: var(--fc-touch); margin: 0 var(--fc-space-2) var(--fc-space-2) 0; border-top-left-radius: 0; border-top-right-radius: 0; border-bottom-left-radius: 0; border-bottom-right-radius: 0; background-color: var(--fc-panel-field); border-top-color: var(--fc-border-strong); border-right-color: var(--fc-border-strong); border-bottom-color: var(--fc-border-strong); border-left-color: var(--fc-border-strong); }
.fc-hud .item.selected { background-color: var(--fc-text); }
.fc-hud .item-count { background-color: var(--fc-bg); border-top-left-radius: 0; border-top-right-radius: 0; border-bottom-left-radius: 0; border-bottom-right-radius: 0; }
.fc-hud .item-count-text { -unity-font: var(--fc-font-display-semi); font-size: var(--fc-fs-small); color: var(--fc-text); }
.fc-hud .item-cooldown { background-color: var(--fc-scrim); border-top-left-radius: 0; border-top-right-radius: 0; border-bottom-left-radius: 0; border-bottom-right-radius: 0; }

/* right: the commander's rail */
.fc-hud__rail { position: absolute; right: var(--fc-space-3); top: 106px; width: 244px; }
.fc-hud__group { padding: var(--fc-space-1); margin-bottom: var(--fc-space-2); }
.fc-stance { flex-direction: row; align-items: center; min-height: var(--fc-touch); padding: 0 var(--fc-space-3); margin-bottom: var(--fc-space-1); }
.fc-stance__icon { width: var(--fc-icon); height: var(--fc-icon); margin-right: var(--fc-space-3); }
.fc-stance__label { -unity-font: var(--fc-font-display-semi); font-size: var(--fc-fs-button); color: var(--fc-text); letter-spacing: 1px; }
.fc-root .fc-stance.pressed { background-color: var(--fc-panel-selected); }
.fc-stance--on { background-color: var(--fc-text); }
.fc-stance--on > .fc-stance__icon { --icon-color: var(--fc-ink); }
.fc-stance--on > .fc-stance__label { color: var(--fc-ink); }
.fc-root .fc-stance--on.pressed { background-color: var(--fc-text-2); }
.fc-hud__switches { padding: 0 var(--fc-space-2); }
.fc-hud__switches .fc-toggle__label { margin-right: var(--fc-space-2); }
.fc-hud__switches .fc-toggle__state { margin-right: var(--fc-space-2); }
.fc-hud__tower { align-self: stretch; background-color: var(--fc-panel-field); }

/* the selection: who, their health, weapons, and the three hand orders */
.fc-hud__command { position: absolute; right: 268px; bottom: 180px; width: 440px; padding: var(--fc-space-3); display: none; }
.fc-hud__command-head { flex-direction: row; justify-content: space-between; margin-bottom: var(--fc-space-2); }
.fc-hud__details { flex-direction: row; align-items: center; }
.fc-hud__portrait { width: 96px; height: 64px; margin-right: var(--fc-space-3); align-items: center; justify-content: center; background-color: var(--fc-panel-raised); -unity-background-scale-mode: scale-to-fit; }
.fc-hud__portrait-icon { width: 36px; height: 36px; --icon-color: var(--fc-ally); }
.fc-hud__details-text { flex-grow: 1; flex-shrink: 1; }
.fc-hud__hp { height: var(--fc-progress); margin: var(--fc-space-1) 0; background-color: var(--fc-border); }
.fc-hud__hp-fill { height: 100%; width: 100%; background-color: var(--fc-positive); }
.fc-hud__hp-fill--hurt { background-color: var(--fc-accent); }
.fc-hud__hp-fill--critical { background-color: var(--fc-danger); }
.fc-hud__weapons { margin-top: var(--fc-space-2); }
.fc-hud__counter { margin-top: var(--fc-space-1); }
.fc-hud__orders { flex-direction: row; margin-top: var(--fc-space-2); }
.fc-hud__order {
    flex-grow: 1; flex-basis: 0; min-height: var(--fc-touch); margin-right: var(--fc-space-1);
    align-items: center; justify-content: center; background-color: var(--fc-panel-raised);
    border-top-width: var(--fc-line); border-right-width: var(--fc-line); border-bottom-width: var(--fc-line); border-left-width: var(--fc-line);
    border-top-color: var(--fc-border-strong); border-right-color: var(--fc-border-strong); border-bottom-color: var(--fc-border-strong); border-left-color: var(--fc-border-strong);
}
.fc-hud__order-icon { width: var(--fc-icon); height: var(--fc-icon); margin-bottom: var(--fc-space-1); }
.fc-hud__order-label { -unity-text-align: middle-center; }
.fc-root .fc-hud__order.pressed { background-color: var(--fc-panel-selected); }
.fc-hud__order--armed { background-color: var(--fc-text); }
.fc-hud__order--armed > .fc-hud__order-icon { --icon-color: var(--fc-ink); }
.fc-hud__order--armed > .fc-stance__label { color: var(--fc-ink); }

/* the deck: the CP box, then the cards (a gap before the support cards) */
/* Every card and the CP box are one height (160), so what sits above the deck clears it by the same amount. */
.fc-deck { position: absolute; left: var(--fc-space-3); right: var(--fc-space-3); bottom: var(--fc-space-3); height: 160px; flex-direction: row; justify-content: center; align-items: stretch; }
.fc-cpbox { width: 180px; margin-right: var(--fc-space-2); padding: var(--fc-space-2) var(--fc-space-3); justify-content: center; }
.fc-cpbox__head { flex-direction: row; align-items: center; justify-content: space-between; flex-shrink: 0; }
.fc-cpbox > * { flex-shrink: 0; }
.fc-cpbox__value { color: var(--fc-accent); }
.fc-cpbox__bank { margin: var(--fc-space-1) 0; }
.fc-cpbox__bank .fc-progress__fill { background-color: var(--fc-accent); }
.fc-root .fc-cpbox.pressed { background-color: var(--fc-panel-selected); }
.fc-deck__cards { flex-direction: row; align-items: stretch; flex-shrink: 1; }
.fc-deck__gap { width: var(--fc-space-3); }
.fc-hcard {
    width: 100px; margin-left: var(--fc-space-1); padding-bottom: var(--fc-space-1);
    background-color: var(--fc-panel-field);
    border-top-width: var(--fc-bar); border-right-width: var(--fc-line); border-bottom-width: var(--fc-line); border-left-width: var(--fc-line);
    border-top-color: var(--fc-border-strong); border-right-color: var(--fc-border-strong); border-bottom-color: var(--fc-border-strong); border-left-color: var(--fc-border-strong);
}
.fc-hcard--support { border-top-color: var(--fc-branch-support); }
.fc-hcard__art { height: 72px; overflow: hidden; align-items: center; justify-content: center; -unity-background-scale-mode: scale-to-fit; background-color: var(--fc-panel-raised); }
.fc-hcard__icon { width: 40px; height: 40px; }
.fc-hcard__sweep { position: absolute; left: 0; top: 0; right: 0; bottom: 0; color: var(--fc-scrim); }
.fc-hcard__seconds { position: absolute; left: 0; right: 0; top: 18px; -unity-text-align: middle-center; display: none; }
.fc-hcard--cooling .fc-hcard__seconds { display: flex; }
.fc-hcard__lock { position: absolute; width: var(--fc-icon); height: var(--fc-icon); display: none; }
.fc-hcard--locked .fc-hcard__lock { display: flex; }
.fc-hcard__short { position: absolute; left: 0; right: 0; bottom: 0; -unity-text-align: middle-center; color: var(--fc-danger-text); background-color: var(--fc-panel-field); display: none; }
.fc-hcard--short .fc-hcard__short { display: flex; }
.fc-hcard__cost { position: absolute; top: 0; right: 0; min-width: 34px; padding: 0 var(--fc-space-1); align-items: center; background-color: var(--fc-bg); }
.fc-hcard__cost > .fc-number-small { color: var(--fc-accent); }
.fc-hcard__name { margin: var(--fc-space-1) var(--fc-space-1) 0 var(--fc-space-1); -unity-text-align: upper-center; color: var(--fc-text); }
.fc-hcard--short .fc-hcard__art, .fc-hcard--locked .fc-hcard__art, .fc-hcard--short .fc-hcard__name, .fc-hcard--locked .fc-hcard__name { opacity: 0.45; }
.fc-hcard--short .fc-hcard__cost > .fc-number-small { color: var(--fc-text-2); }
.fc-hcard--armed { border-top-color: var(--fc-accent); border-right-color: var(--fc-accent); border-bottom-color: var(--fc-accent); border-left-color: var(--fc-accent); background-color: var(--fc-panel-selected); }
.fc-root .fc-hcard.pressed { translate: 0 var(--fc-press-shift); }

/* the hint, the strike prompt, the banner, notices and radio chatter */
.fc-hud__hint { position: absolute; left: 244px; right: 720px; bottom: 180px; align-items: center; opacity: 1; transition-property: opacity; transition-duration: 0.5s; }
.fc-hud__hint--gone { opacity: 0; }
.fc-hud__hint-face { padding: var(--fc-space-2) var(--fc-space-4); }
.fc-hud__hint-face > .fc-text { -unity-text-align: middle-center; }
.fc-hud__targeting { position: absolute; left: 244px; right: 720px; bottom: 180px; align-items: center; }
.fc-hud__targeting-face { flex-direction: row; align-items: center; padding: var(--fc-space-1) var(--fc-space-1) var(--fc-space-1) var(--fc-space-4); border-top-color: var(--fc-accent); border-right-color: var(--fc-accent); border-bottom-color: var(--fc-accent); border-left-color: var(--fc-accent); }
.fc-hud__targeting-icon { width: var(--fc-icon); height: var(--fc-icon); margin-right: var(--fc-space-3); --icon-color: var(--fc-accent); }
.fc-hud__targeting-face > .fc-text { margin-right: var(--fc-space-3); }
.fc-hud__banner { position: absolute; top: 200px; left: 244px; right: 268px; align-items: center; opacity: 0; transition-property: opacity; transition-duration: 0.4s; }
.fc-hud__banner--visible { opacity: 1; }
.fc-hud__banner-face { padding: var(--fc-space-4) var(--fc-space-7); align-items: center; border-left-width: var(--fc-bar); border-left-color: var(--fc-accent); }
.fc-hud__banner-kicker { color: var(--fc-accent); }
/* Notices and radio chatter stack in the column under the top bar, under the boss when there is one. */
.fc-hud__toast { width: 100%; align-items: center; margin-top: var(--fc-space-2); opacity: 0; transition-property: opacity; transition-duration: 0.2s; }
.fc-hud__toast--visible { opacity: 1; }
.fc-hud__toast-face { max-width: 640px; }
.fc-hud__toast-icon { --icon-color: var(--fc-text-2); }
.fc-toast--alert > .fc-hud__toast-icon { --icon-color: var(--fc-danger); }
.fc-toast--alert { border-left-width: var(--fc-bar); border-left-color: var(--fc-danger); }
.fc-radio {
    width: 100%; margin-top: var(--fc-space-2); min-height: var(--fc-touch);
    flex-direction: row; align-items: center; padding: var(--fc-space-2) var(--fc-space-4) var(--fc-space-2) var(--fc-space-2);
    border-left-width: var(--fc-bar); border-left-color: var(--fc-ally);
}
.fc-radio--enemy { border-left-color: var(--fc-enemy); }
.fc-radio__portrait { width: 64px; height: 64px; flex-shrink: 0; margin-right: var(--fc-space-3); }
.fc-radio__text { flex-grow: 1; flex-shrink: 1; }
.fc-radio__name { color: var(--fc-ally); }
.fc-radio--enemy .fc-radio__name { color: var(--fc-danger-text); }
.fc-ad__count { margin-bottom: var(--fc-space-4); }
/* Large text: the deck grows to hold its bigger type, and what sits above it moves up with it. */
.fc-hud.fc-text-large .fc-deck { height: 196px; }
.fc-hud.fc-text-large .fc-hud__command, .fc-hud.fc-text-large .fc-hud__hint, .fc-hud.fc-text-large .fc-hud__targeting { bottom: 216px; }

/* ================================================================ prompt 11 A: the compact battle HUD */
/* Settings > Compact battle HUD (on by default) puts fc-hud--compact on the HUD's root. The battlefield keeps
   at least 70 % of the screen in a fight: a smaller minimap with two small tools on its corner, one low strip
   at the top for the objective and the clock, small notices under it, the commander's switches as small icons
   down the right, a tray a third lower with short names, the selection in one low strip above the tray.
   Visible faces may be smaller than 44 pt; each sits inside a full touch target (82 panel px) that is not drawn. */
.fc-hud--compact {
    --hud-edge: 240px;          /* the top strip, the column under it and the banner stay between the corners */
    --hud-minimap: 132px;       /* 216 px less 40 % */
    --hud-face: 44px;           /* the drawn face of a small control inside its touch target */
    --hud-deck: 104px;          /* the tray: 160 px less 35 % */
    --hud-card: 108px;          /* ten cards and the CP box fit across 1280 px */
    --hud-card-art: 68px;
    --hud-above-deck: 124px;    /* the tray's margin, its height and a gap: what sits just above it */
    --hud-above-chip: 160px;    /* above the supply chip over the CP box as well */
}
/* Large text: the tray's names may take two lines (no card width fits every name on one line across the tray). */
.fc-hud--compact.fc-text-large { --hud-deck: 134px; --hud-above-deck: 154px; --hud-above-chip: 194px; }

/* top: one strip; pause in the corner as a small face */
.fc-hud--compact .fc-hud__top { top: var(--fc-space-2); left: var(--hud-edge); right: var(--hud-edge); }
.fc-hud--compact .fc-hud__corner { top: 0; right: 0; }
.fc-hud .fc-icon-btn--plain .fc-icon-btn__face { background-color: var(--fc-panel-field); }
.fc-hud--compact .fc-icon-btn--on { background-color: var(--fc-clear); }
.fc-hud--compact .fc-icon-btn--on .fc-icon-btn__face { background-color: var(--fc-text); border-top-color: var(--fc-text); border-right-color: var(--fc-text); border-bottom-color: var(--fc-text); border-left-color: var(--fc-text); }
.fc-hud--compact .fc-icon-btn--on .fc-icon-btn__face > .fc-icon { --icon-color: var(--fc-ink); }
.fc-hud--compact .fc-hud__clock { background-color: var(--fc-clear); margin: 0 0 0 var(--fc-space-3); padding: 0; }

.fc-score--compact { flex-direction: row; align-items: center; padding: 0 var(--fc-space-3); }
.fc-score--compact .fc-score__side { width: 88px; min-height: 0; padding: var(--fc-space-1) 0; }
.fc-score--compact .fc-score__number { margin: 0 var(--fc-space-2) 0 0; }
.fc-score--compact .fc-score__side--theirs .fc-score__number { margin: 0 0 0 var(--fc-space-2); }
.fc-score--compact .fc-score__track { margin-top: 0; }
.fc-score--compact .fc-score__centre { margin: 0; }
/* An objective: a small ring inside its full touch target, which reaches above and below the strip. */
.fc-hud--compact .fc-point { padding: 19px; margin: -15px 0; }
.fc-hud--compact.fc-text-large .fc-point { padding: 15px; margin: -13px 0; }

.fc-mission-bar--compact { min-height: 0; padding: var(--fc-space-1) var(--fc-space-3); }
.fc-mission-bar--compact .fc-mission-bar__text { width: auto; max-width: 440px; }
.fc-mission-bar__line { flex-direction: row; align-items: center; flex-wrap: wrap; }
.fc-mission-bar__line > .fc-mission-bar__goal { margin-right: var(--fc-space-2); }
.fc-mission-bar--compact .fc-mission-bar__progress { margin-top: var(--fc-space-1); }

.fc-hud--compact .fc-hud__stats { padding: 0 var(--fc-space-2); }
.fc-hud--compact .fc-hud__stat { min-height: 0; padding: var(--fc-space-1) var(--fc-space-2); margin: 0; }
.fc-hud--compact .fc-hud__stat-icon { width: var(--fc-icon-small); height: var(--fc-icon-small); margin-right: var(--fc-space-2); }

/* left: the minimap, and select-all and box-select as small faces on its right-hand corners */
.fc-hud--compact .fc-hud__left { left: var(--fc-space-3); top: var(--fc-space-3); width: auto; flex-direction: row; align-items: flex-start; }
.fc-hud--compact .minimap { width: var(--hud-minimap); height: var(--hud-minimap); }
.fc-hud--compact .fc-hud__tools { flex-direction: column; margin: 0; }
.fc-hud--compact .fc-hud__tools > .fc-icon-btn { margin: 0; background-color: var(--fc-clear); align-items: flex-start; justify-content: flex-start; padding-left: var(--fc-space-1); }
.fc-hud--compact .item-strip { top: 184px; width: 180px; }

/* right: the stance switch, Auto buy, Support and the tower, small faces at the edge */
.fc-hud--compact .fc-hud__rail { right: 0; top: 88px; width: 120px; align-items: flex-end; }
.fc-hud__switch { width: 120px; height: var(--fc-touch); align-items: flex-end; justify-content: center; padding-right: var(--fc-space-3); }
.fc-hud__switch-face { flex-direction: row; padding: 0; }
.fc-hud__switch-half { width: 48px; height: var(--hud-face); align-items: center; justify-content: center; }
.fc-hud__switch-half > .fc-icon { width: var(--fc-icon-small); height: var(--fc-icon-small); --icon-color: var(--fc-text-2); }
.fc-hud__switch-half--attack, .fc-hud__switch--defend .fc-hud__switch-half--defend { background-color: var(--fc-text); }
.fc-hud__switch-half--attack > .fc-icon, .fc-hud__switch--defend .fc-hud__switch-half--defend > .fc-icon { --icon-color: var(--fc-ink); }
.fc-hud__switch--defend .fc-hud__switch-half--attack { background-color: var(--fc-clear); }
.fc-hud__switch--defend .fc-hud__switch-half--attack > .fc-icon { --icon-color: var(--fc-text-2); }
.fc-root .fc-hud__switch.pressed .fc-hud__switch-face { translate: 0 var(--fc-press-shift); }
.fc-hud__tool { min-width: var(--fc-touch); height: var(--fc-touch); align-items: flex-end; justify-content: center; padding-right: var(--fc-space-3); }
.fc-hud__tool-face { flex-direction: row; min-width: var(--hud-face); height: var(--hud-face); align-items: center; justify-content: center; padding: 0 var(--fc-space-2); }
.fc-hud__tool-face > .fc-icon { width: var(--fc-icon-small); height: var(--fc-icon-small); }
.fc-hud__tool-text { margin-left: var(--fc-space-1); white-space: nowrap; }
.fc-root .fc-hud__tool.pressed .fc-hud__tool-face { translate: 0 var(--fc-press-shift); background-color: var(--fc-panel-selected); }
/* On: the text colour with a dark icon. Off: the field panel, a dim icon struck through. */
.fc-hud__toggle .fc-hud__tool-face > .fc-icon { --icon-color: var(--fc-text-dim); }
.fc-hud__toggle-slash { position: absolute; left: 50%; top: -4px; bottom: -4px; width: 2px; margin-left: -1px; rotate: 45deg; background-color: var(--fc-text); }
.fc-hud__toggle--on .fc-hud__tool-face { background-color: var(--fc-text); border-top-color: var(--fc-text); border-right-color: var(--fc-text); border-bottom-color: var(--fc-text); border-left-color: var(--fc-text); }
.fc-hud__toggle--on .fc-hud__tool-face > .fc-icon { --icon-color: var(--fc-ink); }
.fc-hud__toggle--on .fc-hud__toggle-slash { display: none; }
.fc-root .fc-hud__toggle--on.pressed .fc-hud__tool-face { background-color: var(--fc-text-2); }

/* the selection: one low strip just above the tray, on the right */
.fc-hud--compact .fc-hud__command { right: var(--fc-space-3); bottom: var(--hud-above-deck); width: auto; padding: 0 0 0 var(--fc-space-2); }
.fc-hud--compact .fc-hud__portrait { width: 72px; height: 52px; margin-right: var(--fc-space-2); }
.fc-hud--compact .fc-hud__count { position: absolute; right: 0; bottom: 0; padding: 0 var(--fc-space-1); background-color: var(--fc-bg); color: var(--fc-text); letter-spacing: 0; }
.fc-hud--compact .fc-hud__details-text { width: 156px; flex-grow: 0; }
.fc-hud--compact.fc-text-large .fc-hud__details-text { width: 176px; }
.fc-hud--compact .fc-hud__name { color: var(--fc-text); white-space: nowrap; }
.fc-hud--compact .fc-hud__orders { margin: 0 0 0 var(--fc-space-2); }
.fc-hud--compact .fc-hud__order {
    width: var(--fc-touch); flex-grow: 0; flex-basis: auto; margin: 0; background-color: var(--fc-clear);
    border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: var(--fc-line);
}
.fc-hud--compact .fc-hud__order-icon { width: var(--fc-icon-small); height: var(--fc-icon-small); }
.fc-hud__extras { margin-top: var(--fc-space-1); }

/* the tray: a third lower, the render, the CP and a short name on one line; the penalty as a chip */
.fc-hud--compact .fc-deck { height: var(--hud-deck); }
.fc-deck--compact .fc-cpbox { width: var(--hud-card); padding: var(--fc-space-1); justify-content: space-between; }
.fc-deck--compact .fc-cpbox__bank { margin: 0; }
.fc-deck--compact .fc-cpbox__income { white-space: nowrap; }
.fc-hud--compact.fc-text-large .fc-cpbox { width: 116px; }
.fc-deck--compact .fc-hcard { width: var(--hud-card); }
.fc-deck--compact .fc-hcard__art { height: var(--hud-card-art); }
.fc-deck--compact .fc-hcard__seconds { top: 20px; }
.fc-hcard__name--short {
    margin: var(--fc-space-1) 2px 0 2px;
    -unity-font: var(--fc-font-display-semi); font-size: var(--fc-fs-small); color: var(--fc-text);
    -unity-text-align: upper-center;
}
.fc-hcard--short .fc-hcard__name--short, .fc-hcard--locked .fc-hcard__name--short { opacity: 0.45; }
.fc-hcard__badges { position: absolute; left: var(--fc-space-1); top: var(--fc-space-1); flex-direction: row; }
.fc-hud .fc-deck__chip {
    position: absolute; left: 0; bottom: 100%; margin-bottom: var(--fc-space-1); padding: 0 var(--fc-space-2);
    white-space: nowrap; background-color: var(--fc-panel-field);
    border-top-width: var(--fc-line); border-right-width: var(--fc-line); border-bottom-width: var(--fc-line); border-left-width: var(--fc-line);
    border-top-color: var(--fc-border-strong); border-right-color: var(--fc-border-strong); border-bottom-color: var(--fc-border-strong); border-left-color: var(--fc-border-strong);
}
.fc-hud .fc-deck__chip.fc-danger-text { border-top-color: var(--fc-danger); border-right-color: var(--fc-danger); border-bottom-color: var(--fc-danger); border-left-color: var(--fc-danger); }
.fc-deck__tip { position: absolute; bottom: 100%; width: 240px; margin-bottom: var(--fc-space-2); padding: var(--fc-space-2) var(--fc-space-3); align-items: center; }
.fc-deck__tip > .fc-text { -unity-text-align: middle-center; }

/* the hint (first matches only) and the strike prompt above the tray on the left */
.fc-hud--compact .fc-hud__hint, .fc-hud--compact .fc-hud__targeting { left: var(--fc-space-3); right: 560px; bottom: var(--hud-above-chip); }
.fc-hud--compact .fc-hud__hint-face { padding: var(--fc-space-1) var(--fc-space-3); }

/* under the top strip: the boss, the fortress pieces, notices and radio, small */
.fc-hud--compact .fc-hud__under { top: 64px; left: var(--hud-edge); right: var(--hud-edge); }
.fc-boss--compact { width: 640px; margin-bottom: var(--fc-space-1); min-height: var(--fc-touch); }
.fc-boss--collapsed { width: 340px; padding: var(--fc-space-1) var(--fc-space-2); }
.fc-boss--collapsed .fc-boss__name, .fc-boss--collapsed .fc-boss__phase { font-size: var(--fc-fs-small); }
/* Closed, the bar says who and which phase; the health in numbers is in the open bar. */
.fc-boss--collapsed .fc-boss__hp { display: none; }
.fc-boss--collapsed .fc-boss__icon { width: var(--fc-icon-small); height: var(--fc-icon-small); }
.fc-boss--collapsed .fc-boss__track { height: 6px; }
.fc-boss-parts--mini { margin-top: var(--fc-space-1); }
.fc-boss-parts--mini .fc-boss-part { width: 36px; height: 30px; padding: 2px 4px; margin: 0 var(--fc-space-1) 0 0; }
.fc-boss-parts--mini .fc-boss-part__icon { width: 20px; height: 20px; }
.fc-boss-parts--mini .fc-boss-part__cross { top: 3px; bottom: 3px; }
.fc-root .fc-boss--compact.pressed { background-color: var(--fc-panel-selected); }
.fc-hud--compact .gun-timer { height: auto; min-height: 0; padding: var(--fc-space-1) var(--fc-space-3); }
.fc-hud--compact .fc-hud__toast { margin-top: var(--fc-space-1); }
.fc-hud--compact .fc-hud__toast-face { max-width: 600px; min-height: 0; padding: var(--fc-space-1) var(--fc-space-3); }
.fc-hud--compact .fc-hud__toast-icon { width: var(--fc-icon-small); height: var(--fc-icon-small); margin-right: var(--fc-space-2); }
.fc-hud--compact .fc-radio { width: auto; max-width: 520px; margin-top: var(--fc-space-1); padding: var(--fc-space-1) var(--fc-space-3) var(--fc-space-1) var(--fc-space-1); }
.fc-hud--compact .fc-radio__portrait { width: 48px; height: 48px; margin-right: var(--fc-space-2); }
.fc-hud--compact .fc-hud__banner { top: 64px; left: var(--hud-edge); right: var(--hud-edge); }
.fc-hud--compact .fc-hud__banner-face { padding: var(--fc-space-2) var(--fc-space-5); }

/* pause: the commander's switches under the buttons (both layouts) */
.fc-pause__commander { margin-top: var(--fc-space-4); padding-top: var(--fc-space-2); border-top-width: var(--fc-line); border-top-color: var(--fc-border); }
