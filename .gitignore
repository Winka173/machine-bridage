# Addressables build output (pulled in by Localization)
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# Signing secrets never enter the repository
*.keystore
*.jks
keystore.properties

# Test runner output
/TestResults/

# Python bytecode from the Blender tools
__pycache__/

# Fix pass 8 ModelScan: old GLBs staged during a scan (deleted afterwards)
/Assets/ScanOld/
/Assets/ScanOld.meta

# Data export (Tools/export): the pack in Docs/export/current/ is committed; the run's own tests (_qa/) are not
/Docs/export/current/_qa/
